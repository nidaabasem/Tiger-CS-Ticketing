<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, ImplicitUsings, TreatWarningsAsErrors inherited from Directory.Build.props -->

  <ItemGroup>
    <!-- For IHttpContextAccessor (CurrentUserContext) — a supported way to
         reach ASP.NET Core shared-framework types from a plain classlib. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- ADR-0015: Hangfire is the approved background-job mechanism for SLA
         deadline checks and the safety sweep. Versions are pinned centrally
         in Directory.Packages.props, which already reserved them. -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.SqlServer" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <!-- Lifts Hangfire.SqlServer's vulnerable transitive Newtonsoft.Json
         11.0.1 onto the patched 13.0.4 - see Directory.Packages.props. -->
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TigerCS.Domain\TigerCS.Domain.csproj" />
    <ProjectReference Include="..\TigerCS.Application\TigerCS.Application.csproj" />
  </ItemGroup>

</Project>
