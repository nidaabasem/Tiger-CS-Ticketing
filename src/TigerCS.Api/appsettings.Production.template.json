{
  // ======================================================================================================
  // TEMPLATE ONLY - this file is NEVER loaded by the application.
  //
  // ASP.NET Core loads appsettings.{EnvironmentName}.json; the name "Production.template" is not an
  // environment, so nothing reads this file. It exists to show an operator which settings a Production
  // deployment has to decide on, and where each one comes from.
  //
  // To use it: copy to appsettings.Production.json (or, better, set the same keys as environment
  // variables with "__" as the separator, e.g. BackgroundJobs__Enabled=true), then review EVERY value.
  //
  // Every value below equals what the application resolves today from appsettings.json and the code
  // defaults. Copying the file unchanged therefore changes no behaviour. Items marked DECISION are the
  // ones whose Production value was NOT verified from the repository: check the real server first.
  //
  // NO SECRETS BELONG HERE. They come from the host's secret store / environment variables only:
  //   ConnectionStrings__TigerCsDatabase   ConnectionStrings__PACTRPT   ConnectionStrings__CrmDatabase
  //   Jwt__SigningKey (+ Jwt__Issuer, Jwt__Audience, Jwt__ExpirationMinutes)
  //   Crm__SecretKey   PactApi__ApiKey   EmailNotifications__Password   Sms__Broadnet__Password
  //   Collections__GenesysOutbound__ClientId / __ClientSecret   CrmDocuments__OtpCodePepper
  // Environment-specific endpoints and identities are also supplied per environment, not committed here:
  //   Crm__BaseUrl   PactApi__BaseUrl   Genesys__ScreenPopWebBaseUrl   EmailNotifications__Username
  //   Authorization__ServiceIdentity__EmployeeIds__0   Collections__Authorization__IntegrationEmployeeIds__0
  //   Collections__Campaigns__AdminNotification__Recipients__0
  // Not set anywhere in the repository (the code default applies unless the server sets it):
  //   Tasleeh__Provider (code default "Mock" serves a fixture customer - docs/system/12 says set "Unavailable")
  //   Genesys__ClassificationDepartmentCode, Genesys__AutoRaiseHandoffOnConversationEnd, CrmDocuments__AllowInProduction
  // ======================================================================================================

  // DECISION. The committed default is false, so with no server override NO background job runs: SLA sweep,
  // chatbot-inactivity closure, Outbox/e-mail dispatch, the receivables snapshot refresh, the CRM owner feed,
  // Collections reminders and the review/dispatch workers. docs/system/17 expects BackgroundJobs__Enabled=true.
  "BackgroundJobs": {
    "Enabled": false
  },

  // Only have an effect while BackgroundJobs:Enabled is true.
  // DECISION: RefreshOnStartup=true makes EVERY application start trigger one PACT pull per company
  // (Dubai 4, Sharjah 32) immediately; a restart during a long Dubai refresh abandons it.
  "Collections": {
    "Enabled": true,
    "TimeZoneId": "Asia/Dubai",
    "SchedulerOwner": "None",
    "BusinessRulesConfirmed": false,
    "Channels": {
      "VoiceBotEnabled": false,
      "SmsEnabled": false,
      "EmailEnabled": false
    },
    "ReceivablesSnapshot": {
      "RefreshEnabled": true,
      "RefreshCron": "0 */2 * * *",
      "RefreshTimeZoneId": "Asia/Dubai",
      "RefreshOnStartup": true
    },
    "Campaigns": {
      "FinancialSourceValidated": false,
      "LegalNoticeExportEnabled": false,
      "LegalCaseDispatchApproved": false
    },
    "GenesysOutbound": {
      "Enabled": false,
      "LiveCustomerDispatchEnabled": false,
      "SuppressionEnabled": false
    }
  },

  // DECISION for CrmOwners: with Enabled=true and BackgroundJobs:Enabled=true the feed loads at every start
  // and hourly (the cron is evaluated in the SERVER's local time zone, unlike the receivables refresh).
  "CollectionsSource": {
    "Provider": "Unavailable",
    "EdsmProvider": "Pact",
    "CrmOwners": {
      "Enabled": true,
      "RefreshCron": "15 * * * *",
      "RefreshOnStartup": true
    }
  },

  "Genesys": {
    "Enabled": true
  },

  // Provider switches. "Mock" (Crm) and "Fake" (Sms) are refused outside Development/Testing by startup guards.
  "Crm": {
    "Provider": "Http"
  },
  "Pact": {
    "Provider": "Http"
  },
  "Sms": {
    "Provider": "Disabled"
  },

  // Customer-facing delivery safety. IsTestMode "true" redirects every customer e-mail/SMS to TestEmail/TestPhone.
  // DECISION (go-live): leaving test mode is a business sign-off, not a deployment default.
  "CustomerNotifications": {
    "IsTestMode": "true"
  },
  "EmailNotifications": {
    "Enabled": false,
    "Provider": "Smtp"
  },
  "CrmDocuments": {
    "Enabled": false
  },
  "VerificationTesting": {
    "Enabled": false,
    "BlockRealCustomerDelivery": true
  }
}
