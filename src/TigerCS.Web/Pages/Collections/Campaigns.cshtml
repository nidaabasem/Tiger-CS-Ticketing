@page "/Collections/Campaigns"
@model TigerCS.Web.Pages.Collections.CampaignsModel
@using TigerCS.Web.Pages.Collections
@using TigerCS.Web.Services.Api
@{
    ViewData["Title"] = "Collections Campaigns";
    ViewData["ActiveNav"] = "collections";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/collections-campaigns.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/collections-snapshot.css" asp-append-version="true" />
<div class="page receivables-workspace">
    <div class="page-header">
        <div>
            <p class="receivables-eyebrow">Collections</p>
            <h1 class="page-title">Collections Campaigns</h1>
            <p class="page-subtitle">Review payment reminders per apartment and prepare a contact list for Genesys. Only instalments with an unpaid balance are ever considered; fully paid instalments are never reminder candidates.</p>
        </div>
        <div class="page-header__actions"><a class="btn btn-primary" href="/Collections/Review">Review &amp; approve</a> <a class="btn" href="/Collections/Receivables">Due &amp; Overdue Customers</a></div>
    </div>
    <form class="filter-bar" method="get" action="/Collections/Campaigns" data-receivables-filter data-results-form>
        <div class="field-group">
            <label class="field-label" for="campaignStage">Stage</label>
            <select class="field-select" id="campaignStage" name="stage" data-campaign-stage>
                <option value="OverdueReminder" selected="@(Model.Stage.Equals("OverdueReminder", StringComparison.OrdinalIgnoreCase))">Overdue reminder · sent day 1 (overdue more than one month)</option>
                <option value="CurrentMonthReminder" selected="@(Model.Stage.Equals("CurrentMonthReminder", StringComparison.OrdinalIgnoreCase))">Current month reminder · day 14</option>
                <option value="FollowUpReminder" selected="@(Model.Stage.Equals("FollowUpReminder", StringComparison.OrdinalIgnoreCase))">Follow-up reminder · day 28</option>
                <option value="LegalNotice" selected="@(Model.Stage.Equals("LegalNotice", StringComparison.OrdinalIgnoreCase))">Legal notice · days 12 and 14</option>
                <option value="LegalReferral" selected="@(Model.Stage.Equals("LegalReferral", StringComparison.OrdinalIgnoreCase))">Internal Legal referral · day 30</option>
            </select>
        </div>
        <div class="field-group">
            <label class="field-label" for="campaignDate">Preview date</label>
            <input class="field-input" id="campaignDate" name="businessDate" type="date" data-campaign-date min="2000-01-01" max="2100-12-31" value="@Model.BusinessDate?.ToString("yyyy-MM-dd")" />
        </div>
        <partial name="_TowerPicker" model="@(new TowerPickerModel("campaignTower", Model.Towers, Model.TowerId, Model.TowersFailed))" />
        <div class="field-group">
            <label class="field-label" for="campaignMonth">Month</label>
            <select class="field-select" id="campaignMonth" name="month" data-month-select>
                <option value="">Custom range</option>
                @for (var m = 1; m <= 12; m++) { <option value="@m" selected="@(Model.Month == m)">@CampaignsModel.MonthNames[m - 1]</option> }
            </select>
        </div>
        <div class="field-group">
            <label class="field-label" for="campaignYear">Year</label>
            <select class="field-select" id="campaignYear" name="year" data-year-select>
                <option value="">—</option>
                @foreach (var y in Model.YearOptions()) { <option value="@y" selected="@(Model.Year == y)">@y</option> }
            </select>
        </div>
        <div class="field-group">
            <label class="field-label" for="campaignFrom">From date (instalment due)</label>
            <input class="field-input" id="campaignFrom" name="dateFrom" type="date" min="2000-01-01" max="2100-12-31" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" data-date-from data-campaign-from data-default="@Model.DefaultFrom.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field-group">
            <label class="field-label" for="campaignTo">To date (instalment due)</label>
            <input class="field-input" id="campaignTo" name="dateTo" type="date" min="2000-01-01" max="2100-12-31" value="@Model.DateTo?.ToString("yyyy-MM-dd")" data-date-to data-campaign-to data-default="@Model.DefaultTo.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field-group receivables-shortcuts">
            <span class="field-label">Quick range</span>
            <a class="btn btn-sm" href="@Model.LastSixMonthsUrl()" data-last-six-months>Last 6 months</a>
        </div>
        <div class="field-group">
            <label class="field-label" for="campaignMin">Minimum outstanding amount (AED)</label>
            <input class="field-input" type="number" id="campaignMin" name="minAmount" min="0" step="any" inputmode="decimal" value="@Model.MinAmountText" data-min-amount aria-describedby="campaignMinHelp" />
            <span class="receivables-meta" id="campaignMinHelp">An instalment counts only if its remaining unpaid amount is at least this value (&ge;).</span>
        </div>
        <div class="field-group filter-bar__search">
            <label class="field-label" for="campaignSearch">Customer or unit</label>
            <input class="field-input" type="search" id="campaignSearch" name="search" maxlength="200" value="@Model.Search" placeholder="Name, phone, customer ID or unit" />
        </div>
        <button class="btn btn-primary" type="submit">Preview list</button>
        <span class="receivables-loading" role="status" hidden>Loading campaign list…</span>
        <span class="receivables-timeout" role="alert" hidden>The list is taking too long. The request was stopped; retry or choose one tower.</span>
    </form>
    <div class="receivables-results" data-results data-results-url="/Collections/Campaigns" aria-live="polite">
        @if (Model.RenderFull) { <partial name="_CampaignResults" model="Model" /> }
        else
        {
            <div class="receivables-results__loading" role="status" data-results-loading>Loading campaign list…</div>
            <noscript><p class="receivables-notice">JavaScript loads the results here. <a href="@Model.PageUrl(1)">Open the full page without JavaScript</a>.</p></noscript>
        }
    </div>
</div>
<script src="~/js/receivables.js" asp-append-version="true"></script>
<script src="~/js/collections-towers.js" asp-append-version="true"></script>
<script src="~/js/collections-campaign-dates.js" asp-append-version="true"></script>
