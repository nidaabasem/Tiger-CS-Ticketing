@page "/Collections/Receivables"
@model TigerCS.Web.Pages.Collections.ReceivablesModel
@using TigerCS.Web.Pages.Collections
@{
    ViewData["Title"] = "Due & Overdue Customers";
    ViewData["ActiveNav"] = "collections";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/collections-snapshot.css" asp-append-version="true" />
<div class="page receivables-workspace">
    <div class="page-header">
        <div>
            <p class="receivables-eyebrow">Collections</p>
            <h1 class="page-title">Due &amp; Overdue Customers</h1>
            <p class="page-subtitle">PACT instalments by tower, month or date range and payment status, from a local copy that is refreshed in the background.</p>
        </div>
        <div class="page-header__actions"><a class="btn" href="/Collections/Campaigns">Campaigns</a></div>
    </div>

    <form class="filter-bar" method="get" action="/Collections/Receivables" data-receivables-filter data-results-form>
        <div class="field-group view-toggle" role="radiogroup" aria-label="View">
            <span class="field-label">View</span>
            <div class="view-toggle__options">
                <label><input type="radio" name="view" value="units" checked="@Model.ByUnit" data-view-radio /> By unit</label>
                <label><input type="radio" name="view" value="instalments" checked="@(!Model.ByUnit)" data-view-radio /> By instalment</label>
            </div>
        </div>
        <div class="field-group filter-bar__search">
            <label class="field-label" for="receivableSearch">Customer, unit or voucher</label>
            <input class="field-input" type="search" id="receivableSearch" name="search" maxlength="200" value="@Model.Search" placeholder="Name, phone, customer ID, unit or voucher…" />
        </div>
        <partial name="_TowerPicker" model="@(new TowerPickerModel("receivableTower", Model.Towers, Model.TowerId, Model.TowersFailed))" />
        <div class="field-group">
            <label class="field-label" for="receivableMonth">Month</label>
            <select class="field-select" id="receivableMonth" name="month" data-month-select>
                <option value="">Custom range</option>
                @for (var m = 1; m <= 12; m++) { <option value="@m" selected="@(Model.Month == m)">@ReceivablesModel.MonthNames[m - 1]</option> }
            </select>
        </div>
        <div class="field-group">
            <label class="field-label" for="receivableYear">Year</label>
            <select class="field-select" id="receivableYear" name="year" data-year-select>
                <option value="">—</option>
                @foreach (var y in Model.YearOptions()) { <option value="@y" selected="@(Model.Year == y)">@y</option> }
            </select>
        </div>
        <div class="field-group">
            <label class="field-label" for="receivableFrom">From (instalment due)</label>
            <input class="field-input" type="date" id="receivableFrom" name="dateFrom" min="2000-01-01" max="2100-12-31" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" data-date-from />
        </div>
        <div class="field-group">
            <label class="field-label" for="receivableTo">To (instalment due, inclusive)</label>
            <input class="field-input" type="date" id="receivableTo" name="dateTo" min="2000-01-01" max="2100-12-31" value="@Model.DateTo?.ToString("yyyy-MM-dd")" data-date-to />
        </div>
        <div class="field-group receivables-shortcuts">
            <span class="field-label">Quick range</span>
            <a class="btn btn-sm" href="@Model.LastSixMonthsUrl()" data-last-six-months>Last 6 months</a>
        </div>
        <div class="field-group">
            <label class="field-label" for="receivableStatus">Payment status</label>
            <select class="field-select" id="receivableStatus" name="paymentStatus" data-payment-status>
                @foreach (var (value, label) in ReceivablesModel.PaymentOptions)
                {
                    <option value="@value" selected="@(Model.PaymentStatus == value)" data-needs="@(value is "unpaid" or "partial" ? "breakdown" : value is "paid" or "all" ? "paid" : "")">@label</option>
                }
            </select>
        </div>
        <div class="field-group">
            <label class="field-label" for="receivableMin">Minimum outstanding amount (AED)</label>
            <input class="field-input" type="number" id="receivableMin" name="minAmount" min="0" step="any" inputmode="decimal" value="@Model.MinAmountText" disabled="@(!Model.MinApplies)" data-min-amount aria-describedby="receivableMinHelp" />
            <span class="receivables-meta" id="receivableMinHelp" data-min-help>
                @if (Model.MinApplies) { <text>Shows instalments whose remaining unpaid amount is at least this value (&ge;).</text> }
                else { <text>Not applied to Fully paid and All, so paid instalments are never hidden.</text> }
            </span>
        </div>
        <div class="filter-bar__submit">
            <button class="btn btn-gold" type="submit">Apply</button>
            <a class="btn btn-ghost" href="/Collections/Receivables">Clear</a>
        </div>
        <span class="receivables-loading" role="status" hidden>Loading…</span>
    </form>

    <div class="receivables-results" data-results data-results-url="/Collections/Receivables" aria-live="polite">
        @if (Model.RenderFull) { <partial name="_InstalmentResults" model="Model" /> }
        else
        {
            <div class="receivables-results__loading" role="status" data-results-loading>Loading…</div>
            <noscript><p class="receivables-notice">JavaScript loads the results here. <a href="@Model.PageUrl(1)">Open the full page without JavaScript</a>.</p></noscript>
        }
    </div>
</div>
<script src="~/js/receivables.js" asp-append-version="true"></script>
<script src="~/js/collections-towers.js" asp-append-version="true"></script>
