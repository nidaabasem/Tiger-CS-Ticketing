@page "/Collections/Receivables"
@model TigerCS.Web.Pages.Collections.ReceivablesModel
@using TigerCS.Web.Pages.Collections
@{
    ViewData["Title"] = "Due & Overdue Customers";
    ViewData["ActiveNav"] = "collections";
    Layout = "_Layout";
}
<div class="page receivables-workspace">
    <div class="page-header">
        <div>
            <p class="receivables-eyebrow">Collections</p>
            <h1 class="page-title">Due &amp; Overdue Customers</h1>
            <p class="page-subtitle">PACT customers with unpaid instalments due today or earlier, including customers with no tickets.</p>
        </div>
        <div class="page-header__actions"><a class="btn" href="@Model.PageUrl(Model.PageNumber)">Refresh</a></div>
    </div>

    <form class="filter-bar" method="get" action="/Collections/Receivables" data-receivables-filter>
        <div class="field-group filter-bar__search">
            <label class="field-label" for="receivableSearch">Customer or unit</label>
            <input class="field-input" type="search" id="receivableSearch" name="search" maxlength="200" value="@Model.Search" placeholder="Name, phone, customer ID or unit…" />
        </div>
        <div class="field-group">
            <label class="field-label" for="receivableCompany">Company</label>
            <select class="field-select" id="receivableCompany" name="companyId">
                <option value="">All companies</option>
                <option value="4" selected="@(Model.CompanyId == 4)">Tiger Group Dubai</option>
                <option value="32" selected="@(Model.CompanyId == 32)">Tiger Group Sharjah</option>
            </select>
        </div>
        <div class="field-group">
            <label class="field-label" for="receivableStatus">Status</label>
            <select class="field-select" id="receivableStatus" name="status">
                <option value="all" selected="@(Model.Status is null or "all")">Due &amp; Overdue</option>
                <option value="due" selected="@(Model.Status == "due")">Due this month</option>
                <option value="overdue" selected="@(Model.Status == "overdue")">Overdue</option>
            </select>
        </div>
        <div class="field-group">
            <label class="field-label" for="receivableMonth">Reporting month</label>
            <input class="field-input" type="month" id="receivableMonth" data-month-input value="@(Model.Report is { } r0 ? $"{r0.ReportYear:0000}-{r0.ReportMonth:00}" : "")" />
            <input type="hidden" name="year" value="@Model.Year" data-year-field />
            <input type="hidden" name="month" value="@Model.Month" data-month-field />
        </div>
        <div class="filter-bar__submit">
            <button class="btn btn-gold" type="submit">Apply</button>
            <a class="btn btn-ghost" href="/Collections/Receivables">Clear</a>
        </div>
        <span class="receivables-loading" role="status" hidden>Loading customers…</span>
    </form>

    @if (Model.Report is { } report)
    {
        <div class="receivables-metrics">
            <div class="panel"><span>Apartments in this list</span><strong>@report.TotalCount</strong></div>
            <div class="panel"><span>Due this month</span><strong>@report.DueCustomerCount</strong></div>
            <div class="panel"><span>Overdue</span><strong>@report.OverdueCustomerCount</strong></div>
        </div>
        <p class="text-secondary">Reporting month @report.PeriodStart.ToString("MMM yyyy") (Due = due @report.PeriodStart.ToString("dd MMM")–@report.PeriodEnd.ToString("dd MMM yyyy"); Overdue = due before @report.PeriodStart.ToString("dd MMM yyyy")) · as of @report.BusinessDate.ToString("dd MMM yyyy") · Dubai time · @report.Currency (configured currency). Each row is one apartment.</p>
        @if (report.PeriodEnd < report.BusinessDate || report.PeriodStart > report.BusinessDate)
        {
            <div class="receivables-notice" role="status">Amounts are the current remaining balances of instalments whose due dates fall in the selected period. They are not a historical balance as of that month.</div>
        }
        @if (!report.LegacyExclusionsApplied)
        {
            <div class="receivables-notice" role="status">Every apartment with a positive due or overdue amount is listed. The legacy booking, down-payment and special-case exclusions are not applied.</div>
        }
        <div class="panel">
            @if (report.Items.Count == 0)
            {
                <div class="empty-state"><p class="empty-state__title">No customers in this page match the selected filters.</p><a class="btn" href="/Collections/Receivables">Clear filters</a></div>
            }
            else
            {
                <div class="receivables-table-wrap">
                    <table class="receivables-table">
                        <thead><tr><th>Customer</th><th>Company / apartment</th><th>Due (month)</th><th>Overdue (before month)</th><th>Total</th><th>Earliest due date</th><th>Instalments</th></tr></thead>
                        <tbody>
                        @foreach (var customer in report.Items)
                        {
                            <tr>
                                <td><strong>@customer.FullName</strong><span class="receivables-meta">Customer ID @customer.TenantId</span><span class="receivables-meta">@customer.Mobile</span><span class="receivables-meta">@customer.Email</span></td>
                                <td>@customer.CompanyName<span class="receivables-meta">@(customer.UnitCode.Length > 0 ? customer.UnitCode : "No unit code")</span></td>
                                <td><span class="receivables-amount">@ReceivablesModel.Money(customer.DueAmount)</span>@if (customer.HasDue) { <span class="receivables-tag">Due this month</span> }</td>
                                <td><span class="receivables-amount">@ReceivablesModel.Money(customer.OverdueAmount)</span>@if (customer.HasOverdue) { <span class="receivables-tag receivables-tag--overdue">@customer.OverdueDays days overdue</span> }</td>
                                <td><span class="receivables-amount">@ReceivablesModel.Money(customer.TotalAmount)</span></td>
                                <td>@customer.EarliestDueDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <details class="receivables-details">
                                        <summary>View @customer.Instalments.Count</summary>
                                        @if (customer.AmountStatus == "NeedsReview")
                                        {
                                            <p class="receivables-notice">Several source rows share a due date. The total needs review; each source row is shown below.</p>
                                        }
                                        <ul>
                                        @foreach (var instalment in customer.Instalments)
                                        {
                                            <li><strong>@instalment.UnitCode</strong> · Due @instalment.DueDate.ToString("dd MMM yyyy") · Remaining @ReceivablesModel.Money(instalment.RemainingAmount) @report.Currency
                                                <span class="receivables-tag">@instalment.ReceivablesType</span>
                                                <span class="receivables-tag">@ReceivablesModel.PaymentLabel(instalment.PaymentStatus)</span>
                                                <span class="receivables-tag @(instalment.DueTiming == "Overdue" ? "receivables-tag--overdue" : "")">@ReceivablesModel.TimingLabel(instalment.DueTiming)</span>
                                                <span class="receivables-meta">Voucher @instalment.VoucherNumber · Source status: @(instalment.SourceStatus.Length > 0 ? instalment.SourceStatus : "(none)")</span></li>
                                        }
                                        </ul>
                                    </details>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            <div class="receivables-pagination">
                <span>Page @report.Page of @Model.TotalPages</span>
                <div>
                    @if (report.Page > 1) { <a class="btn btn-sm" href="@Model.PageUrl(report.Page - 1)">Previous</a> }
                    @if (report.Page < Model.TotalPages) { <a class="btn btn-sm" href="@Model.PageUrl(report.Page + 1)">Next</a> }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="panel"><div class="error-state" role="alert">
        @if (Model.Outcome == ApiOutcome.Forbidden)
        {
            <p>Your account does not have permission to view Collections financial data.</p>
        }
        else if (Model.Outcome == ApiOutcome.Unauthorized)
        {
            <p>Your session has expired. <a href="/Logout">Sign in again</a>.</p>
        }
        else if (Model.Outcome == ApiOutcome.ValidationError)
        {
            <p>The selected filters are invalid. Choose a company and status from the list and retry.</p>
        }
        else
        {
            <p>The receivables source is unavailable. The customer list could not be loaded.</p>
            <a class="btn" href="@Model.PageUrl(Model.PageNumber)">Retry</a>
        }
        </div></div>
    }
</div>
<script src="~/js/receivables.js" asp-append-version="true"></script>
