@page "/Collections/Receivables"
@model TigerCS.Web.Pages.Collections.ReceivablesModel
@using TigerCS.Web.Pages.Collections
@{
    ViewData["Title"] = "Receivables";
    ViewData["ActiveNav"] = "collections";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/collections-snapshot.css" asp-append-version="true" />
<div class="page receivables-workspace">
    <div class="page-header">
        <div>
            <p class="receivables-eyebrow">Collections</p>
            <h1 class="page-title">Receivables</h1>
        </div>
        <div class="page-header__actions"><a class="btn" href="/Collections/Campaigns">Campaigns</a></div>
    </div>

    <form class="filter-bar" method="get" action="/Collections/Receivables" data-receivables-filter data-results-form>
        <div class="field-group filter-bar__search">
            <label class="field-label" for="receivableSearch">Search</label>
            <input class="field-input" type="search" id="receivableSearch" name="search" maxlength="200" value="@Model.Search" placeholder="Customer name, mobile, tower or apartment" />
        </div>
        <partial name="_TowerPicker" model="@(new TowerPickerModel("receivableTower", Model.Towers, Model.TowerId, Model.TowersFailed))" />
        <div class="field-group">
            <label class="field-label" for="receivableStatus">Status</label>
            <select class="field-select" id="receivableStatus" name="status">
                @foreach (var (value, label) in ReceivablesModel.StatusOptions)
                {
                    <option value="@value" selected="@(Model.Status == value)">@label</option>
                }
            </select>
        </div>
        <div class="filter-bar__submit">
            <button class="btn btn-gold" type="submit">Apply</button>
            <a class="btn btn-ghost" href="/Collections/Receivables">Clear</a>
        </div>
        <span class="receivables-loading" role="status" hidden>Loading…</span>
    </form>

    <div class="receivables-results" data-results data-results-url="/Collections/Receivables" aria-live="polite">
        @if (Model.RenderFull) { <partial name="_InstalmentResults" model="Model" /> }
        else
        {
            <div class="receivables-results__loading" role="status" data-results-loading>Loading…</div>
            <noscript><p class="receivables-notice">JavaScript loads the results here. <a href="@Model.PageUrl(1)">Open the full page without JavaScript</a>.</p></noscript>
        }
    </div>
</div>
<script src="~/js/receivables.js" asp-append-version="true"></script>
<script src="~/js/collections-towers.js" asp-append-version="true"></script>
