@page "/Tickets/{id:long}"
@model TigerCS.Web.Pages.TicketDetailsModel
@{
    ViewData["ActiveNav"] = "queue";
    Layout = "_Layout";
}

@if (Model.Ticket is null)
{
    ViewData["Title"] = "Ticket unavailable";
    <div class="page">
        <div class="error-state">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
            <p>
                @(Model.Outcome switch
                {
                    ApiOutcome.Forbidden => "You don't have permission to view this ticket.",
                    ApiOutcome.Unauthorized => "Your session is no longer valid. Sign in again.",
                    ApiOutcome.Unreachable or ApiOutcome.BadGateway => "Tiger Ticketing System could not reach the ticketing service.",
                    _ => "This ticket could not be loaded."
                })
            </p>
            <a class="btn btn-sm" href="/Tickets">Back to Ticket Queue</a>
        </div>
    </div>
}
else
{
    var t = Model.Ticket;
    ViewData["Title"] = t.TicketNumber;
    var isClosed = t.TicketStatus == "Closed";
    var isResolved = t.TicketStatus == "Resolved";
    (string Label, string CssKey)? slaBadge = Model.Sla is not null ? TicketDisplay.SlaBadgeText(Model.Sla, DateTime.UtcNow) : null;

    // Display priority for the "Verification & Unit" panel (task: CRM Buyer snapshot >
    // external-lookup verification (PACT/Tasleeh) > manual Project/Unit Number > legacy
    // Unit/Contact reference) — a ticket carries at most one of these per the domain's
    // own mutual-exclusion invariants. An external-lookup ticket IS verified — against
    // its source — even though its VerificationStatus stays the CRM-scoped Unverified;
    // only a ticket with NEITHER a CRM Buyer match NOR an external source is a plain
    // manual entry ("Manual entry / Not externally verified").
    var hasCrmBuyer = t.CrmBuyerUnitId is not null;
    var hasExternalVerification = !hasCrmBuyer && !string.IsNullOrWhiteSpace(t.CustomerVerificationSource);
    var hasManualUnit = !hasCrmBuyer && !hasExternalVerification
        && (!string.IsNullOrWhiteSpace(t.ManualProjectName) || !string.IsNullOrWhiteSpace(t.ManualUnitNumber));
    var hasLegacyReference = !hasCrmBuyer && !hasExternalVerification && !hasManualUnit
        && (t.UnitReferenceId is not null || t.ContactReferenceId is not null);

    <div class="page">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/Tickets">Tickets</a>
            <span class="sep">/</span>
            <span class="current">@t.TicketNumber</span>
        </nav>

        @if (!string.IsNullOrEmpty(Model.ActionSuccess))
        {
            <div class="alert alert-success" role="status">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>@Model.ActionSuccess</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ActionError))
        {
            <div class="alert alert-error" role="alert">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                <span>@Model.ActionError</span>
            </div>
        }

        <section class="ticket-header">
            <div class="ticket-header__top">
                <div>
                    <div class="ticket-header__id">@t.TicketNumber</div>
                    <h1 class="ticket-header__title">@t.RequestSummary</h1>
                    <div class="ticket-header__meta">
                        <span><strong>Assigned Department:</strong> @TicketDisplay.AssignedDepartmentLabel(t.CurrentDepartmentId, Model.DepartmentName)</span>
                        <span><strong>Assigned To:</strong> @TicketDisplay.AssignedToLabel(t.CurrentOwnerEmployeeId, Model.OwnerName, t.CurrentDepartmentId, Model.DepartmentName)</span>
                        <span><strong>Category:</strong> #@t.CategoryId</span>
                    </div>
                    <div class="ticket-header__badges">
                        <span class="badge badge-status-@TicketDisplay.TicketStatusCssKey(t.TicketStatus)"><span class="badge-dot"></span>@TicketDisplay.TicketStatusLabel(t.TicketStatus)</span>
                        <span class="badge badge-priority-@TicketDisplay.PriorityCssKey(t.PriorityId)">@TicketDisplay.PriorityLabel(t.PriorityId)</span>
                        <span class="badge badge-verification-@t.VerificationStatus.ToLowerInvariant()">@TicketDisplay.VerificationStatusLabel(t.VerificationStatus)</span>
                        @if (slaBadge is not null)
                        {
                            <span class="badge badge-sla-@slaBadge.Value.CssKey">SLA: @slaBadge.Value.Label</span>
                        }
                    </div>
                </div>

                <div class="ticket-header__actions">
                    @if (!isClosed)
                    {
                        <details class="disclosure" open="@(Model.OpenSection == "assign" ? "open" : null)">
                            <summary class="btn btn-sm">Assign</summary>
                            <div class="disclosure__panel">
                                <form method="post" asp-page-handler="Assign" class="action-form">
                                    <input type="hidden" asp-for="Assign.RowVersionBase64" />
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Assign.AssignedEmployeeId">Assign to</label>
                                        <select class="field-select" asp-for="Assign.AssignedEmployeeId">
                                            @foreach (var member in Model.AssignableEmployees)
                                            {
                                                <option value="@member.EmployeeId">@member.DisplayName</option>
                                            }
                                        </select>
                                        @if (Model.AssignableEmployees.Count == 0)
                                        {
                                            <span class="field-hint">No active members found in this department.</span>
                                        }
                                    </div>
                                    <div class="action-form__footer"><button type="submit" class="btn btn-gold btn-sm">Assign</button></div>
                                </form>
                            </div>
                        </details>

                        @if (Model.CanTransfer)
                        {
                            <details class="disclosure" open="@(Model.OpenSection == "transfer" ? "open" : null)">
                                <summary class="btn btn-sm">Transfer</summary>
                                <div class="disclosure__panel">
                                    <form method="post" asp-page-handler="Transfer" class="action-form">
                                        <input type="hidden" asp-for="Transfer.RowVersionBase64" />
                                        <div class="field-group">
                                            <label class="field-label" asp-for="Transfer.TargetDepartmentId">Transfer to department</label>
                                            <select class="field-select" asp-for="Transfer.TargetDepartmentId">
                                                @foreach (var d in Model.TransferTargets)
                                                {
                                                    <option value="@d.DepartmentId">@d.Name</option>
                                                }
                                            </select>
                                            @if (Model.TransferTargetsUnavailable)
                                            {
                                                <span class="field-hint">The department list could not be loaded. Please try again.</span>
                                            }
                                            else if (Model.TransferTargets.Count == 0)
                                            {
                                                <span class="field-hint">No other active department is available to transfer to.</span>
                                            }
                                        </div>
                                        <div class="field-group">
                                            <label class="field-label" asp-for="Transfer.Reason">Reason</label>
                                            <textarea class="form-control" asp-for="Transfer.Reason" rows="2"></textarea>
                                        </div>
                                        <div class="action-form__footer"><button type="submit" class="btn btn-gold btn-sm" disabled="@(Model.TransferTargets.Count == 0 ? "disabled" : null)">Transfer</button></div>
                                    </form>
                                </div>
                            </details>
                        }

                        <details class="disclosure" open="@(Model.OpenSection == "status" ? "open" : null)">
                            <summary class="btn @(isResolved ? "btn-sm" : "btn-gold btn-sm")">Change Status</summary>
                            <div class="disclosure__panel">
                                <form method="post" asp-page-handler="ChangeStatus" class="action-form">
                                    <input type="hidden" asp-for="Status.RowVersionBase64" />
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Status.NewStatus">New status</label>
                                        <select class="field-select" asp-for="Status.NewStatus">
                                            @foreach (var s in new[] { "Open", "InProgress", "PendingCustomer", "PendingThirdParty" })
                                            {
                                                <option value="@s">@TicketDisplay.TicketStatusLabel(s)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Status.PendingReason">Pending reason</label>
                                        <textarea class="form-control" asp-for="Status.PendingReason" rows="2"></textarea>
                                        <span class="field-hint">Required when moving to Pending Customer or Pending Internal — e.g. "Missing documents", "Waiting for Accounting Approval".</span>
                                    </div>
                                    <div class="action-form__footer"><button type="submit" class="btn btn-gold btn-sm">Update status</button></div>
                                </form>
                            </div>
                        </details>

                        <details class="disclosure" open="@(Model.OpenSection == "resolve" ? "open" : null)">
                            <summary class="btn btn-sm">Resolve</summary>
                            <div class="disclosure__panel">
                                <form method="post" asp-page-handler="Resolve" class="action-form">
                                    <input type="hidden" asp-for="Resolve.RowVersionBase64" />
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Resolve.ResolutionOutcome">Outcome</label>
                                        <select class="field-select" asp-for="Resolve.ResolutionOutcome">
                                            @foreach (var o in new[] { "Resolved", "Cancelled", "Rejected", "Duplicate" })
                                            {
                                                <option value="@o">@o</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Resolve.DuplicateOfTicketId">Duplicate of ticket ID</label>
                                        <input class="form-control" asp-for="Resolve.DuplicateOfTicketId" />
                                        <span class="field-hint">Only used when outcome is Duplicate.</span>
                                    </div>
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Resolve.ResolutionNote">Resolution note</label>
                                        <textarea class="form-control" asp-for="Resolve.ResolutionNote" rows="3"></textarea>
                                    </div>
                                    <div class="action-form__footer"><button type="submit" class="btn btn-gold btn-sm">Resolve</button></div>
                                </form>
                            </div>
                        </details>

                        <details class="disclosure" open="@(Model.OpenSection == "escalate" ? "open" : null)">
                            <summary class="btn btn-sm">Escalate</summary>
                            <div class="disclosure__panel">
                                <form method="post" asp-page-handler="Escalate" class="action-form">
                                    <input type="hidden" asp-for="Escalate.RowVersionBase64" />
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Escalate.Level">Escalate to level</label>
                                        <select class="field-select" asp-for="Escalate.Level">
                                            @for (byte lvl = 1; lvl <= 4; lvl++)
                                            {
                                                <option value="@lvl">Level @lvl</option>
                                            }
                                        </select>
                                        <span class="field-hint">Current level: @TicketDisplay.EscalationLevelLabel(t.EscalationLevel). Levels only rise. Level 4 is restricted to CS Manager/GM.</span>
                                    </div>
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Escalate.Note">Note (optional)</label>
                                        <textarea class="form-control" asp-for="Escalate.Note" rows="2"></textarea>
                                    </div>
                                    <div class="action-form__footer"><button type="submit" class="btn btn-critical btn-sm">Escalate</button></div>
                                </form>
                            </div>
                        </details>
                    }

                    @if (isResolved)
                    {
                        <form method="post" asp-page-handler="Close">
                            <input type="hidden" asp-for="Close.RowVersionBase64" />
                            <button type="submit" class="btn btn-gold btn-sm">Close ticket</button>
                        </form>
                    }

                    @* Reopen (FR-RES-04): rendered only where the lifecycle
                       allows it — the server-computed IsReopenEligible flag
                       (Resolved/Closed, inside the reopen window) — and only
                       for CS-layer roles; the Api still enforces both. *@
                    @if (t.IsReopenEligible && TicketActions.CanReopen(Model.Viewer?.Roles))
                    {
                        <details class="disclosure" open="@(Model.OpenSection == "reopen" ? "open" : null)">
                            <summary class="btn @(isClosed ? "btn-gold btn-sm" : "btn-sm")">Reopen</summary>
                            <div class="disclosure__panel">
                                <form method="post" asp-page-handler="Reopen" class="action-form">
                                    <input type="hidden" asp-for="Reopen.RowVersionBase64" />
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Reopen.Reason">Reason</label>
                                        <textarea class="form-control" asp-for="Reopen.Reason" rows="2" required placeholder="Why is this ticket being reopened?"></textarea>
                                        <span class="field-hint">Returns the ticket to In Progress. The current resolution is kept as history.</span>
                                    </div>
                                    <div class="action-form__footer"><button type="submit" class="btn btn-gold btn-sm">Reopen ticket</button></div>
                                </form>
                            </div>
                        </details>
                    }
                </div>
            </div>

            @if (isClosed)
            {
                <div class="status-banner status-banner--closed">
                    <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="10" width="16" height="10" rx="1.6" stroke="currentColor" stroke-width="1.6" /><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.6" /></svg>
                    This ticket is closed and read-only. Resolution: @TicketDisplay.ResolutionOutcomeLabel(t.ResolutionOutcome).@(t.IsReopenEligible ? " It is still within the reopen window." : "")
                </div>
            }
            else if (slaBadge?.CssKey == "breached")
            {
                <div class="status-banner status-banner--critical">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                    SLA @slaBadge.Value.Label.ToLowerInvariant() — escalation level @TicketDisplay.EscalationLevelLabel(t.EscalationLevel).
                </div>
            }
            else if (t.VerificationStatus == "PendingCrmVerification")
            {
                <div class="status-banner status-banner--pending">
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" /><path d="M12 8v4l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                    Pending CRM verification — awaiting reconciliation.
                </div>
            }
        </section>

        <div class="tabs-card tabs-card--page">
            <input type="radio" name="pageTab" id="tab-details" class="tab-input" checked />
            <label class="tab-label" for="tab-details">Details</label>
            <input type="radio" name="pageTab" id="tab-history" class="tab-input" />
            <label class="tab-label" for="tab-history">Previous Tickets@(Model.CustomerHistory is not null ? $" ({Model.CustomerHistory.TotalTickets})" : "")</label>

            <div class="tabs-body">
                <div class="tab-panel" id="panel-details">
                    <div class="detail-layout">
            <div>
                <div class="tabs-card">
                    <input type="radio" name="ticketTab" id="tab-activity" class="tab-input" checked />
                    <label class="tab-label" for="tab-activity">Activity</label>
                    <input type="radio" name="ticketTab" id="tab-audit" class="tab-input" />
                    <label class="tab-label" for="tab-audit">Audit History</label>

                    <div class="tabs-body">
                        <div class="tab-panel" id="panel-activity">
                            @if (Model.ActivityFeed.Count == 0)
                            {
                                <div class="empty-state"><p>No activity recorded yet.</p></div>
                            }
                            else
                            {
                                <ol class="timeline">
                                    @foreach (var entry in Model.ActivityFeed)
                                    {
                                        var iconCss = entry.Kind switch { "escalation" => "icon-critical", "note" => "icon-gold", _ => "icon-quiet" };
                                        <li class="timeline-item">
                                            <span class="timeline-icon @iconCss"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" fill="currentColor" /></svg></span>
                                            <div class="timeline-row">
                                                <span class="timeline-text"><strong>@entry.Actor</strong> — @entry.Description</span>
                                                <span class="timeline-time">@entry.TimestampUtc.ToLocalTime().ToString("MMM d, HH:mm")</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(entry.Note))
                                            {
                                                <div class="timeline-note @(entry.IsHuman ? "timeline-note--human" : "timeline-note--system")">@entry.Note</div>
                                            }
                                        </li>
                                    }
                                </ol>
                            }

                            @if (!isClosed)
                            {
                                <div class="composer">
                                    <form method="post" asp-page-handler="AddNote">
                                        <label class="field-label" asp-for="Note.NoteText">Add a note</label>
                                        <textarea class="form-control" asp-for="Note.NoteText" rows="3" placeholder="Write a note…"></textarea>
                                        <div class="composer__footer">
                                            <button type="submit" class="btn btn-gold btn-sm">Save note</button>
                                        </div>
                                    </form>
                                </div>
                            }
                        </div>

                        <div class="tab-panel" id="panel-audit">
                            @if (Model.Escalations.Count == 0)
                            {
                                <div class="empty-state"><p>No escalations recorded.</p></div>
                            }
                            else
                            {
                                <div class="entry-list">
                                    @foreach (var e in Model.Escalations)
                                    {
                                        <div class="entry-row">
                                            <span class="entry-row__field">Escalated to @TicketDisplay.EscalationLevelLabel($"Level{e.Level}") (@e.TriggerType)</span>
                                            <span class="text-secondary">@e.RaisedAtUtc.ToLocalTime().ToString("MMM d, HH:mm")</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <aside class="facts-panel">
                <div class="facts-section">
                    <div class="facts-section__title">Ticket Information</div>
                    <dl>
                        <div class="facts-row"><dt>Ticket number</dt><dd>@t.TicketNumber</dd></div>
                        <div class="facts-row"><dt>Status</dt><dd>@TicketDisplay.TicketStatusLabel(t.TicketStatus)</dd></div>
                        <div class="facts-row"><dt>Priority</dt><dd>@TicketDisplay.PriorityLabel(t.PriorityId)</dd></div>
                        <div class="facts-row"><dt>Category</dt><dd class="id-fallback">#@t.CategoryId</dd></div>
                        <div class="facts-row"><dt>Assigned Department</dt><dd>@TicketDisplay.AssignedDepartmentLabel(t.CurrentDepartmentId, Model.DepartmentName)</dd></div>
                        <div class="facts-row"><dt>Assigned To</dt><dd>@TicketDisplay.AssignedToLabel(t.CurrentOwnerEmployeeId, Model.OwnerName, t.CurrentDepartmentId, Model.DepartmentName)</dd></div>
                        <div class="facts-row"><dt>Escalation level</dt><dd>@TicketDisplay.EscalationLevelLabel(t.EscalationLevel)</dd></div>
                        <div class="facts-row"><dt>Reopen count</dt><dd>@t.ReopenCount</dd></div>
                        @if (t.ResolutionOutcome is not null)
                        {
                            <div class="facts-row"><dt>Resolution</dt><dd>@TicketDisplay.ResolutionOutcomeLabel(t.ResolutionOutcome)</dd></div>
                        }
                    </dl>
                </div>

                <div class="facts-section">
                    <div class="facts-section__title">Verification &amp; Unit</div>
                    <dl>
                        <div class="facts-row">
                            <dt>Verification</dt>
                            <dd>@(hasExternalVerification
                                    ? $"Verified via {TicketDisplay.LookupSourceLabel(t.CustomerVerificationSource!)}"
                                    : hasManualUnit
                                        ? "Manual entry / Not externally verified"
                                        : TicketDisplay.VerificationStatusLabel(t.VerificationStatus))</dd>
                        </div>
                        @if (hasCrmBuyer)
                        {
                            <div class="facts-row"><dt>Customer</dt><dd>@(t.CrmBuyerCustomerName ?? "—")</dd></div>
                            <div class="facts-row"><dt>Project</dt><dd>@(t.CrmBuyerProjectName ?? "—")</dd></div>
                            <div class="facts-row"><dt>Unit Number</dt><dd>@(t.CrmBuyerUnitNumber ?? "—")</dd></div>
                            <div class="facts-row"><dt>CRM Unit ID</dt><dd class="id-fallback">#@t.CrmBuyerUnitId</dd></div>
                            <div class="facts-row"><dt>Lead ID</dt><dd class="id-fallback">@(t.CrmBuyerLeadId is int leadId ? $"#{leadId}" : "—")</dd></div>
                            <div class="facts-row"><dt></dt><dd><a class="btn btn-sm" href="/Tickets/@t.TicketId/Customer">View Customer Profile</a></dd></div>
                        }
                        else if (hasExternalVerification)
                        {
                            <div class="facts-row"><dt>Project</dt><dd>@(t.ManualProjectName ?? "—")</dd></div>
                            <div class="facts-row"><dt>Unit Number</dt><dd>@(t.ManualUnitNumber ?? "—")</dd></div>
                            <div class="facts-row"><dt>@TicketDisplay.LookupSourceLabel(t.CustomerVerificationSource!) Customer ID</dt><dd class="id-fallback">@(t.ExternalCustomerId ?? "—")</dd></div>
                            <div class="facts-row"><dt>@TicketDisplay.LookupSourceLabel(t.CustomerVerificationSource!) Unit ID</dt><dd class="id-fallback">@(t.ExternalUnitId ?? "—")</dd></div>
                        }
                        else if (hasManualUnit)
                        {
                            <div class="facts-row"><dt>Project</dt><dd>@(t.ManualProjectName ?? "—")</dd></div>
                            <div class="facts-row"><dt>Unit Number</dt><dd>@(t.ManualUnitNumber ?? "—")</dd></div>
                        }
                        else if (hasLegacyReference)
                        {
                            <div class="facts-row"><dt>Unit reference</dt><dd class="id-fallback">@(t.UnitReferenceId is int u ? $"#{u}" : "—")</dd></div>
                            <div class="facts-row"><dt>Contact reference</dt><dd class="id-fallback">@(t.ContactReferenceId is int c ? $"#{c}" : "—")</dd></div>
                        }
                    </dl>
                </div>

                <div class="facts-section">
                    <div class="facts-section__title">SLA Information</div>
                    @if (Model.Sla is null)
                    {
                        <p class="text-secondary">SLA data unavailable.</p>
                    }
                    else
                    {
                        <dl>
                            <div class="facts-row"><dt>First response due</dt><dd>@(Model.Sla.FirstResponseDueAtUtc?.ToLocalTime().ToString("MMM d, HH:mm") ?? "—")</dd></div>
                            <div class="facts-row"><dt>First response</dt><dd class="@(Model.Sla.FirstResponseBreached ? "is-critical" : "")">@(Model.Sla.FirstHumanResponseAtUtc?.ToLocalTime().ToString("MMM d, HH:mm") ?? (Model.Sla.FirstResponseBreached ? "Breached" : "Pending"))</dd></div>
                            <div class="facts-row"><dt>Resolution due</dt><dd>@(Model.Sla.ResolutionDueAtUtc?.ToLocalTime().ToString("MMM d, HH:mm") ?? "—")</dd></div>
                            <div class="facts-row"><dt>Resolution</dt><dd class="@(Model.Sla.ResolutionBreached ? "is-critical" : "")">@(Model.Sla.ResolutionBreached ? "Breached" : TicketDisplay.SlaStateLabel(Model.Sla.SlaState))</dd></div>
                        </dl>
                    }
                </div>

                @* Approvals / Dependencies (Workflow/Automation phase 3).
                   Rendered only when there is something to show; action
                   buttons appear only for callers the API says may act —
                   no disabled buttons for non-approvers. Approval state is
                   separate from Ticket Status by design. *@
                @{
                    var approvalsView = Model.Approvals;
                    static string ApprovalLabel(string type) => type switch
                    {
                        "AccountingApproval" => "Accounting Approval",
                        "CustomerServiceApproval" => "Customer Service Approval",
                        _ => type
                    };
                    var showApprovals = approvalsView is not null
                        && (approvalsView.Approvals.Count > 0
                            || approvalsView.RequestableApprovals.Count > 0
                            || approvalsView.MaintenanceState is not null
                            || approvalsView.PrerequisitesCompletedAtUtc is not null);
                }
                @if (showApprovals)
                {
                    <div class="facts-section">
                        <div class="facts-section__title">Approvals &amp; Dependencies</div>

                        @foreach (var approval in approvalsView!.Approvals.Where(a => a.IsCurrent))
                        {
                            <dl>
                                <div class="facts-row"><dt>@ApprovalLabel(approval.ApprovalType)</dt><dd>@approval.Status</dd></div>
                                <div class="facts-row"><dt>Requested</dt><dd>@approval.RequestedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd></div>
                                @if (approval.DecisionAtUtc is { } decidedAt)
                                {
                                    <div class="facts-row"><dt>Decided</dt><dd>@decidedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd></div>
                                }
                                @if (!string.IsNullOrEmpty(approval.DecisionComment))
                                {
                                    <div class="facts-row"><dt>Comment</dt><dd>@approval.DecisionComment</dd></div>
                                }
                                <div class="facts-row"><dt>Decided by</dt><dd>@approval.TargetSummary</dd></div>
                            </dl>
                            @if (approval.CallerCanDecide)
                            {
                                <form method="post" asp-page-handler="DecideApproval" class="action-form">
                                    <input type="hidden" name="ApprovalDecision.ApprovalId" value="@approval.TicketApprovalId" />
                                    <div class="field-group">
                                        <textarea class="form-control" name="ApprovalDecision.Comment" rows="2" placeholder="Comment — required to reject"></textarea>
                                    </div>
                                    <div class="action-form__footer">
                                        <button type="submit" class="btn btn-gold btn-sm" name="ApprovalDecision.Decision" value="Approve">Approve</button>
                                        <button type="submit" class="btn btn-critical btn-sm" name="ApprovalDecision.Decision" value="Reject">Reject</button>
                                    </div>
                                </form>
                            }
                        }

                        @foreach (var requestable in approvalsView.RequestableApprovals)
                        {
                            <dl>
                                <div class="facts-row"><dt>@ApprovalLabel(requestable.ApprovalType)</dt><dd>Not requested</dd></div>
                                <div class="facts-row"><dt>Decided by</dt><dd>@requestable.TargetSummary</dd></div>
                            </dl>
                            @if (requestable.CallerCanRequest)
                            {
                                <form method="post" asp-page-handler="RequestApproval" class="action-form">
                                    <input type="hidden" name="ApprovalRequest.ApprovalType" value="@requestable.ApprovalType" />
                                    <div class="field-group">
                                        <textarea class="form-control" name="ApprovalRequest.Comment" rows="2" placeholder="Request comment (optional)"></textarea>
                                    </div>
                                    <div class="action-form__footer">
                                        <button type="submit" class="btn btn-gold btn-sm">Request @ApprovalLabel(requestable.ApprovalType)</button>
                                    </div>
                                </form>
                            }
                        }

                        <dl>
                            @if (approvalsView.MaintenanceState is { } maintenanceState)
                            {
                                <div class="facts-row"><dt>Maintenance</dt><dd>@(maintenanceState switch
                                {
                                    "Required" => "Required — Pending",
                                    "NotRequired" => "Not Required",
                                    "Completed" => "Completed",
                                    _ => maintenanceState
                                })</dd></div>
                            }
                            @if (approvalsView.PrerequisitesCompletedAtUtc is { } prereqAt)
                            {
                                <div class="facts-row"><dt>Prerequisites</dt><dd>Completed @prereqAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd></div>
                            }
                        </dl>

                        @if (approvalsView.CallerCanRecordEvents)
                        {
                            <form method="post" asp-page-handler="RecordEvent" class="action-form">
                                <div class="field-group">
                                    <select class="field-select" name="WorkflowEvent.EventType">
                                        @if (approvalsView.PrerequisitesCompletedAtUtc is null)
                                        {
                                            <option value="PrerequisitesCompleted">Prerequisites completed</option>
                                        }
                                        @if (approvalsView.MaintenanceState is null)
                                        {
                                            <option value="MaintenanceRequired">Maintenance required</option>
                                            <option value="MaintenanceNotRequired">Maintenance not required</option>
                                        }
                                        else if (approvalsView.MaintenanceState == "Required")
                                        {
                                            <option value="MaintenanceCompleted">Maintenance completed</option>
                                            <option value="MaintenanceNotRequired">Maintenance not required</option>
                                        }
                                        else if (approvalsView.MaintenanceState == "NotRequired")
                                        {
                                            <option value="MaintenanceRequired">Maintenance required</option>
                                        }
                                    </select>
                                </div>
                                <div class="field-group">
                                    <input class="form-control" name="WorkflowEvent.Note" placeholder="Note (optional)" />
                                </div>
                                <div class="action-form__footer"><button type="submit" class="btn btn-sm">Record</button></div>
                            </form>
                        }
                    </div>
                }
            </aside>
                    </div>
                </div>

                <div class="tab-panel" id="panel-history">
                    @if (Model.CustomerHistory is null)
                    {
                        <div class="empty-state"><p>Customer history is unavailable right now.</p></div>
                    }
                    else
                    {
                        var history = Model.CustomerHistory;
                        @if (history.VerificationType == "Unverified")
                        {
                            <p class="badge badge-verification-unverified">Unverified Customer History</p>
                        }
                        <p class="text-secondary">
                            @if (!string.IsNullOrEmpty(history.CustomerDisplayName))
                            {
                                <span>Customer: <strong>@history.CustomerDisplayName</strong> · </span>
                            }
                            Total: @history.TotalTickets · Open: @history.OpenTickets · Closed: @history.ClosedTickets
                        </p>

                        @if (history.Tickets.Count == 0)
                        {
                            <div class="empty-state"><p>No previous tickets found for this customer.</p></div>
                        }
                        else
                        {
                            <div class="table-scroll">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Ticket</th>
                                            <th>Category</th>
                                            <th>Department</th>
                                            <th>Status</th>
                                            <th>Priority</th>
                                            <th>Created</th>
                                            <th>Closed</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in history.Tickets)
                                        {
                                            <tr>
                                                <td><a class="ticket-id-link" href="/Tickets/@row.TicketId">@row.TicketNumber</a></td>
                                                <td><span class="id-fallback">Category #@row.CategoryId</span></td>
                                                <td>@TicketDisplay.AssignedDepartmentLabel(row.CurrentDepartmentId, Model.NameResolver.TryGetDepartmentName(row.CurrentDepartmentId))</td>
                                                <td><span class="badge badge-status-@TicketDisplay.TicketStatusCssKey(row.TicketStatus)"><span class="badge-dot"></span>@TicketDisplay.TicketStatusLabel(row.TicketStatus)</span></td>
                                                <td><span class="badge badge-priority-@TicketDisplay.PriorityCssKey(row.PriorityId)">@TicketDisplay.PriorityLabel(row.PriorityId)</span></td>
                                                <td class="text-secondary text-mono">@row.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                                                <td class="text-secondary text-mono">—</td>
                                                <td><a class="btn btn-sm" href="/Tickets/@row.TicketId">Open</a></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}
