@page "/Login"
@model TigerCS.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_LoginLayout";
}

<div class="login-shell">
    <div class="login-corner" aria-hidden="true">
        <div class="band"></div>
        <div class="band2"></div>
        <div class="tag">Tiger Group</div>
    </div>

    <div class="login-stack">
        <div class="login-card">
            <div class="login-brand">
@*                 @await Html.PartialAsync("_BrandMark")

 *@   
 <div><img src="~/img/tiger-logo.png" width="120" /></div>
 <div class="login-brand__product">Ticketing System</div>
                <div class="login-brand__subtitle">Customer Service &amp; Operations Workspace</div>
            </div>

            @if (Model.SessionExpired)
            {
                <div class="alert alert-info" role="status">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" /><path d="M12 8v4l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                    <span>Your session expired. Please sign in again.</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-error" role="alert">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form method="post">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                <div class="form-group">
                    <label class="form-label" asp-for="Input.Identifier">Email or Employee ID</label>
                    <input asp-for="Input.Identifier" class="form-control" autocomplete="username" placeholder="e.g. n.basem or name@tigergroup.com" />
                    <span asp-validation-for="Input.Identifier" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.Password">Password</label>
                    <div class="password-field">
                        <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" placeholder="Enter your password" id="password" />
                        <button type="button" class="password-toggle" data-target="password" aria-pressed="false" aria-label="Show password"
                                data-icon-show='<svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot;><path d=&quot;M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;1.8&quot;/><circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;3&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;1.8&quot;/></svg>'
                                data-icon-hide='<svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot;><path d=&quot;M3 3l18 18&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;1.8&quot; stroke-linecap=&quot;round&quot;/><path d=&quot;M10.6 5.2A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a15.6 15.6 0 0 1-3.4 4.3M6.6 6.6C4 8.3 2 12 2 12s3.6 7 10 7c1.4 0 2.6-.3 3.7-.8M9.9 9.9a3 3 0 0 0 4.2 4.2&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;1.8&quot; stroke-linecap=&quot;round&quot;/></svg>'>
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" stroke="currentColor" stroke-width="1.8" /><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8" /></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label class="checkbox-field">
                        <input asp-for="Input.RememberMe" />
                        Remember me
                    </label>
                    <a class="link-muted" href="#">Forgot password?</a>
                </div>

                <button type="submit" class="btn btn-gold btn-block">Sign In</button>
            </form>

            <div class="login-secure-note">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1.6" /><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.6" /></svg>
                Secure internal access · Tiger Group employees only
            </div>
        </div>
        <div class="login-footer">Tiger Ticketing System</div>
    </div>
</div>
