@page "/Customers"
@model TigerCS.Web.Pages.CustomersModel
@{
    ViewData["Title"] = "Customers";
    ViewData["ActiveNav"] = "customers";
    Layout = "_Layout";
    var newTicketHref = Model.Searched
        ? $"/NewTicket?phoneNumber={Uri.EscapeDataString(Model.PhoneNumber!)}"
        : "/NewTicket";
}

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Customers</h1>
        </div>
        <a class="btn btn-gold" href="@newTicketHref">+ New Ticket</a>
    </div>

    <section class="workspace-search" aria-label="Customer search">
        <form action="/Customers" method="get" class="workspace-search__form" role="search">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            <input type="search" name="phoneNumber" class="workspace-search__input" value="@Model.PhoneNumber"
                   placeholder="Search customer by phone number…" aria-label="Search customer by phone number" required />
            <button type="submit" class="btn btn-gold">Search Customer</button>
        </form>
        <p class="workspace-search__hint">Phone number search runs across Tiger CRM, PACT and Tasleeh. Name and unit search are not offered by those systems yet.</p>
    </section>

    @if (!Model.Searched)
    {
        <div class="panel">
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                <p>Search for a customer to see their units, open tickets and previous tickets.</p>
            </div>
        </div>
    }
    else if (Model.SearchResult is null)
    {
        <div class="panel">
            <div class="error-state">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
                <p>
                    @(Model.SearchOutcome switch
                    {
                        ApiOutcome.Forbidden => "Your role does not have access to customer search.",
                        ApiOutcome.Unauthorized => "Your session is no longer valid. Sign in again.",
                        ApiOutcome.Unreachable or ApiOutcome.BadGateway => "Tiger Ticketing System could not reach the ticketing service.",
                        _ => "The customer search could not be completed right now."
                    })
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="source-status-line" role="status">
            <span><strong>Tiger CRM:</strong> @CustomersModel.SourceStatusLabel(Model.SearchResult.CrmStatus)</span>
            @foreach (var source in Model.SearchResult.ExternalSources)
            {
                <span><strong>@TicketDisplay.LookupSourceLabel(source.Source):</strong> @CustomersModel.SourceStatusLabel(source.Status)</span>
            }
        </div>

        @if (Model.Candidates.Count == 0)
        {
            <div class="panel">
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8" /><path d="M4 20c1.8-3.2 4.5-5 8-5s6.2 1.8 8 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                    <p>No verified customer was found for <strong>@Model.PhoneNumber</strong>.</p>
                    <p>You can still raise a ticket — the New Ticket flow supports manual customer entry.</p>
                    <a class="btn btn-gold btn-sm" href="@newTicketHref">+ New Ticket</a>
                </div>
            </div>
        }
        else if (Model.Selected is null)
        {
            <div class="candidate-list" aria-label="Matched customers">
                @foreach (var candidate in Model.Candidates)
                {
                    <div class="candidate-card">
                        <div>
                            <div class="candidate-card__name">@(candidate.DisplayName ?? "Unnamed customer")</div>
                            <div class="candidate-card__meta">
                                @(candidate.PhoneNumber ?? Model.PhoneNumber) · Verified via @TicketDisplay.LookupSourceLabel(candidate.Source)
                                @if (candidate.Units.Count > 0)
                                {
                                    <text> · @candidate.Units.Count unit@(candidate.Units.Count == 1 ? "" : "s")</text>
                                }
                            </div>
                        </div>
                        <a class="btn btn-sm"
                           href="/Customers?phoneNumber=@Uri.EscapeDataString(Model.PhoneNumber!)&customer=@Uri.EscapeDataString(candidate.Key)">Select</a>
                    </div>
                }
            </div>
        }
        else
        {
            var selected = Model.Selected;
            var selectedQuery = $"phoneNumber={Uri.EscapeDataString(Model.PhoneNumber!)}&customer={Uri.EscapeDataString(selected.Key)}";

            <section class="customer-summary" aria-label="Customer summary">
                <div>
                    <div class="customer-summary__name">@(selected.DisplayName ?? "Unnamed customer")</div>
                    <div class="customer-summary__meta">
                        <span><strong>Phone:</strong> @(selected.PhoneNumber ?? Model.PhoneNumber)</span>
                        <span><strong>Verified via:</strong> @TicketDisplay.LookupSourceLabel(selected.Source)</span>
                        @if (!string.IsNullOrWhiteSpace(selected.Email))
                        {
                            <span><strong>Email:</strong> @selected.Email</span>
                        }
                    </div>
                    <div class="customer-summary__counts">
                        <span><strong>@selected.Units.Count</strong> Units</span>
                        <span><strong>@(Model.History?.OpenTickets ?? 0)</strong> Open Tickets</span>
                        <span><strong>@(Model.History?.TotalTickets ?? 0)</strong> Previous Tickets</span>
                    </div>
                </div>
                <div class="customer-summary__actions">
                    @if (Model.Candidates.Count > 1)
                    {
                        <a class="btn btn-sm" href="/Customers?phoneNumber=@Uri.EscapeDataString(Model.PhoneNumber!)">Change customer</a>
                    }
                    <a class="btn btn-gold" href="@newTicketHref">+ New Ticket</a>
                </div>
            </section>

            <div class="tabs-card">
                <input type="radio" name="customerTab" id="tab-cust-tickets" class="tab-input" checked />
                <label class="tab-label" for="tab-cust-tickets">Tickets (@(Model.History?.TotalTickets ?? 0))</label>
                <input type="radio" name="customerTab" id="tab-cust-units" class="tab-input" />
                <label class="tab-label" for="tab-cust-units">Units / Contracts (@selected.Units.Count)</label>
                <input type="radio" name="customerTab" id="tab-cust-info" class="tab-input" />
                <label class="tab-label" for="tab-cust-info">Customer Info</label>

                <div class="tabs-body">
                    <section class="tab-panel" id="panel-cust-tickets" aria-label="Customer tickets">
                        @if (Model.HistoryUnavailable)
                        {
                            <div class="alert alert-info" role="status">
                                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" /><path d="M12 8h.01M12 11v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                                <span>This customer's ticket history could not be loaded right now.</span>
                            </div>
                        }
                        else
                        {
                            @if (Model.UnitOptions.Count > 1)
                            {
                                <form method="get" action="/Customers" class="filter-bar">
                                    <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
                                    <input type="hidden" name="customer" value="@selected.Key" />
                                    <div class="field-group">
                                        <label class="field-label" for="unitFilter">Unit</label>
                                        <select id="unitFilter" name="unit" class="field-select" data-autosubmit>
                                            <option value="">All Units</option>
                                            @foreach (var unitOption in Model.UnitOptions)
                                            {
                                                <option value="@unitOption" selected="@(string.Equals(unitOption, Model.UnitFilter, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Unit @unitOption</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="filter-bar__submit">
                                        <button type="submit" class="btn btn-sm">Apply</button>
                                    </div>
                                </form>
                            }

                            @if (Model.FilteredTickets.Count == 0)
                            {
                                <div class="empty-state">
                                    <svg viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                    <p>@(Model.UnitFilter is null ? "This customer has no tickets yet." : $"No tickets for Unit {Model.UnitFilter}.")</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-scroll">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th scope="col">Ticket</th>
                                                <th scope="col" class="col-subject">Issue</th>
                                                <th scope="col">Unit</th>
                                                <th scope="col">Status</th>
                                                <th scope="col">Priority</th>
                                                <th scope="col">Created</th>
                                                <th scope="col">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in Model.FilteredTickets)
                                            {
                                                var isFinished = row.TicketStatus is "Resolved" or "Closed";
                                                <tr>
                                                    <td><a class="ticket-id-link" href="/Tickets/@row.TicketId">@row.TicketNumber</a></td>
                                                    <td class="col-subject"><span class="cell-truncate">@(row.RequestSummary ?? "—")</span></td>
                                                    <td>@(string.IsNullOrWhiteSpace(row.UnitNumber) ? "—" : row.UnitNumber)</td>
                                                    <td><span class="badge badge-status-@TicketDisplay.TicketStatusCssKey(row.TicketStatus)"><span class="badge-dot"></span>@TicketDisplay.TicketStatusLabel(row.TicketStatus)</span></td>
                                                    <td><span class="badge badge-priority-@TicketDisplay.PriorityCssKey(row.PriorityId)">@TicketDisplay.PriorityLabel(row.PriorityId)</span></td>
                                                    <td>@row.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                                                    <td>
                                                        <a class="btn btn-sm" href="/Tickets/@row.TicketId">@(isFinished ? "View" : "Open")</a>
                                                        @if (row.IsReopenEligible && Model.ViewerCanReopen)
                                                        {
                                                            <a class="btn btn-sm" href="/Tickets/@row.TicketId?reopen=1">Reopen</a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (Model.History is not null && Model.History.TotalTickets > Model.History.Tickets.Count && Model.UnitFilter is null)
                                {
                                    <p class="workspace-search__hint">Showing the @Model.History.Tickets.Count most recent of @Model.History.TotalTickets tickets.</p>
                                }
                            }
                        }
                    </section>

                    <section class="tab-panel" id="panel-cust-units" aria-label="Customer units and contracts">
                        @if (selected.Units.Count == 0)
                        {
                            <div class="empty-state">
                                <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.8" /></svg>
                                <p>@TicketDisplay.LookupSourceLabel(selected.Source) reports no units for this customer.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-scroll">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Project</th>
                                            <th scope="col">Unit</th>
                                            <th scope="col">Type</th>
                                            <th scope="col">Floor</th>
                                            <th scope="col"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var unitRow in selected.Units)
                                        {
                                            <tr>
                                                <td class="cell-primary">@(unitRow.ProjectName ?? "—")</td>
                                                <td>@(unitRow.UnitNumber ?? "—")</td>
                                                <td>@(unitRow.UnitType ?? "—")</td>
                                                <td>@(unitRow.FloorNumber?.ToString() ?? "—")</td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(unitRow.UnitNumber))
                                                    {
                                                        <a class="link-muted" href="/Customers?@selectedQuery&unit=@Uri.EscapeDataString(unitRow.UnitNumber)">Filter tickets</a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>

                    <section class="tab-panel" id="panel-cust-info" aria-label="Customer information">
                        <dl class="facts-panel">
                            <div class="facts-row"><dt>Name</dt><dd>@(selected.DisplayName ?? "—")</dd></div>
                            <div class="facts-row"><dt>Phone</dt><dd>@(selected.PhoneNumber ?? Model.PhoneNumber)</dd></div>
                            <div class="facts-row"><dt>Email</dt><dd>@(string.IsNullOrWhiteSpace(selected.Email) ? "—" : selected.Email)</dd></div>
                            <div class="facts-row"><dt>Customer type</dt><dd>@(string.IsNullOrWhiteSpace(selected.CustomerType) ? "—" : selected.CustomerType)</dd></div>
                            <div class="facts-row"><dt>Verification source</dt><dd>@TicketDisplay.LookupSourceLabel(selected.Source)</dd></div>
                        </dl>
                    </section>
                </div>
            </div>
        }
    }
</div>
