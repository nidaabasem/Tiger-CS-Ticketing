@page "/Customers"
@model TigerCS.Web.Pages.CustomersModel
@{
    ViewData["Title"] = "Customers";
    ViewData["ActiveNav"] = "customers";
    Layout = "_Layout";
    var nowUtc = DateTime.UtcNow;
}

<div class="page customers-workspace">
    <div class="page-header">
        <div>
            <h1 class="page-title">Customers</h1>
            <p class="page-subtitle">Every customer TigerCS knows, from the tickets raised for them — CRM-verified, PACT/Tasleeh-verified and phone-only callers alike.</p>
        </div>
        <div class="page-header__actions">
            <a class="btn" href="@Model.LookupHref">Look up by phone</a>
            @if (Model.CanCreateTicket)
            {
                <a class="btn btn-gold" href="/NewTicket">+ New Ticket</a>
            }
        </div>
    </div>

    <form class="filter-bar" id="customerFilters" method="get" action="/Customers">
        <div class="search-field filter-bar__search">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            <input type="search" name="search" value="@Model.Search" placeholder="Search by name, phone, unit, project or ticket number…" aria-label="Search customers" />
        </div>

        <div class="field-group">
            <label class="field-label" for="verificationSource">Verification source</label>
            <select class="field-select" id="verificationSource" name="verificationSource" data-autosubmit>
                <option value="">All sources</option>
                @foreach (var (value, label) in CustomersModel.SourceOptions)
                {
                    <option value="@value" selected="@(Model.VerificationSource == value)">@label</option>
                }
            </select>
        </div>

        @if (Model.NameResolver.OwnDepartments.Count > 0)
        {
            <div class="field-group">
                <label class="field-label" for="departmentId">Department</label>
                <select class="field-select" id="departmentId" name="departmentId" data-autosubmit>
                    <option value="">All my departments</option>
                    @foreach (var d in Model.NameResolver.OwnDepartments)
                    {
                        <option value="@d.DepartmentId" selected="@(Model.DepartmentId == d.DepartmentId)">@d.Name</option>
                    }
                </select>
            </div>
        }

        <label class="field-check">
            <input type="checkbox" name="openOnly" value="true" checked="@Model.OpenOnly" data-autosubmit />
            With open tickets
        </label>

        <div class="filter-bar__submit">
            <button type="submit" class="btn btn-sm">Apply</button>
            <a class="btn btn-ghost btn-sm" href="/Customers">Clear</a>
        </div>
    </form>

    <div class="panel">
        <div class="panel__header">
            <span class="panel__title">Customers</span>
            <span class="text-secondary">@Model.TotalCount @(Model.TotalCount == 1 ? "customer" : "customers")@(Model.HasFilters ? " match" : "")</span>
        </div>

        @if (Model.Outcome == ApiOutcome.Unauthorized)
        {
            <div class="error-state">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
                <p>Your session is no longer valid. <a class="link-muted" href="/Logout">Sign in again</a>.</p>
            </div>
        }
        else if (Model.Outcome == ApiOutcome.Forbidden)
        {
            <div class="error-state">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
                <p>Your role does not have access to the customer directory.</p>
            </div>
        }
        else if (Model.Outcome != ApiOutcome.Success)
        {
            <div class="error-state">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
                <p>Tiger Ticketing System could not load the customer directory. Try again in a moment.</p>
            </div>
        }
        else if (Model.Rows.Count == 0 && Model.HasFilters)
        {
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                <p class="empty-state__title">No customers match these filters.</p>
                <p>A customer with no ticket yet is not in the directory — look them up in Tiger CRM, PACT or Tasleeh by phone.</p>
                <div class="empty-state__actions">
                    <a class="btn btn-sm" href="/Customers">Clear filters</a>
                    <a class="btn btn-sm btn-gold" href="@Model.LookupHref">Look up by phone</a>
                </div>
            </div>
        }
        else if (Model.Rows.Count == 0)
        {
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8" /><path d="M4 20c1.8-3.2 4.5-5 8-5s6.2 1.8 8 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                <p class="empty-state__title">No customers yet.</p>
                <p>Customers appear here as tickets are raised for them.</p>
                @if (Model.CanCreateTicket)
                {
                    <a class="btn btn-sm btn-gold" href="/NewTicket">+ New Ticket</a>
                }
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table data-table--clickable">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Phone</th>
                            <th>Project / Unit</th>
                            <th>Verification Source</th>
                            <th class="col-num">Open Tickets</th>
                            <th class="col-num">Total Tickets</th>
                            <th>Last Ticket</th>
                            <th>Last Interaction</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var href = CustomersModel.ProfileHref(row.CustomerKey);
                            <tr class="is-link" data-href="@href">
                                <td>
                                    <a class="customer-link" href="@href">
                                        <span class="customer-link__avatar" aria-hidden="true">@TicketDisplay.Initials(CustomersModel.NameOrPlaceholder(row))</span>
                                        <span>
                                            <span class="cell-primary">@CustomersModel.NameOrPlaceholder(row)</span>
                                            <span class="cell-sub">@(row.IdentityKind == "Crm" ? $"CRM #{row.CustomerKey[4..]}" : row.IdentityKind == "External" ? $"{CustomersModel.SourceLabel(row.VerificationSource)} ID" : "Identified by phone")</span>
                                        </span>
                                    </a>
                                </td>
                                <td class="text-mono">@(string.IsNullOrWhiteSpace(row.PhoneNumber) ? "—" : row.PhoneNumber)</td>
                                <td>
                                    @if (row.ProjectName is null && row.UnitNumber is null)
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                    else
                                    {
                                        <span class="cell-primary">@(row.UnitNumber ?? "—")</span>
                                        <span class="cell-sub">@(row.ProjectName ?? "")</span>
                                    }
                                </td>
                                <td><span class="badge badge-source-@CustomersModel.SourceCssKey(row.VerificationSource)">@CustomersModel.SourceLabel(row.VerificationSource)</span></td>
                                <td class="col-num"><span class="@(row.OpenTickets > 0 ? "count-pill count-pill--attention" : "count-pill")">@row.OpenTickets</span></td>
                                <td class="col-num"><span class="count-pill">@row.TotalTickets</span></td>
                                <td>
                                    <a class="ticket-id-link" href="/Tickets/@row.LastTicketId">@row.LastTicketNumber</a>
                                    <span class="cell-sub">@TicketDisplay.TicketStatusLabel(row.LastTicketStatus) · @row.LastTicketCreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</span>
                                </td>
                                <td class="text-secondary" title="@(row.LastInteractionAtUtc?.ToLocalTime().ToString("MMM d, yyyy HH:mm"))">
                                    @(row.LastInteractionAtUtc is { } lastInteraction ? TicketDisplay.AgoLabel(lastInteraction, nowUtc) : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="panel__footer">
            <span>Page @Model.PageNumber of @Model.TotalPages</span>
            <nav class="pagination" aria-label="Pagination">
                @if (Model.PageNumber > 1)
                {
                    <a href="@Model.PageUrl(Model.PageNumber - 1)">Prev</a>
                }
                else
                {
                    <span class="is-disabled">Prev</span>
                }
                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a href="@Model.PageUrl(Model.PageNumber + 1)">Next</a>
                }
                else
                {
                    <span class="is-disabled">Next</span>
                }
            </nav>
        </div>
    </div>
</div>
