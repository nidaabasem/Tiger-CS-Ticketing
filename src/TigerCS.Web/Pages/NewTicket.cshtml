@page "/NewTicket"
@model TigerCS.Web.Pages.NewTicketModel
@{
    ViewData["Title"] = "New Ticket";
    ViewData["ActiveNav"] = "queue";
    Layout = "_Layout";

    var viewerCanReopen = TicketActions.CanReopen(CurrentUser.FromPrincipal(User)?.Roles);
    var nowUtc = DateTime.UtcNow;

    // The wizard's full carried state, for GET navigation links. Values are
    // dropped (null) per link so Back never loses upstream selections while
    // changing an upstream selection clears what depended on it.
    Dictionary<string, string> StepRoute(string step, bool keepCustomer = true, bool keepUnit = true, string? customerOverride = null)
    {
        var route = new Dictionary<string, string?>
        {
            ["step"] = step,
            ["intakeRecordId"] = Model.IntakeRecordId?.ToString(),
            ["phoneNumber"] = Model.PhoneNumber,
            ["customer"] = customerOverride ?? (keepCustomer ? Model.CustomerKey : null)
        };

        if (keepUnit && customerOverride is null)
        {
            route["crmBuyerCustomerId"] = Model.CrmBuyerCustomerId?.ToString();
            route["crmBuyerLeadId"] = Model.CrmBuyerLeadId?.ToString();
            route["crmBuyerUnitId"] = Model.CrmBuyerUnitId?.ToString();
            route["crmBuyerProjectId"] = Model.CrmBuyerProjectId?.ToString();
            route["crmBuyerCustomerName"] = Model.CrmBuyerCustomerName;
            route["crmBuyerProjectName"] = Model.CrmBuyerProjectName;
            route["crmBuyerUnitNumber"] = Model.CrmBuyerUnitNumber;
            route["externalSelection"] = Model.ExternalSelection;
            route["manualProjectName"] = Model.ManualProjectName;
            route["manualUnitNumber"] = Model.ManualUnitNumber;
        }

        return route.Where(kv => kv.Value is not null).ToDictionary(kv => kv.Key, kv => kv.Value!);
    }

    // The Customer Workspace's selection token for "View all tickets" links.
    string? WorkspaceCustomerKey(TigerCS.Web.Pages.NewTicketCandidate candidate) =>
        candidate.Key == "crm" && Model.CrmBuyerMatch is { } match
            ? $"crm:{match.Customer.CustomerId}"
            : candidate.Key.StartsWith("ext:", StringComparison.Ordinal)
                ? candidate.Key
                : null;

    var steps = new[] { "Customer", "Property", "Issue", "Review" };
}

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">New Ticket</h1>
            <p class="page-subtitle">Create a customer request and route it to the appropriate team.</p>
        </div>
    </div>

    <ol class="wizard-stepper" aria-label="New ticket progress">
        @for (var i = 0; i < steps.Length; i++)
        {
            var number = i + 1;
            var state = number < Model.StepIndex || Model.Step == NewTicketModel.StepDone
                ? "is-complete"
                : number == Model.StepIndex ? "is-current" : "";
            <li class="wizard-stepper__item @state" aria-current="@(state == "is-current" ? "step" : null)">
                <span class="wizard-stepper__num" aria-hidden="true">@number</span>
                <span>@steps[i]</span>
            </li>
        }
    </ol>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error" role="alert">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <div class="wizard-layout">
        <main class="wizard-main">

            @* ---------------- Step 1 — Customer ---------------- *@
            @if (Model.Step == NewTicketModel.StepCustomer)
            {
                <section class="section-card" aria-label="Customer search">
                    <div class="section-card__title">Step 1 — Customer</div>
                    <form method="post" asp-page-handler="Intake" class="wizard-search">
                        <div class="field-group wizard-search__channel">
                            <label class="field-label" asp-for="Intake.ChannelId">Channel</label>
                            <select class="field-select" asp-for="Intake.ChannelId">
                                @foreach (var c in new[] { "Phone", "AppOrWebsite", "WhatsAppOrLiveChat", "SocialMediaDirectMessage", "FaceToFaceKiosk" })
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                        <div class="field-group wizard-search__phone">
                            <label class="field-label" asp-for="Intake.PhoneNumber">Search by phone number</label>
                            <input class="form-control" asp-for="Intake.PhoneNumber" placeholder="+971 50 ..." />
                        </div>
                        <button type="submit" class="btn btn-gold wizard-search__submit">Search</button>
                    </form>
                </section>

                @if (Model.IntakeRecordId is not null)
                {
                    @* Service problems are distinct from "not found" — an
                       unavailable source is said quietly, never presented as
                       a missing customer. *@
                    @if (Model.CrmBuyerLookupUnavailable || Model.CustomerLookupUnavailable
                        || Model.ExternalLookupSources.Any(s => s.Status == "Failed"))
                    {
                        <div class="alert alert-info" role="status">
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" /><path d="M12 8h.01M12 11v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                            <span>
                                @(string.Join(" ", new[]
                                {
                                    Model.CrmBuyerLookupUnavailable ? "Tiger CRM is temporarily unavailable." : null,
                                    Model.CustomerLookupUnavailable ? "Some lookup sources could not be reached." : null
                                }.Concat(Model.ExternalLookupSources
                                    .Where(s => s.Status == "Failed")
                                    .Select(s => $"{TicketDisplay.LookupSourceLabel(s.Source)} is temporarily unavailable."))
                                .Where(m => m is not null)))
                                You can continue with manual entry.
                            </span>
                        </div>
                    }
                    @if (Model.CrmBuyerAmbiguousMatch)
                    {
                        <div class="alert alert-info" role="status">
                            <span>Multiple CRM customer records were found for this phone number. Continue with manual entry.</span>
                        </div>
                    }
                    @if (Model.NoLookupSourcesConfigured)
                    {
                        <div class="alert alert-info" role="status">
                            <span>No customer lookup sources are configured, so nothing was searched. You can continue with manual entry.</span>
                        </div>
                    }

                    @if (Model.Candidates.Count > 0)
                    {
                        <div class="candidate-list" aria-label="Matched customers">
                            @foreach (var candidate in Model.Candidates)
                            {
                                Model.CandidateHistories.TryGetValue(candidate.Key, out var history);
                                <section class="candidate-card candidate-card--stack">
                                    <div class="candidate-card__top">
                                        <div>
                                            <div class="candidate-card__name">@(candidate.DisplayName ?? "(no name on file)")</div>
                                            <div class="candidate-card__meta">
                                                @(candidate.PhoneNumber ?? Model.PhoneNumber)@(string.IsNullOrWhiteSpace(candidate.Email) ? "" : $" · {candidate.Email}")
                                            </div>
                                            @* Identity verified via the source that matched it. *@
                                            <div class="candidate-card__counts">
                                                <span>@candidate.UnitsCount Unit@(candidate.UnitsCount == 1 ? "" : "s")</span>
                                                @if (history is not null)
                                                {
                                                    <span>@history.TotalTickets Previous Ticket@(history.TotalTickets == 1 ? "" : "s")</span>
                                                    <span>@history.OpenTickets Open Ticket@(history.OpenTickets == 1 ? "" : "s")</span>
                                                }
                                            </div>
                                        </div>
                                        <span class="badge badge-verification-verified"><span class="badge-dot"></span>Verified via @TicketDisplay.LookupSourceLabel(candidate.Source)</span>
                                    </div>

                                    @if (history is { Tickets.Count: > 0 })
                                    {
                                        <div class="existing-tickets" aria-label="Existing tickets">
                                            <div class="existing-tickets__title">Existing tickets</div>
                                            @foreach (var row in history.Tickets)
                                            {
                                                var isFinished = row.TicketStatus is "Resolved" or "Closed";
                                                <div class="existing-tickets__row">
                                                    <a class="ticket-id-link" href="/Tickets/@row.TicketId">@row.TicketNumber</a>
                                                    <span class="cell-truncate">@(string.IsNullOrWhiteSpace(row.RequestSummary) ? "—" : row.RequestSummary)</span>
                                                    <span class="badge badge-status-@TicketDisplay.TicketStatusCssKey(row.TicketStatus)"><span class="badge-dot"></span>@TicketDisplay.TicketStatusLabel(row.TicketStatus)</span>
                                                    @if (!string.IsNullOrWhiteSpace(row.UnitNumber))
                                                    {
                                                        <span class="existing-tickets__unit">Unit @row.UnitNumber</span>
                                                    }
                                                    <span class="existing-tickets__actions">
                                                        <a class="btn btn-sm" href="/Tickets/@row.TicketId">@(isFinished ? "View" : "Open")</a>
                                                        @if (row.IsReopenEligible && viewerCanReopen)
                                                        {
                                                            <a class="btn btn-sm" href="/Tickets/@row.TicketId?reopen=1">Reopen</a>
                                                        }
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <div class="candidate-card__actions">
                                        <a class="btn btn-gold" asp-page="/NewTicket"
                                           asp-all-route-data="@StepRoute(NewTicketModel.StepProperty, customerOverride: candidate.Key)">Use this customer</a>
                                        @if (WorkspaceCustomerKey(candidate) is { } workspaceKey && Model.PhoneNumber is not null)
                                        {
                                            <a class="btn btn-sm"
                                               href="/Customers?phoneNumber=@Uri.EscapeDataString(Model.PhoneNumber)&customer=@Uri.EscapeDataString(workspaceKey)">View all tickets</a>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                        <p class="wizard-quiet-action">
                            <a asp-page="/NewTicket" asp-all-route-data="@StepRoute(NewTicketModel.StepProperty, customerOverride: "manual")">Not one of these? Continue with Manual Entry</a>
                        </p>
                    }
                    else
                    {
                        <section class="section-card">
                            <div class="empty-state">
                                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8" /><path d="M4 20c1.8-3.2 4.5-5 8-5s6.2 1.8 8 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                                <p><strong>Customer not found</strong></p>
                                <p>You can continue and enter the customer information manually.</p>
                                <a class="btn btn-gold" asp-page="/NewTicket"
                                   asp-all-route-data="@StepRoute(NewTicketModel.StepProperty, customerOverride: "manual")">Continue with Manual Entry</a>
                            </div>
                        </section>
                    }
                }
            }

            @* ---------------- Step 2 — Property / Unit ---------------- *@
            @if (Model.Step == NewTicketModel.StepProperty)
            {
                <section class="section-card" aria-label="Select property">
                    <div class="section-card__title">Step 2 — Select property</div>
                    <p class="wizard-support">Choose the unit related to this request.</p>

                    @if (Model.HasUnitSelection)
                    {
                        <div class="unit-option unit-option--selected" aria-current="true">
                            <div>
                                <div class="unit-option__title"><span class="selected-check" aria-hidden="true">✓</span> Selected — @(Model.SummaryProjectName ?? "Project")</div>
                                <div class="unit-option__meta">
                                    Unit @Model.SummaryUnitNumber
                                    @if (Model.SummarySourceKey is { } sourceKey && sourceKey != "Manual")
                                    {
                                        <text> · verified via @TicketDisplay.LookupSourceLabel(sourceKey)</text>
                                    }
                                    else
                                    {
                                        <text> · Manual entry</text>
                                    }
                                </div>
                            </div>
                            <a class="btn btn-sm" asp-page="/NewTicket"
                               asp-all-route-data="@StepRoute(NewTicketModel.StepProperty, keepUnit: false)">Change</a>
                        </div>

                        @if (Model.RelatedTickets is not null && Model.RelatedTickets.Tickets.Count > 0)
                        {
                            var related = Model.RelatedTickets;
                            @* Duplicate-ticket awareness — advisory only:
                               same verified identity + same unit, active
                               first, one-line summaries, never blocking. *@
                            <aside class="related-tickets" aria-label="Related tickets for this unit">
                                <div class="related-tickets__title">Related tickets for this unit</div>
                                <p class="related-tickets__hint">Check whether one of these already covers the same issue before creating a new ticket.</p>
                                @foreach (var row in related.Tickets)
                                {
                                    var isFinished = row.TicketStatus is "Resolved" or "Closed";
                                    <div class="related-ticket-row">
                                        <div class="related-ticket-row__main">
                                            <a class="ticket-id-link" href="/Tickets/@row.TicketId">@row.TicketNumber</a>
                                            <span class="cell-truncate">@(string.IsNullOrWhiteSpace(row.RequestSummary) ? "—" : row.RequestSummary)</span>
                                        </div>
                                        <div class="related-ticket-row__meta">
                                            <span class="badge badge-status-@TicketDisplay.TicketStatusCssKey(row.TicketStatus)"><span class="badge-dot"></span>@TicketDisplay.TicketStatusLabel(row.TicketStatus)</span>
                                            <span>
                                                @(row.ResolvedAtUtc is DateTime resolvedAt
                                                    ? $"Resolved {TicketDisplay.FormatDuration(nowUtc - resolvedAt)} ago"
                                                    : $"Created {row.CreatedAtUtc.ToLocalTime():d MMM yyyy}")
                                            </span>
                                        </div>
                                        <div class="related-ticket-row__actions">
                                            <a class="btn btn-sm" href="/Tickets/@row.TicketId">@(isFinished ? "View" : "Open")</a>
                                            @if (row.IsReopenEligible && viewerCanReopen)
                                            {
                                                <a class="btn btn-sm" href="/Tickets/@row.TicketId?reopen=1">Reopen</a>
                                            }
                                        </div>
                                    </div>
                                }
                            </aside>
                        }

                        <div class="wizard-actions">
                            <a class="btn" asp-page="/NewTicket" asp-all-route-data="@StepRoute(NewTicketModel.StepCustomer, keepCustomer: false, keepUnit: false)">Back</a>
                            <a class="btn btn-gold" asp-page="/NewTicket" asp-all-route-data="@StepRoute(NewTicketModel.StepIssue)">@(Model.RelatedTickets is { Tickets.Count: > 0 } ? "Continue with New Ticket" : "Continue to Issue")</a>
                        </div>
                    }
                    else if (Model.CustomerKey == "crm" && Model.CrmBuyerMatch is { } match)
                    {
                        var customerName = match.Customer.FullNameEnglish ?? match.Customer.FullNameArabic;
                        <div class="unit-list" aria-label="Units">
                            @foreach (var unit in match.Units)
                            {
                                var statusLabel = unit.LeadStatusName ?? unit.LeadStatus.ToString();
                                var packedValue = string.Join(':',
                                    match.Customer.CustomerId, unit.LeadId, unit.UnitId, unit.ProjectId,
                                    Uri.EscapeDataString(customerName ?? string.Empty),
                                    Uri.EscapeDataString(unit.ProjectName ?? string.Empty),
                                    Uri.EscapeDataString(unit.UnitNumber ?? string.Empty));
                                <div class="unit-option">
                                    <div>
                                        <div class="unit-option__title">@(unit.ProjectName ?? "Project")</div>
                                        <div class="unit-option__meta">Unit @unit.UnitNumber · @statusLabel</div>
                                    </div>
                                    <form method="post" asp-page-handler="UseCrmBuyerUnit">
                                        <input type="hidden" name="intakeRecordId" value="@Model.IntakeRecordId" />
                                        <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
                                        <input type="hidden" name="selectedCrmBuyerUnit" value="@packedValue" />
                                        <button type="submit" class="btn btn-sm">Select</button>
                                    </form>
                                </div>
                            }
                        </div>
                        <p class="wizard-quiet-action">
                            Can't find the unit?
                            <a asp-page="/NewTicket" asp-all-route-data="@StepRoute(NewTicketModel.StepProperty, keepUnit: false, customerOverride: "manual")">Enter property manually</a>
                        </p>
                        <div class="wizard-actions">
                            <a class="btn" asp-page="/NewTicket" asp-all-route-data="@StepRoute(NewTicketModel.StepCustomer, keepCustomer: false, keepUnit: false)">Back</a>
                        </div>
                    }
                    else if (Model.CustomerKey?.StartsWith("ext:", StringComparison.Ordinal) == true
                        && Model.SelectedCandidate is { } selectedCandidate)
                    {
                        var externalSource = Model.ExternalLookupSources
                            .Where(s => s.Status == "Found")
                            .FirstOrDefault(s => selectedCandidate.Source == s.Source);
                        var externalCustomer = externalSource?.Customers
                            .FirstOrDefault(c => Model.CustomerKey == $"ext:{Uri.EscapeDataString(externalSource.Source)}:{Uri.EscapeDataString(c.ExternalCustomerId)}");

                        if (externalCustomer is { Units.Count: > 0 })
                        {
                            <div class="unit-list" aria-label="Units">
                                @foreach (var unit in externalCustomer.Units)
                                {
                                    var packedValue = string.Join(':',
                                        Uri.EscapeDataString(externalSource!.Source),
                                        Uri.EscapeDataString(externalCustomer.ExternalCustomerId),
                                        Uri.EscapeDataString(unit.ExternalUnitId),
                                        Uri.EscapeDataString(externalCustomer.DisplayName ?? string.Empty),
                                        Uri.EscapeDataString(unit.PropertyName ?? string.Empty),
                                        Uri.EscapeDataString(unit.UnitNumber ?? string.Empty));
                                    <div class="unit-option">
                                        <div>
                                            <div class="unit-option__title">@(unit.PropertyName ?? "Project")</div>
                                            <div class="unit-option__meta">Unit @unit.UnitNumber@(string.IsNullOrWhiteSpace(unit.UnitType) ? "" : $" · {unit.UnitType}")</div>
                                        </div>
                                        <form method="post" asp-page-handler="UseExternalUnit">
                                            <input type="hidden" name="intakeRecordId" value="@Model.IntakeRecordId" />
                                            <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
                                            <input type="hidden" name="customer" value="@Model.CustomerKey" />
                                            <input type="hidden" name="selectedExternalUnit" value="@packedValue" />
                                            <button type="submit" class="btn btn-sm">Select</button>
                                        </form>
                                    </div>
                                }
                            </div>
                            <p class="wizard-quiet-action">
                                Can't find the unit?
                                <a asp-page="/NewTicket" asp-all-route-data="@StepRoute(NewTicketModel.StepProperty, keepUnit: false, customerOverride: "manual")">Enter property manually</a>
                            </p>
                        }
                        else
                        {
                            <div class="alert alert-info" role="status">
                                <span>@TicketDisplay.LookupSourceLabel(selectedCandidate.Source) reports no units for this customer — enter the property manually below.</span>
                            </div>
                            @await Html.PartialAsync("_NewTicketManualUnitForm", Model)
                        }
                        <div class="wizard-actions">
                            <a class="btn" asp-page="/NewTicket" asp-all-route-data="@StepRoute(NewTicketModel.StepCustomer, keepCustomer: false, keepUnit: false)">Back</a>
                        </div>
                    }
                    else
                    {
                        @* Manual path (customer not found, a source failure,
                           or the agent's explicit choice). *@
                        @await Html.PartialAsync("_NewTicketManualUnitForm", Model)
                        <div class="wizard-actions">
                            <a class="btn" asp-page="/NewTicket" asp-all-route-data="@StepRoute(NewTicketModel.StepCustomer, keepCustomer: false, keepUnit: false)">Back</a>
                        </div>
                    }
                </section>
            }

            @* ---------------- Step 3 — Issue ---------------- *@
            @if (Model.Step == NewTicketModel.StepIssue)
            {
                <section class="section-card" aria-label="Issue details">
                    <div class="section-card__title">Step 3 — Issue</div>

                    @if (Model.CategoriesErrorMessage is not null)
                    {
                        <div class="alert alert-error" role="alert"><span>@Model.CategoriesErrorMessage</span></div>
                    }
                    @if (Model.DepartmentsErrorMessage is not null)
                    {
                        <div class="alert alert-error" role="alert"><span>@Model.DepartmentsErrorMessage</span></div>
                    }

                    @if (Model.CategoriesErrorMessage is null && Model.Categories.Count == 0 && Model.CreateStep.DepartmentId is not null)
                    {
                        <div class="alert alert-info" role="status">
                            <span>No active categories are configured for this department.</span>
                        </div>
                    }

                    <form method="post" asp-page-handler="IssueRefresh" id="new-ticket-form">
                        @await Html.PartialAsync("_NewTicketWizardState", Model)
                        <input type="hidden" asp-for="CreateStep.ManualProjectName" />
                        <input type="hidden" asp-for="CreateStep.ManualUnitNumber" />

                        <div class="form-group">
                            <label class="form-label" asp-for="CreateStep.DepartmentId">Department</label>
                            <select class="form-control" asp-for="CreateStep.DepartmentId" data-autosubmit>
                                <option value="">All departments</option>
                                @foreach (var department in Model.Departments)
                                {
                                    <option value="@department.DepartmentId">@department.Name</option>
                                }
                            </select>
                            <span class="field-hint">Narrows the request types below. The ticket routes to the team that owns the selected request type.</span>
                        </div>

                        <div class="form-group">
                            <label class="form-label" asp-for="CreateStep.CategoryId">Request Type *</label>
                            <select class="form-control" asp-for="CreateStep.CategoryId">
                                <option value="">Select Request Type</option>
                                @foreach (var group in Model.Categories.GroupBy(c => c.DepartmentName))
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var category in group)
                                        {
                                            <option value="@category.CategoryId">@category.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label" asp-for="CreateStep.PriorityId">Priority *</label>
                            <select class="form-control" asp-for="CreateStep.PriorityId">
                                <option value="">Select Priority</option>
                                @for (byte p = 1; p <= 4; p++)
                                {
                                    <option value="@p">@TicketDisplay.PriorityLabel(p)</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label" asp-for="CreateStep.RequestSummary">Customer Request *</label>
                            <textarea class="form-control" asp-for="CreateStep.RequestSummary" rows="4"></textarea>
                            <span class="field-hint">Describe the issue, relevant details, and what the customer is requesting.</span>
                        </div>

                        <div class="wizard-actions">
                            <a class="btn" asp-page="/NewTicket" asp-all-route-data="@StepRoute(NewTicketModel.StepProperty)">Back</a>
                            <button type="submit" class="btn btn-gold" asp-page-handler="Review">Review Ticket</button>
                        </div>
                    </form>
                </section>
            }

            @* ---------------- Step 4 — Review & Create ---------------- *@
            @if (Model.Step == NewTicketModel.StepReview)
            {
                <section class="section-card" aria-label="Review and create">
                    <div class="section-card__title">Step 4 — Review &amp; Create</div>

                    <dl class="review-grid">
                        <div class="review-block">
                            <dt>Customer</dt>
                            <dd>
                                <strong>@(Model.SummaryCustomerName ?? "—")</strong><br />
                                @Model.PhoneNumber<br />
                                @(Model.SummarySourceKey is { } srcKey && srcKey != "Manual"
                                    ? $"Verified via {TicketDisplay.LookupSourceLabel(srcKey)}"
                                    : "Manual entry")
                            </dd>
                        </div>
                        <div class="review-block">
                            <dt>Property</dt>
                            <dd>
                                <strong>@(Model.SummaryProjectName ?? "—")</strong><br />
                                Unit @(Model.SummaryUnitNumber ?? "—")
                            </dd>
                        </div>
                        <div class="review-block">
                            <dt>Request</dt>
                            <dd>
                                <strong>@(Model.SelectedCategory?.Name ?? "—")</strong><br />
                                @(Model.SummaryDepartmentName ?? "—")<br />
                                @(Model.CreateStep.PriorityId is { } priorityId ? $"{TicketDisplay.PriorityLabel(priorityId)} Priority" : "—")
                            </dd>
                        </div>
                        <div class="review-block review-block--wide">
                            <dt>Customer Request</dt>
                            <dd class="review-description">@Model.CreateStep.RequestSummary</dd>
                        </div>
                    </dl>

                    <form method="post" asp-page-handler="Create">
                        @await Html.PartialAsync("_NewTicketWizardState", Model)
                        <input type="hidden" asp-for="CreateStep.DepartmentId" />
                        <input type="hidden" asp-for="CreateStep.CategoryId" />
                        <input type="hidden" asp-for="CreateStep.PriorityId" />
                        <input type="hidden" asp-for="CreateStep.RequestSummary" />
                        <input type="hidden" asp-for="CreateStep.ManualProjectName" />
                        <input type="hidden" asp-for="CreateStep.ManualUnitNumber" />
                        <div class="wizard-actions">
                            <button type="submit" class="btn" asp-page-handler="IssueRefresh">Back to Edit</button>
                            <button type="submit" class="btn btn-gold">Create Ticket</button>
                        </div>
                    </form>
                </section>
            }

            @* ---------------- Done ---------------- *@
            @if (Model.Step == NewTicketModel.StepDone)
            {
                <section class="section-card" aria-label="Ticket created">
                    <div class="success-card">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        <p class="success-card__title">Ticket Created</p>
                        <p class="success-card__number">@Model.CreatedTicketNumber</p>
                        <div class="wizard-actions wizard-actions--center">
                            <a class="btn btn-gold" href="/Tickets/@Model.CreatedTicketId">View Ticket</a>
                            <a class="btn" href="/NewTicket">Create Another Ticket</a>
                            <a class="btn" href="/Dashboard">Back to Dashboard</a>
                        </div>
                    </div>
                </section>
            }
        </main>

        @* ---------------- Sticky summary panel ---------------- *@
        @if (Model.Step != NewTicketModel.StepDone)
        {
            <aside class="wizard-summary" aria-label="Ticket summary so far">
                <div class="wizard-summary__title">Summary</div>
                <dl>
                    <div class="wizard-summary__row">
                        <dt>Customer</dt>
                        <dd>@if (Model.SummaryCustomerName is { } summaryName) { @summaryName } else { <span class="wizard-summary__empty">Not selected yet</span> }</dd>
                    </div>
                    <div class="wizard-summary__row">
                        <dt>Verification</dt>
                        <dd>
                            @if (Model.SummarySourceKey is { } sourceKey)
                            {
                                @(sourceKey == "Manual" ? "Manual entry" : TicketDisplay.LookupSourceLabel(sourceKey))
                            }
                            else { <span class="wizard-summary__empty">Not selected yet</span> }
                        </dd>
                    </div>
                    <div class="wizard-summary__row">
                        <dt>Phone</dt>
                        <dd>@if (Model.PhoneNumber is { } phone) { @phone } else { <span class="wizard-summary__empty">—</span> }</dd>
                    </div>
                    <div class="wizard-summary__row">
                        <dt>Project</dt>
                        <dd>@if (Model.SummaryProjectName is { } project) { @project } else { <span class="wizard-summary__empty">Not selected yet</span> }</dd>
                    </div>
                    <div class="wizard-summary__row">
                        <dt>Unit</dt>
                        <dd>@if (Model.SummaryUnitNumber is { } unitNo) { @unitNo } else { <span class="wizard-summary__empty">Not selected yet</span> }</dd>
                    </div>
                    <div class="wizard-summary__row">
                        <dt>Department</dt>
                        <dd>@if (Model.SummaryDepartmentName is { } deptName) { @deptName } else { <span class="wizard-summary__empty">Not selected yet</span> }</dd>
                    </div>
                    <div class="wizard-summary__row">
                        <dt>Request Type</dt>
                        <dd>@if (Model.SelectedCategory is { } selectedCategory) { @selectedCategory.Name } else { <span class="wizard-summary__empty">Not selected yet</span> }</dd>
                    </div>
                    <div class="wizard-summary__row">
                        <dt>Priority</dt>
                        <dd>@if (Model.CreateStep.PriorityId is { } summaryPriority) { @TicketDisplay.PriorityLabel(summaryPriority) } else { <span class="wizard-summary__empty">Not selected yet</span> }</dd>
                    </div>
                </dl>
            </aside>
        }
    </div>
</div>
