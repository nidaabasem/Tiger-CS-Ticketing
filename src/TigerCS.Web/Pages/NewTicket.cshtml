@page "/NewTicket"
@model TigerCS.Web.Pages.NewTicketModel
@{
    ViewData["Title"] = "New Ticket";
    ViewData["ActiveNav"] = "queue";
    Layout = "_Layout";
}

<div class="page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/Tickets">Tickets</a>
        <span class="sep">/</span>
        <span class="current">New Ticket</span>
    </nav>

    <div class="page-header">
        <h1 class="page-title">New Ticket</h1>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error" role="alert">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <div class="section-card wizard-card">
        @if (Model.Step == "intake")
        {
            <div class="section-card__title">Step 1 — Record the interaction</div>
            <form method="post" asp-page-handler="Intake">
                <div class="form-group">
                    <label class="form-label" asp-for="Intake.ChannelId">Channel</label>
                    <select class="form-control" asp-for="Intake.ChannelId">
                        @foreach (var c in new[] { "Phone", "AppOrWebsite", "WhatsAppOrLiveChat", "SocialMediaDirectMessage", "FaceToFaceKiosk" })
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Intake.PhoneNumber">Customer Phone Number *</label>
                    <input class="form-control" asp-for="Intake.PhoneNumber" placeholder="+9715XXXXXXXX" />
                    <span class="field-hint">Used to search for this customer. Which systems are searched depends on the Department selected below.</span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Intake.DepartmentId">Department (optional)</label>
                    @if (Model.DepartmentsErrorMessage is not null)
                    {
                        <div class="alert alert-error" role="alert">
                            <span>@Model.DepartmentsErrorMessage</span>
                        </div>
                    }
                    <select class="form-control" asp-for="Intake.DepartmentId">
                        <option value="">Select Department</option>
                        @foreach (var department in Model.Departments)
                        {
                            <option value="@department.DepartmentId">@department.Name</option>
                        }
                    </select>
                    <span class="field-hint">
                        If set, customer lookup searches only that Department's configured source(s) (CRM/PACT/Tasleeh).
                        Leave unselected to search all three.
                    </span>
                </div>
                <button type="submit" class="btn btn-gold">Continue</button>
            </form>
        }
        else if (Model.Step == "lookup")
        {
            <div class="section-card__title">Step 2 — Customer lookup</div>
            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
            {
                <p class="text-secondary">Phone number on file: <strong>@Model.PhoneNumber</strong></p>
            }
            <p class="text-secondary">
                Searching by phone number, scoped to the Department's configured source(s) if one was selected (otherwise CRM, PACT, and Tasleeh).
                Only the systems actually searched are shown below. A source finding nothing, or being unavailable, never blocks creating the ticket.
            </p>

            @if (Model.LookupResult is not null && Model.LookupResult.Sources.Count == 0)
            {
                <div class="alert alert-info" role="status">
                    <span>Customer lookup is not configured for the selected department. You can continue creating the ticket.</span>
                </div>
            }
            else if (Model.LookupResult is not null)
            {
                @if (!Model.LookupResult.Sources.Any(s => s.Status == "Found" && s.Customers.Count > 0))
                {
                    <div class="alert alert-info" role="status">
                        <span>No customer information found. You can continue creating the ticket.</span>
                    </div>
                }
                <div class="entry-list entry-list--spaced">
                    @foreach (var source in Model.LookupResult.Sources)
                    {
                        <div class="entry-row entry-row--block">
                            <div>
                                <strong>@source.Source</strong>
                                @if (source.Status == "Found")
                                {
                                    <span class="text-secondary">· @source.Customers.Count matching customer@(source.Customers.Count == 1 ? "" : "s")</span>
                                }
                                else if (source.Status == "NotFound")
                                {
                                    <span class="text-secondary">· No match found</span>
                                }
                                else
                                {
                                    <span class="text-secondary">· @source.Source is temporarily unavailable</span>
                                }
                            </div>

                            @if (source.Status == "Found")
                            {
                                @foreach (var customer in source.Customers)
                                {
                                    var selectableUnits = customer.Units.Where(u => u.UnitReferenceId is not null && u.ContactReferenceId is not null).ToList();
                                    <div class="customer-card">
                                        <div><strong>@(customer.DisplayName ?? "(no name on file)")</strong></div>
                                        <div class="text-secondary">
                                            @(customer.PhoneNumber is null ? "" : customer.PhoneNumber)
                                            @(customer.Email is null ? "" : $"· {customer.Email}")
                                            @(customer.CustomerType is null ? "" : $"· {customer.CustomerType}")
                                        </div>

                                        @if (selectableUnits.Count == 0)
                                        {
                                            <p class="text-secondary">No eligible units found.</p>
                                            <form method="post" asp-page-handler="ContinueWithoutMatch">
                                                <input type="hidden" name="intakeRecordId" value="@Model.IntakeRecordId" />
                                                <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
                                                <input type="hidden" name="departmentId" value="@Model.DepartmentId" />
                                                @if (customer.DisplayName is not null)
                                                {
                                                    <input type="hidden" name="customerDisplayName" value="@customer.DisplayName" />
                                                }
                                                <button type="submit" class="btn btn-sm">Use this customer</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="UseMatch">
                                                <input type="hidden" name="intakeRecordId" value="@Model.IntakeRecordId" />
                                                <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
                                                <input type="hidden" name="departmentId" value="@Model.DepartmentId" />
                                                @if (customer.DisplayName is not null)
                                                {
                                                    <input type="hidden" name="customerDisplayName" value="@customer.DisplayName" />
                                                }
                                                <div class="unit-options">
                                                    <p class="text-secondary">Select Unit (optional)</p>
                                                    @foreach (var unit in selectableUnits)
                                                    {
                                                        var unitLabel = $"{unit.PropertyName ?? unit.TowerName ?? "Unit"} — Unit {unit.UnitNumber}{(string.IsNullOrEmpty(unit.UnitType) ? "" : $" ({unit.UnitType})")}";
                                                        <label class="checkbox-field">
                                                            <input type="radio" name="selectedUnitRef" value="@($"{unit.UnitReferenceId}:{unit.ContactReferenceId}:{Uri.EscapeDataString(unitLabel)}")" required />
                                                            @unitLabel
                                                        </label>
                                                    }
                                                </div>
                                                <button type="submit" class="btn btn-sm">Use this customer</button>
                                            </form>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }

            <form method="post" asp-page-handler="ContinueWithoutMatch">
                <input type="hidden" name="intakeRecordId" value="@Model.IntakeRecordId" />
                <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
                <input type="hidden" name="departmentId" value="@Model.DepartmentId" />
                <button type="submit" class="btn">Continue to Ticket</button>
            </form>
        }
        else if (Model.Step == "create")
        {
            <div class="section-card__title">Step 3 — Ticket details</div>

            <div class="customer-card">
                <div><strong>Phone</strong></div>
                <div class="text-secondary">@(Model.PhoneNumber ?? "—")</div>

                <div><strong>Customer</strong></div>
                <div class="text-secondary">@(Model.CustomerDisplayName ?? "No customer match linked — the ticket will still be created.")</div>

                @if (Model.UnitLabel is not null)
                {
                    <div><strong>Unit</strong></div>
                    <div class="text-secondary">@Model.UnitLabel</div>
                }

                <p>
                    <a class="btn btn-sm" asp-page="/NewTicket" asp-route-step="lookup"
                       asp-route-intakeRecordId="@Model.IntakeRecordId" asp-route-phoneNumber="@Model.PhoneNumber"
                       asp-route-departmentId="@Model.DepartmentId">Change customer/unit</a>
                </p>
            </div>

            @if (Model.CategoriesErrorMessage is not null)
            {
                <div class="alert alert-error" role="alert">
                    <span>@Model.CategoriesErrorMessage</span>
                </div>
                <p>
                    <a class="btn btn-sm" asp-page="/NewTicket"
                       asp-route-step="create" asp-route-intakeRecordId="@Model.IntakeRecordId" asp-route-phoneNumber="@Model.PhoneNumber"
                       asp-route-departmentId="@Model.DepartmentId" asp-route-unitReferenceId="@Model.UnitReferenceId"
                       asp-route-contactReferenceId="@Model.ContactReferenceId" asp-route-customerDisplayName="@Model.CustomerDisplayName"
                       asp-route-unitLabel="@Model.UnitLabel">Retry</a>
                </p>
            }
            else if (Model.Categories.Count == 0)
            {
                <div class="alert alert-info" role="status">
                    <span>No active categories are configured for this department.</span>
                </div>
            }
            else
            {
                <form method="post" asp-page-handler="Create">
                    <input type="hidden" name="intakeRecordId" value="@Model.IntakeRecordId" />
                    <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
                    <input type="hidden" name="departmentId" value="@Model.DepartmentId" />
                    <input type="hidden" name="unitReferenceId" value="@Model.UnitReferenceId" />
                    <input type="hidden" name="contactReferenceId" value="@Model.ContactReferenceId" />
                    <input type="hidden" name="customerDisplayName" value="@Model.CustomerDisplayName" />
                    <input type="hidden" name="unitLabel" value="@Model.UnitLabel" />
                    <div class="form-group">
                        <label class="form-label" asp-for="CreateStep.CategoryId">Category *</label>
                        <select class="form-control" asp-for="CreateStep.CategoryId" required>
                            <option value="">Select Category</option>
                            @foreach (var group in Model.Categories.GroupBy(c => c.DepartmentName))
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var category in group)
                                    {
                                        <option value="@category.CategoryId">@category.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="CreateStep.PriorityId">Priority *</label>
                        <select class="form-control" asp-for="CreateStep.PriorityId" required>
                            <option value="">Select Priority</option>
                            @for (byte p = 1; p <= 4; p++)
                            {
                                <option value="@p">@TicketDisplay.PriorityLabel(p)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="CreateStep.RequestSummary">Request Summary *</label>
                        <textarea class="form-control" asp-for="CreateStep.RequestSummary" rows="3" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-gold">Create ticket</button>
                </form>
            }
        }
    </div>
</div>
