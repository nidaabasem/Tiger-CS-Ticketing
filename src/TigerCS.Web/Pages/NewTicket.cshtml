@page "/NewTicket"
@model TigerCS.Web.Pages.NewTicketModel
@{
    ViewData["Title"] = "New Ticket";
    ViewData["ActiveNav"] = "queue";
    Layout = "_Layout";
}

<div class="page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/Tickets">Tickets</a>
        <span class="sep">/</span>
        <span class="current">New Ticket</span>
    </nav>

    <div class="page-header">
        <h1 class="page-title">New Ticket</h1>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error" role="alert">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <div class="section-card wizard-card">
        @if (Model.Step == "intake")
        {
            <div class="section-card__title">Step 1 — Record the interaction</div>
            <form method="post" asp-page-handler="Intake">
                <div class="form-group">
                    <label class="form-label" asp-for="Intake.ChannelId">Channel</label>
                    <select class="form-control" asp-for="Intake.ChannelId">
                        @foreach (var c in new[] { "Phone", "AppOrWebsite", "WhatsAppOrLiveChat", "SocialMediaDirectMessage", "FaceToFaceKiosk" })
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Intake.PhoneNumber">Customer Phone Number *</label>
                    <input class="form-control" asp-for="Intake.PhoneNumber" placeholder="+9715XXXXXXXX" />
                    <span class="field-hint">Used to search for this customer. Which systems are searched depends on the Department selected below.</span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Intake.DepartmentId">Department (optional)</label>
                    @if (Model.DepartmentsErrorMessage is not null)
                    {
                        <div class="alert alert-error" role="alert">
                            <span>@Model.DepartmentsErrorMessage</span>
                        </div>
                    }
                    <select class="form-control" asp-for="Intake.DepartmentId">
                        <option value="">Select Department</option>
                        @foreach (var department in Model.Departments)
                        {
                            <option value="@department.DepartmentId">@department.Name</option>
                        }
                    </select>
                    <span class="field-hint">
                        If set, customer lookup searches only that Department's configured source(s) (CRM/PACT/Tasleeh).
                        Leave unselected to search all three.
                    </span>
                </div>
                <button type="submit" class="btn btn-gold">Continue</button>
            </form>
        }
        else if (Model.Step == "lookup")
        {
            <div class="section-card__title">Step 2 — Customer lookup</div>
            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
            {
                <p class="text-secondary">Phone number on file: <strong>@Model.PhoneNumber</strong></p>
            }
            <p class="text-secondary">
                Searching by phone number only, across the source(s) configured for the selected Department
                (all sources when no Department was selected). Results are listed per source — select the customer/unit that applies,
                or continue without a match.
            </p>

            @if (Model.CustomerLookupUnavailable)
            {
                <div class="alert alert-info" role="status">
                    <span>The department lookup configuration could not be loaded — searching Tiger CRM only for now. This does not block ticket creation.</span>
                </div>
            }
            else if (Model.NoLookupSourcesConfigured)
            {
                <div class="alert alert-info" role="status">
                    <span>No customer lookup sources are configured for this Department, so nothing was searched. You can continue; Project and Unit Number will be required.</span>
                </div>
            }

            @if (Model.CrmParticipates)
            {
            <p class="text-secondary">
                <strong>Tiger CRM</strong> — Buyer records with a Sold or Contract lead.
                A phone number belongs to exactly one CRM customer; that customer may own multiple eligible units — select the one that applies.
            </p>

            @if (Model.CrmBuyerMatch is { } match)
            {
                var customer = match.Customer;
                var customerName = customer.FullNameEnglish ?? customer.FullNameArabic;
                <div class="customer-card">
                    <div><strong>@(customerName ?? "(no name on file)")</strong></div>
                    <div class="text-secondary">
                        @(customer.MobileNumber is null ? "" : customer.MobileNumber)
                        @(customer.Email is null ? "" : $"· {customer.Email}")
                    </div>

                    <form method="post" asp-page-handler="UseCrmBuyerUnit">
                        <input type="hidden" name="intakeRecordId" value="@Model.IntakeRecordId" />
                        <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
                        <input type="hidden" name="departmentId" value="@Model.DepartmentId" />
                        <div class="unit-options">
                            <p class="text-secondary">Select Unit</p>
                            @foreach (var unit in match.Units)
                            {
                                var statusLabel = unit.LeadStatusName ?? unit.LeadStatus.ToString();
                                var unitLabel = $"{unit.ProjectName ?? "Project"} / Unit {unit.UnitNumber} / {statusLabel}";
                                var packedValue = string.Join(':',
                                    customer.CustomerId, unit.LeadId, unit.UnitId, unit.ProjectId,
                                    Uri.EscapeDataString(customerName ?? string.Empty),
                                    Uri.EscapeDataString(unit.ProjectName ?? string.Empty),
                                    Uri.EscapeDataString(unit.UnitNumber ?? string.Empty));
                                <label class="checkbox-field">
                                    <input type="radio" name="selectedCrmBuyerUnit" value="@packedValue" required />
                                    @unitLabel
                                </label>
                            }
                        </div>
                        <button type="submit" class="btn btn-sm">Use this customer/unit</button>
                    </form>
                </div>
            }
            else if (Model.CrmBuyerAmbiguousMatch)
            {
                <div class="alert alert-info" role="status">
                    <span>Multiple CRM customer records were found for this phone number. Continue with manual verification.</span>
                </div>
            }
            else if (Model.CrmBuyerLookupUnavailable)
            {
                <div class="alert alert-info" role="status">
                    <span>Customer not found in CRM. CRM is temporarily unavailable — you can still continue creating the ticket; Project and Unit Number will be required.</span>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="status">
                    <span>Customer not found in CRM. You can still continue creating the ticket; Project and Unit Number will be required.</span>
                </div>
            }
            }

            @* PACT/Tasleeh results — straight from the department-aware lookup
               response, one card per participating source with its own
               Matched / Not found / Unavailable state. A failed source never
               hides another source's results and never blocks the wizard.
               The source's customer-type code is deliberately NOT rendered:
               PACT returns a raw numeric code whose table is not yet
               published, and a bare "1"/"2" would mislead as a label. *@
            @foreach (var source in Model.ExternalLookupSources)
            {
                var sourceLabel = TicketDisplay.LookupSourceLabel(source.Source);
                <div class="customer-card">
                    <div><strong>@sourceLabel</strong></div>
                    @if (source.Status == "Found")
                    {
                        @foreach (var externalCustomer in source.Customers)
                        {
                            <div><strong>@(externalCustomer.DisplayName ?? "(no name on file)")</strong></div>
                            <div class="text-secondary">
                                @(externalCustomer.PhoneNumber is null ? "" : externalCustomer.PhoneNumber)
                                @(externalCustomer.Email is null ? "" : $"· {externalCustomer.Email}")
                            </div>
                            @if (externalCustomer.Units.Count > 0)
                            {
                                <form method="post" asp-page-handler="UseExternalUnit">
                                    <input type="hidden" name="intakeRecordId" value="@Model.IntakeRecordId" />
                                    <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
                                    <input type="hidden" name="departmentId" value="@Model.DepartmentId" />
                                    <div class="unit-options">
                                        <p class="text-secondary">Select Unit — every unit/contract on file is listed; none is pre-selected.</p>
                                        @foreach (var unit in externalCustomer.Units)
                                        {
                                            var unitLabel = $"{unit.PropertyName ?? "Project"} / Unit {unit.UnitNumber ?? unit.ExternalUnitId}";
                                            var packedValue = string.Join(':',
                                                Uri.EscapeDataString(source.Source),
                                                Uri.EscapeDataString(externalCustomer.ExternalCustomerId),
                                                Uri.EscapeDataString(unit.ExternalUnitId),
                                                Uri.EscapeDataString(externalCustomer.DisplayName ?? string.Empty),
                                                Uri.EscapeDataString(unit.PropertyName ?? string.Empty),
                                                Uri.EscapeDataString(unit.UnitNumber ?? string.Empty));
                                            <label class="checkbox-field">
                                                <input type="radio" name="selectedExternalUnit" value="@packedValue" required />
                                                @unitLabel
                                            </label>
                                        }
                                    </div>
                                    <button type="submit" class="btn btn-sm">Use this customer/unit</button>
                                </form>
                            }
                            else
                            {
                                <p class="text-secondary">No units/contracts on file for this customer.</p>
                            }
                        }
                    }
                    else if (source.Status == "NotFound")
                    {
                        <div class="alert alert-info" role="status">
                            <span>No match found in @sourceLabel.</span>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="status">
                            <span>@sourceLabel is temporarily unavailable — you can still continue creating the ticket; this does not block anything.</span>
                        </div>
                    }
                </div>
            }

            <form method="post" asp-page-handler="ContinueWithoutMatch">
                <input type="hidden" name="intakeRecordId" value="@Model.IntakeRecordId" />
                <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
                <input type="hidden" name="departmentId" value="@Model.DepartmentId" />
                <button type="submit" class="btn">Continue to Ticket</button>
            </form>
        }
        else if (Model.Step == "create")
        {
            <div class="section-card__title">Step 3 — Ticket details</div>

            <div class="customer-card">
                <div><strong>Phone</strong></div>
                <div class="text-secondary">@(Model.PhoneNumber ?? "—")</div>

                @if (Model.CrmBuyerUnitId is not null)
                {
                    <div><strong>Customer (CRM verified)</strong></div>
                    <div class="text-secondary">@(Model.CrmBuyerCustomerName ?? "(no name on file)")</div>
                    <div><strong>Unit</strong></div>
                    <div class="text-secondary">@(Model.CrmBuyerProjectName ?? "Project") / Unit @Model.CrmBuyerUnitNumber</div>
                }
                else if (Model.ExternalSelection is not null)
                {
                    @* A matched external customer IS verified — against that
                       source. What it lacks is a local reference id, so the
                       unit also persists via the manual Project/Unit fields
                       below, prefilled from the selection and still editable,
                       alongside the source/tenant/unit identity ticket
                       creation records. *@
                    <div><strong>Customer (verified via @TicketDisplay.LookupSourceLabel(Model.ExternalSource ?? "lookup"))</strong></div>
                    <div class="text-secondary">@(Model.ExternalCustomerName ?? "(no name on file)")</div>
                    <div><strong>Unit</strong></div>
                    <div class="text-secondary">@(Model.ExternalProjectName ?? "Project") / Unit @Model.ExternalUnitNumber</div>
                    <div class="text-secondary">Project and Unit Number below are prefilled from this selection — adjust them if needed.</div>
                }
                else
                {
                    <div><strong>Customer</strong></div>
                    <div class="text-secondary">Customer not found in CRM — Project and Unit Number below are required.</div>
                }

                <p>
                    <a class="btn btn-sm" asp-page="/NewTicket" asp-route-step="lookup"
                       asp-route-intakeRecordId="@Model.IntakeRecordId" asp-route-phoneNumber="@Model.PhoneNumber"
                       asp-route-departmentId="@Model.DepartmentId">Change customer/unit</a>
                </p>
            </div>

            @* Phase E — duplicate-ticket awareness: same verified customer
               identity + same selected unit, active tickets first, straight
               from the server-side history query. Advisory only — the
               creation form below stays available ("Continue with New
               Ticket"), and Reopen renders only from the server-computed
               ReopenPolicy flag, never re-derived here. One-line summaries
               only; full descriptions stay on Ticket Details. *@
            @if (Model.RelatedTickets is not null && Model.RelatedTickets.Tickets.Count > 0)
            {
                var related = Model.RelatedTickets;
                var viewerCanReopen = TicketActions.CanReopen(CurrentUser.FromPrincipal(User)?.Roles);
                var relatedNowUtc = DateTime.UtcNow;
                <aside class="related-tickets" aria-label="Related tickets found">
                    <div class="related-tickets__title">Related tickets found</div>
                    <p class="related-tickets__hint">This customer already has recent tickets for this unit. Check whether one of them covers the same issue before creating a new ticket.</p>
                    @foreach (var row in related.Tickets)
                    {
                        var isFinished = row.TicketStatus is "Resolved" or "Closed";
                        <div class="related-ticket-row">
                            <div class="related-ticket-row__main">
                                <a class="ticket-id-link" href="/Tickets/@row.TicketId">@row.TicketNumber</a>
                                <span class="cell-truncate">@(string.IsNullOrWhiteSpace(row.RequestSummary) ? "—" : row.RequestSummary)</span>
                            </div>
                            <div class="related-ticket-row__meta">
                                @if (!string.IsNullOrWhiteSpace(row.UnitNumber))
                                {
                                    <span>Unit @row.UnitNumber</span>
                                }
                                <span class="badge badge-status-@TicketDisplay.TicketStatusCssKey(row.TicketStatus)"><span class="badge-dot"></span>@TicketDisplay.TicketStatusLabel(row.TicketStatus)</span>
                                <span class="badge badge-priority-@TicketDisplay.PriorityCssKey(row.PriorityId)">@TicketDisplay.PriorityLabel(row.PriorityId)</span>
                                <span>
                                    @(row.ResolvedAtUtc is DateTime resolvedAt
                                        ? $"Resolved {TicketDisplay.FormatDuration(relatedNowUtc - resolvedAt)} ago"
                                        : $"Created {row.CreatedAtUtc.ToLocalTime():d MMM yyyy}")
                                </span>
                            </div>
                            <div class="related-ticket-row__actions">
                                <a class="btn btn-sm" href="/Tickets/@row.TicketId">@(isFinished ? "View" : "Open")</a>
                                @if (row.IsReopenEligible && viewerCanReopen)
                                {
                                    <a class="btn btn-sm" href="/Tickets/@row.TicketId?reopen=1">Reopen</a>
                                }
                            </div>
                        </div>
                    }
                    <p class="related-tickets__continue">
                        <a class="btn btn-gold btn-sm" href="#new-ticket-form">Continue with New Ticket</a>
                    </p>
                </aside>
            }

            @if (Model.CrmBuyerCustomerId is not null)
            {
                <details class="disclosure">
                    <summary class="btn btn-sm">Previous Tickets@(Model.PreviousTickets is not null ? $" ({Model.PreviousTickets.TotalTickets})" : "")</summary>
                    <div class="disclosure__panel">
                        @if (Model.PreviousTickets is null)
                        {
                            <p class="text-secondary">Previous ticket history is unavailable right now.</p>
                        }
                        else if (Model.PreviousTickets.Tickets.Count == 0)
                        {
                            <p class="text-secondary">No previous tickets found for this customer.</p>
                        }
                        else
                        {
                            <p class="text-secondary">
                                Total: @Model.PreviousTickets.TotalTickets ·
                                Open: @Model.PreviousTickets.OpenTickets ·
                                Closed: @Model.PreviousTickets.ClosedTickets
                            </p>
                            <div class="entry-list">
                                @foreach (var row in Model.PreviousTickets.Tickets)
                                {
                                    <div class="entry-row">
                                        <span class="entry-row__field">
                                            <a href="/Tickets/@row.TicketId">@row.TicketNumber</a>
                                            — @(row.ProjectName ?? "—") / @(row.UnitNumber ?? "—")
                                        </span>
                                        <span class="text-secondary">@TicketDisplay.TicketStatusLabel(row.TicketStatus) · @row.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </details>
            }

            @if (Model.CategoriesErrorMessage is not null)
            {
                <div class="alert alert-error" role="alert">
                    <span>@Model.CategoriesErrorMessage</span>
                </div>
                <p>
                    <a class="btn btn-sm" asp-page="/NewTicket"
                       asp-route-step="create" asp-route-intakeRecordId="@Model.IntakeRecordId" asp-route-phoneNumber="@Model.PhoneNumber"
                       asp-route-departmentId="@Model.DepartmentId" asp-route-crmBuyerCustomerId="@Model.CrmBuyerCustomerId"
                       asp-route-crmBuyerLeadId="@Model.CrmBuyerLeadId" asp-route-crmBuyerUnitId="@Model.CrmBuyerUnitId"
                       asp-route-crmBuyerProjectId="@Model.CrmBuyerProjectId" asp-route-crmBuyerCustomerName="@Model.CrmBuyerCustomerName"
                       asp-route-crmBuyerProjectName="@Model.CrmBuyerProjectName" asp-route-crmBuyerUnitNumber="@Model.CrmBuyerUnitNumber">Retry</a>
                </p>
            }
            else if (Model.Categories.Count == 0)
            {
                <div class="alert alert-info" role="status">
                    <span>No active categories are configured for this department.</span>
                </div>
            }
            else
            {
                <form method="post" asp-page-handler="Create" id="new-ticket-form">
                    <input type="hidden" name="intakeRecordId" value="@Model.IntakeRecordId" />
                    <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
                    <input type="hidden" name="departmentId" value="@Model.DepartmentId" />
                    <input type="hidden" name="crmBuyerCustomerId" value="@Model.CrmBuyerCustomerId" />
                    <input type="hidden" name="crmBuyerLeadId" value="@Model.CrmBuyerLeadId" />
                    <input type="hidden" name="crmBuyerUnitId" value="@Model.CrmBuyerUnitId" />
                    <input type="hidden" name="crmBuyerProjectId" value="@Model.CrmBuyerProjectId" />
                    <input type="hidden" name="crmBuyerCustomerName" value="@Model.CrmBuyerCustomerName" />
                    <input type="hidden" name="crmBuyerProjectName" value="@Model.CrmBuyerProjectName" />
                    <input type="hidden" name="crmBuyerUnitNumber" value="@Model.CrmBuyerUnitNumber" />
                    <input type="hidden" name="externalSelection" value="@Model.ExternalSelection" />

                    @if (Model.CrmBuyerUnitId is null)
                    {
                        <div class="form-group">
                            <label class="form-label" asp-for="CreateStep.ManualProjectName">Project *</label>
                            <input class="form-control" asp-for="CreateStep.ManualProjectName" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="CreateStep.ManualUnitNumber">Unit Number *</label>
                            <input class="form-control" asp-for="CreateStep.ManualUnitNumber" required />
                        </div>
                    }

                    <div class="form-group">
                        <label class="form-label" asp-for="CreateStep.CategoryId">Category *</label>
                        <select class="form-control" asp-for="CreateStep.CategoryId" required>
                            <option value="">Select Category</option>
                            @foreach (var group in Model.Categories.GroupBy(c => c.DepartmentName))
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var category in group)
                                    {
                                        <option value="@category.CategoryId">@category.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="CreateStep.PriorityId">Priority *</label>
                        <select class="form-control" asp-for="CreateStep.PriorityId" required>
                            <option value="">Select Priority</option>
                            @for (byte p = 1; p <= 4; p++)
                            {
                                <option value="@p">@TicketDisplay.PriorityLabel(p)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="CreateStep.RequestSummary">Request Summary *</label>
                        <textarea class="form-control" asp-for="CreateStep.RequestSummary" rows="3" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-gold">Create ticket</button>
                </form>
            }
        }
    </div>
</div>
