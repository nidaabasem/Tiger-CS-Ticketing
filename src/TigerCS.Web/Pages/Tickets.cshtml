@page "/Tickets"
@model TigerCS.Web.Pages.TicketsModel
@{
    // One workspace, four views. The primary navigation has a single
    // "Tickets" item; Queue / Pending Interactions / My Tickets / Closed are
    // the tabs below, each a bookmarkable ?view= of this same page.
    ViewData["Title"] = Model.View == TicketsView.Queue ? "Tickets" : $"{Model.View.Label()} · Tickets";
    ViewData["ActiveNav"] = "tickets";
    Layout = "_Layout";
}

<div class="page tickets-workspace">
    <div class="page-header">
        <div>
            <h1 class="page-title">Tickets</h1>
            <p class="page-subtitle text-secondary">
                @(Model.View switch
                {
                    TicketsView.Pending => "Customer interactions waiting for a human agent — on every channel. Genesys still delivers the reply; this list is what is waiting and who is on it.",
                    TicketsView.My => "Tickets assigned to you, in every status.",
                    TicketsView.Closed => "Tickets that have been closed.",
                    _ => "Every ticket you can see, across your departments."
                })
            </p>
        </div>
        @if (Model.CanCreateTicket)
        {
            <a class="btn btn-gold" href="/NewTicket">+ New Ticket</a>
        }
    </div>

    <section class="kpi-grid" aria-label="Ticket status counters">
        <div class="kpi-card kpi-card--attention">
            <strong>@(Model.OpenCount?.ToString() ?? "—")</strong>
            <span>Open</span>
        </div>
        <div class="kpi-card">
            <strong>@(Model.InProgressCount?.ToString() ?? "—")</strong>
            <span>In Progress</span>
        </div>
        <div class="kpi-card">
            <strong>@(Model.PendingCustomerCount?.ToString() ?? "—")</strong>
            <span>Pending Customer</span>
        </div>
        <div class="kpi-card">
            <strong>@(Model.ClosedCount?.ToString() ?? "—")</strong>
            <span>Closed</span>
        </div>
    </section>

    <nav class="view-tabs" aria-label="Ticket views">
        <ul class="view-tabs__list">
            @foreach (var view in TicketsViews.All)
            {
                var isActive = view == Model.View;
                var count = Model.TabCount(view);
                <li>
                    <a class="view-tabs__link @(isActive ? "is-active" : "")" href="@view.Href()" aria-current="@(isActive ? "page" : null)">
                        @view.Label()
                        @if (count is not null)
                        {
                            <span class="view-tabs__count" aria-label="@count @view.Label()">@count</span>
                        }
                    </a>
                </li>
            }
        </ul>
    </nav>

    @if (Model.View == TicketsView.Pending)
    {
        @await Html.PartialAsync("_PendingInteractionsView", Model)
    }
    else
    {
        @await Html.PartialAsync("_TicketListView", Model)
    }
</div>
