@using TigerCS.Application.Modules.Administration.Dto
@* The live-checked password rules, built from Identity's configured policy.
   Model: (policy, element id). Checked in the browser by site.js; the Api stays the authority. *@
@model (PasswordPolicyDto Policy, string Id)
<ul class="password-rules" id="@Model.Id" data-password-rules aria-live="polite">
    <li data-rule="length" data-min="@Model.Policy.RequiredLength">At least @Model.Policy.RequiredLength characters</li>
    @if (Model.Policy.RequireUppercase) { <li data-rule="upper">An uppercase letter (A–Z)</li> }
    @if (Model.Policy.RequireLowercase) { <li data-rule="lower">A lowercase letter (a–z)</li> }
    @if (Model.Policy.RequireDigit) { <li data-rule="digit">A number (0–9)</li> }
    @if (Model.Policy.RequireNonAlphanumeric) { <li data-rule="symbol">A special character (for example ! @@ # $ %)</li> }
    @if (Model.Policy.RequiredUniqueChars > 1) { <li data-rule="unique" data-min="@Model.Policy.RequiredUniqueChars">At least @Model.Policy.RequiredUniqueChars different characters</li> }
</ul>
