@page "/Admin"
@model TigerCS.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Administration";
    ViewData["ActiveNav"] = "admin";
    ViewData["AdminSection"] = "overview";
    Layout = "_Layout";
}

<div class="page admin-page">
    <div class="page-header">
        <div>
            <p class="page-eyebrow">Management console</p>
            <h1 class="page-title">Administration</h1>
            <p class="page-subtitle">System configuration for Customer Service management. Every change here is recorded in the audit trail.</p>
        </div>
    </div>

    @await Html.PartialAsync("_AdminMessages", Model)

    <section class="admin-cards" aria-label="Administration areas">
        @foreach (var card in Model.Cards)
        {
            <a class="admin-card" href="@card.Href">
                <span class="admin-card__top">
                    <span class="admin-card__icon">@await Html.PartialAsync("_AdminIcon", card.Icon)</span>
                    <span class="admin-card__count">
                        <strong>@(card.Count?.ToString() ?? "—")</strong>
                        <span>@card.CountLabel</span>
                    </span>
                </span>
                <span class="admin-card__title">@card.Title</span>
                <span class="admin-card__desc">@card.Description</span>
                <span class="admin-card__footer">
                    <span>@(card.Count is null ? "Count unavailable right now" : "Open to add, edit or deactivate")</span>
                    <span class="btn btn-sm admin-card__cta">Manage @await Html.PartialAsync("_AdminIcon", "arrow-right")</span>
                </span>
            </a>
        }
    </section>
</div>
