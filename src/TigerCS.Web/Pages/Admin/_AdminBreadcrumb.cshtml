@model (string Section, string SectionHref, string? Current)
<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/Admin">Administration</a>
    <span class="sep">/</span>
    @if (Model.Current is null)
    {
        <span class="current">@Model.Section</span>
    }
    else
    {
        <a href="@Model.SectionHref">@Model.Section</a>
        <span class="sep">/</span>
        <span class="current">@Model.Current</span>
    }
</nav>
