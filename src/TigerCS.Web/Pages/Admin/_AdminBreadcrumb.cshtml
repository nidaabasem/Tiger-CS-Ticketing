@model (string Section, string SectionHref, string? Current)
<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/Admin">Administration</a>
    <span aria-hidden="true">›</span>
    @if (Model.Current is null)
    {
        <span>@Model.Section</span>
    }
    else
    {
        <a href="@Model.SectionHref">@Model.Section</a>
        <span aria-hidden="true">›</span>
        <span>@Model.Current</span>
    }
</nav>
