@page "/Admin/Workflows"
@model TigerCS.Web.Pages.Admin.WorkflowsModel
@{
    ViewData["Title"] = "Workflows";
    ViewData["ActiveNav"] = "admin";
    Layout = "_Layout";
}

<div class="page">
    @await Html.PartialAsync("_AdminBreadcrumb", ("Workflows", "/Admin/Workflows", (string?)null))
    <div class="page-header">
        <div>
            <h1 class="page-title">Workflows</h1>
            <p class="page-subtitle">Each workflow is versioned. Only a Draft can be edited; a published version is read-only and existing tickets keep the version they started on.</p>
        </div>
    </div>

    @await Html.PartialAsync("_AdminMessages", Model)

    <div class="admin-grid admin-grid--list-form">
        <div class="panel">
            <div class="panel__header">
                <h2 class="panel__title">All workflows</h2>
                <a class="btn btn-sm" href="/Admin/Workflows?includeInactive=@(Model.IncludeInactive ? "false" : "true")">@(Model.IncludeInactive ? "Hide inactive" : "Show inactive")</a>
            </div>
            @if (Model.LoadError is not null)
            {
                <div class="error-state"><p>@Model.LoadError</p></div>
            }
            else if (Model.Workflows.Count == 0)
            {
                <div class="empty-state"><p>No workflows yet. Create the first one on the right.</p></div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>Workflow</th><th>Active version</th><th>Draft</th><th>Versions</th><th>Request types</th><th>Tickets</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var w in Model.Workflows)
                            {
                                <tr>
                                    <td>
                                        <a class="ticket-id-link" href="/Admin/Workflows/@w.WorkflowId">@w.Name</a>
                                        @if (!string.IsNullOrEmpty(w.Description))
                                        {
                                            <div class="text-secondary">@w.Description</div>
                                        }
                                    </td>
                                    <td>
                                        @if (w.ActiveVersionNumber is { } av)
                                        {
                                            <a class="badge badge-version-published" href="/Admin/Workflows/Versions/@w.ActiveVersionId">V@(av) Active</a>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">None</span>
                                        }
                                    </td>
                                    <td>
                                        @if (w.DraftVersionNumber is { } dv)
                                        {
                                            <a class="badge badge-version-draft" href="/Admin/Workflows/Versions/@w.DraftVersionId">V@(dv) Draft</a>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">—</span>
                                        }
                                    </td>
                                    <td>@w.VersionCount</td>
                                    <td>@w.RequestTypeCount</td>
                                    <td>@w.TicketCount</td>
                                    <td>
                                        @if (w.IsActive)
                                        {
                                            <span class="badge badge-active"><span class="badge-dot"></span>Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-inactive"><span class="badge-dot"></span>Inactive</span>
                                        }
                                    </td>
                                    <td><a class="btn btn-sm" href="/Admin/Workflows/@w.WorkflowId">Versions</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <section class="panel admin-form-panel">
            <div class="panel__header"><h2 class="panel__title">Create workflow</h2></div>
            <form method="post" asp-page-handler="Create" class="admin-form">
                <div class="form-group">
                    <label class="form-label" asp-for="Create.Name">Name *</label>
                    <input class="form-control" asp-for="Create.Name" placeholder="e.g. Send Receipts Workflow" />
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Create.Description">Description</label>
                    <textarea class="form-control" asp-for="Create.Description" rows="3"></textarea>
                </div>
                <p class="field-hint">A Draft V1 with the standard steps (Start, Department Queue, Department Work, Resolve, Close) is created for you to adjust.</p>
                <div class="action-form__footer"><button type="submit" class="btn btn-gold btn-sm">Create Workflow</button></div>
            </form>
        </section>
    </div>
</div>
