@page "/Admin/Workflows"
@model TigerCS.Web.Pages.Admin.WorkflowsModel
@{
    ViewData["Title"] = "Workflows";
    ViewData["ActiveNav"] = "admin";
    ViewData["AdminSection"] = "workflows";
    Layout = "_Layout";
    var module = AdminModules.Workflows;
    var activeCount = Model.Workflows.Count(w => w.IsActive);
    var drafts = Model.Workflows.Count(w => w.DraftVersionId is not null);
}

<div class="page admin-page @module.Tone">
    @await Html.PartialAsync("_AdminCrumbs", (module.Key, (string?)null))

    <header class="admin-head">
        <div class="admin-head__main">
            @await Html.PartialAsync("_AdminEyebrow", module.Key)
            <h1 class="page-title">Workflows</h1>
            <p class="page-subtitle">The versioned step sequences request types follow. Only a Draft can be edited; a published version is read-only, and every ticket keeps the version it started on.</p>
            <div class="admin-head__meta">
                <span><strong>@activeCount</strong> active</span>
                <span><strong>@drafts</strong> @(drafts == 1 ? "draft in progress" : "drafts in progress")</span>
            </div>
        </div>
        <div class="admin-head__actions">
            <a class="btn btn-gold" href="#create-workflow">@await Html.PartialAsync("_AdminIcon", "plus") Create Workflow</a>
        </div>
    </header>

    @await Html.PartialAsync("_AdminMessages", Model)

    <div class="admin-grid admin-grid--list-form">
        <div>
            <form class="filter-bar" method="get" aria-label="Filter workflows">
                <div class="field-group">
                    <label class="field-label" for="includeInactive">Show</label>
                    <select class="field-select" id="includeInactive" name="includeInactive" data-autosubmit>
                        <option value="true" selected="@Model.IncludeInactive">All workflows</option>
                        <option value="false" selected="@(!Model.IncludeInactive)">Active only</option>
                    </select>
                </div>
                @if (Model.LoadError is null)
                {
                    <span class="filter-bar__count">@Model.Workflows.Count shown · @activeCount active</span>
                }
                <div class="filter-bar__submit"><button type="submit" class="btn btn-sm">Apply</button></div>
            </form>

            @if (Model.LoadError is not null)
            {
                <div class="panel">
                    <div class="error-state">
                        @await Html.PartialAsync("_AdminIcon", "warning")
                        <p>@Model.LoadError</p>
                    </div>
                </div>
            }
            else if (Model.Workflows.Count == 0)
            {
                <div class="panel">
                    <div class="empty-state">
                        @await Html.PartialAsync("_AdminIcon", "workflows")
                        <p class="empty-state__title">@(Model.IncludeInactive ? "No workflows yet" : "No active workflows")</p>
                        <p>@(Model.IncludeInactive ? "Create the first workflow using the form. It starts as Draft V1 with the standard steps." : "Show all workflows to see inactive ones.")</p>
                        @if (Model.IncludeInactive)
                        {
                            <a class="btn btn-sm btn-gold" href="#create-workflow">Create Workflow</a>
                        }
                        else
                        {
                            <a class="btn btn-sm" href="/Admin/Workflows">Show all workflows</a>
                        }
                    </div>
                </div>
            }
            else
            {
                @* A workflow is a versioned object, not a configuration row: each
                   one reads as a card whose left rail states which version is live. *@
                <ul class="wf-list">
                    @foreach (var w in Model.Workflows)
                    {
                        <li class="wf-item @(w.IsActive ? "" : "wf-item--inactive")">
                            <div class="wf-item__rail">
                                <span class="wf-item__rail-label">Active version</span>
                                @if (w.ActiveVersionNumber is { } av)
                                {
                                    <a href="/Admin/Workflows/Versions/@w.ActiveVersionId" aria-label="View active version @av of @w.Name">@await Html.PartialAsync("_VersionBadge", (av, WorkflowVersionStatus.Published))</a>
                                }
                                else
                                {
                                    <span class="badge badge-warning">None published</span>
                                }
                                @if (w.DraftVersionNumber is { } dv)
                                {
                                    <a href="/Admin/Workflows/Versions/@w.DraftVersionId" aria-label="Edit draft version @dv of @w.Name">@await Html.PartialAsync("_VersionBadge", (dv, WorkflowVersionStatus.Draft))</a>
                                }
                            </div>
                            <div class="wf-item__body">
                                <h2 class="wf-item__name">
                                    <a href="/Admin/Workflows/@w.WorkflowId">@w.Name</a>
                                    @await Html.PartialAsync("_StatusBadge", w.IsActive)
                                </h2>
                                @if (!string.IsNullOrEmpty(w.Description))
                                {
                                    <p class="wf-item__desc">@w.Description</p>
                                }
                                <div class="wf-item__meta">
                                    <span><strong>@w.VersionCount</strong> @(w.VersionCount == 1 ? "version" : "versions")</span>
                                    <span><strong>@w.RequestTypeCount</strong> @(w.RequestTypeCount == 1 ? "request type" : "request types")</span>
                                    <span><strong>@w.TicketCount</strong> @(w.TicketCount == 1 ? "ticket" : "tickets")</span>
                                </div>
                            </div>
                            <div class="wf-item__actions">
                                @if (w.DraftVersionId is { } draftId)
                                {
                                    <a class="btn btn-sm btn-gold" href="/Admin/Workflows/Versions/@draftId">@await Html.PartialAsync("_AdminIcon", "edit") Edit Draft</a>
                                }
                                <a class="btn btn-sm" href="/Admin/Workflows/@w.WorkflowId">@await Html.PartialAsync("_AdminIcon", "layers") Versions</a>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>

        <aside class="admin-side" id="workflows-side">
            @* A disclosure the page header's own "Create Workflow" button opens,
               through :target — no script, and the form, its handler and its
               fields are unchanged. A failed create re-renders it open so
               nothing the viewer typed is hidden behind a closed panel. *@
            <section class="panel panel--reveal admin-form-panel @(Model.ErrorMessage is null ? "" : "is-open")" id="create-workflow" aria-labelledby="create-workflow-title">
                <a class="panel__reveal-toggle" href="#create-workflow">
                    <span class="panel__reveal-icon">@await Html.PartialAsync("_AdminIcon", "plus")</span>
                    <span class="panel__reveal-text">
                        <span class="panel__title" id="create-workflow-title">Create workflow</span>
                        <span class="panel__hint">Starts a Draft V1 with the standard steps</span>
                    </span>
                    <span class="panel__reveal-caret" aria-hidden="true">@await Html.PartialAsync("_AdminIcon", "chevron-right")</span>
                </a>
                <div class="panel__reveal-body">
                    <form method="post" asp-page-handler="Create" class="admin-form">
                        <div class="form-group">
                            <label class="form-label" asp-for="Create.Name">Name *</label>
                            <input class="form-control" asp-for="Create.Name" required aria-required="true" placeholder="e.g. Send Receipts Workflow" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="Create.Description">Description</label>
                            <textarea class="form-control" asp-for="Create.Description" rows="3" placeholder="What this workflow is for, in one or two sentences."></textarea>
                            <span class="field-hint">The standard steps (Start, Department Queue, Department Work, Resolve, Close) are created for you to adjust.</span>
                        </div>
                        <div class="form-actions">
                            <a class="btn btn-sm" href="#workflows-side">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm">Create Workflow</button>
                        </div>
                    </form>
                </div>
            </section>

            <section class="panel panel--muted">
                <div class="panel__header"><h2 class="panel__title">Versioning</h2></div>
                <div class="panel__note panel__note--top">
                    <p>A workflow always has at most one Draft. Publishing it makes it the Active version for new tickets and turns the previous Active version Historical.</p>
                    <p>Tickets already in flight keep the version they were created on — publishing never changes them.</p>
                </div>
            </section>
        </aside>
    </div>
</div>
