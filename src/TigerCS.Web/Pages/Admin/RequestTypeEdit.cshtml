@page "/Admin/RequestTypes/{id?}"
@using TigerCS.Domain.Modules.SlaAndEscalation
@model TigerCS.Web.Pages.Admin.RequestTypeEditModel
@{
    var r = Model.RequestType;
    ViewData["Title"] = Model.IsNew ? "Add Request Type" : r?.Name ?? "Request Type";
    ViewData["ActiveNav"] = "admin";
    ViewData["AdminSection"] = "requesttypes";
    Layout = "_Layout";
    var priorities = new byte[] { 1, 2, 3, 4 };
}

<div class="page admin-page">
    @await Html.PartialAsync("_AdminBreadcrumb", ("Request Types", "/Admin/RequestTypes", Model.IsNew ? "Add Request Type" : r?.Name ?? "Request Type"))

    @if (!Model.IsNew && r is null)
    {
        <div class="panel">
            <div class="error-state">
                @await Html.PartialAsync("_AdminIcon", "warning")
                <p>@(Model.LoadError ?? "The request type could not be loaded.")</p>
            </div>
        </div>
        return;
    }

    <div class="page-header">
        <div>
            <p class="page-eyebrow">Request type</p>
            <h1 class="page-title">@(Model.IsNew ? "Add Request Type" : r!.Name)</h1>
            @if (r is not null)
            {
                <div class="page-title__meta">
                    <span>Department <strong>@r.DepartmentName</strong></span>
                    @await Html.PartialAsync("_StatusBadge", r.IsActive)
                    <span><strong>@r.TicketCount</strong> @(r.TicketCount == 1 ? "ticket" : "tickets")</span>
                    <span>Workflow <strong>@r.Workflow.WorkflowName</strong></span>
                    @if (r.Workflow.ActiveVersionNumber is { } headAv)
                    {
                        @await Html.PartialAsync("_VersionBadge", (headAv, WorkflowVersionStatus.Published))
                    }
                    else
                    {
                        <span class="badge badge-warning">No published version</span>
                    }
                </div>
            }
            else
            {
                <p class="page-subtitle">A request type belongs to one responsible department and follows one workflow's currently published version.</p>
            }
        </div>
        <div class="page-header__actions">
            <a class="btn" href="/Admin/RequestTypes">@(Model.IsNew ? "Cancel" : "Back to Request Types")</a>
        </div>
    </div>

    @await Html.PartialAsync("_AdminMessages", Model)

    @if (Model.IsNew)
    {
        <div class="admin-grid admin-grid--list-form">
            <section class="panel admin-form-panel" aria-labelledby="details-title">
                <div class="panel__header"><h2 class="panel__title" id="details-title">New request type</h2></div>
                <form method="post" asp-page-handler="Create" class="admin-form">
                    <fieldset class="form-section">
                        <legend class="form-section__title">Basics</legend>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" asp-for="Details.Name">Name *</label>
                                <input class="form-control" asp-for="Details.Name" required aria-required="true" placeholder="e.g. Send Receipts" />
                                <span class="field-hint">Shown to agents when they open a ticket. Keep it short and specific.</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Details.DepartmentId">Department *</label>
                                <select class="form-control" asp-for="Details.DepartmentId">
                                    @foreach (var d in Model.Departments)
                                    {
                                        <option value="@d.DepartmentId">@d.Name</option>
                                    }
                                </select>
                                <span class="field-hint">The responsible department. It cannot change once tickets follow this type.</span>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="form-section">
                        <legend class="form-section__title">Workflow and priority</legend>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" asp-for="Details.WorkflowId">Workflow *</label>
                                <select class="form-control" asp-for="Details.WorkflowId">
                                    @foreach (var w in Model.Workflows)
                                    {
                                        <option value="@w.WorkflowId">@w.Name@(w.ActiveVersionNumber is { } v ? $" — Active V{v}" : " — no published version")</option>
                                    }
                                </select>
                                <span class="field-hint">New tickets are pinned to the workflow's active version at creation. Publishing a newer version never changes existing tickets.</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Details.DefaultPriorityId">Default priority *</label>
                                <select class="form-control" asp-for="Details.DefaultPriorityId">
                                    @foreach (var p in priorities)
                                    {
                                        <option value="@p">@RequestTypeEditModel.PriorityLabel(p)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="form-section">
                        <legend class="form-section__title">Agent options</legend>
                        <div class="checkbox-grid">
                            <label class="checkbox-field"><input type="checkbox" asp-for="Details.AllowAgentPriorityChange" /> Agent may change priority</label>
                            <label class="checkbox-field"><input type="checkbox" asp-for="Details.AllowPendingCustomer" /> Pending Customer allowed</label>
                            <label class="checkbox-field"><input type="checkbox" asp-for="Details.AllowPendingInternal" /> Pending Internal / Third Party allowed</label>
                            <label class="checkbox-field"><input type="checkbox" asp-for="Details.AllowReopen" /> Reopen allowed (the reopen policy still applies)</label>
                        </div>
                    </fieldset>

                    <div class="form-actions">
                        <a class="btn" href="/Admin/RequestTypes">Cancel</a>
                        <button type="submit" class="btn btn-gold">Create Request Type</button>
                    </div>
                </form>
            </section>

            <aside class="admin-side">
                <section class="panel panel--muted">
                    <div class="panel__header"><h2 class="panel__title">What comes next</h2></div>
                    <div class="panel__note panel__note--top"><p>After the request type exists you can configure its assignment rule, approval requirements and SLA values from its page.</p></div>
                    <div class="panel__note"><p>Urgency is a ticket priority, never a second request type.</p></div>
                </section>
            </aside>
        </div>
        return;
    }

    <div class="admin-grid admin-grid--list-form">
        <div class="admin-stack">
            <section class="panel admin-form-panel" aria-labelledby="details-title">
                <div class="panel__header"><h2 class="panel__title" id="details-title">Details</h2></div>
                <form method="post" asp-page-handler="Details" asp-route-id="@r!.RequestTypeId" class="admin-form">
                    <fieldset class="form-section">
                        <legend class="form-section__title">Basics</legend>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" asp-for="Details.Name">Name *</label>
                                <input class="form-control" asp-for="Details.Name" required aria-required="true" />
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Details.DepartmentId">Department *</label>
                                <select class="form-control" asp-for="Details.DepartmentId" disabled="@(r is { TicketCount: > 0 } ? "disabled" : null)">
                                    @foreach (var d in Model.Departments)
                                    {
                                        <option value="@d.DepartmentId">@d.Name</option>
                                    }
                                </select>
                                @if (r is { TicketCount: > 0 })
                                {
                                    <input type="hidden" asp-for="Details.DepartmentId" />
                                    <span class="field-hint">Tickets already follow this request type, so its department cannot change.</span>
                                }
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="form-section">
                        <legend class="form-section__title">Workflow and priority</legend>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" asp-for="Details.WorkflowId">Workflow *</label>
                                <select class="form-control" asp-for="Details.WorkflowId">
                                    @foreach (var w in Model.Workflows)
                                    {
                                        <option value="@w.WorkflowId">@w.Name@(w.ActiveVersionNumber is { } v ? $" — Active V{v}" : " — no published version")</option>
                                    }
                                </select>
                                <span class="field-hint">New tickets are pinned to the workflow's active version at creation. Publishing a newer version never changes existing tickets.</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Details.DefaultPriorityId">Default priority *</label>
                                <select class="form-control" asp-for="Details.DefaultPriorityId">
                                    @foreach (var p in priorities)
                                    {
                                        <option value="@p">@RequestTypeEditModel.PriorityLabel(p)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="form-section">
                        <legend class="form-section__title">Agent options</legend>
                        <div class="checkbox-grid">
                            <label class="checkbox-field"><input type="checkbox" asp-for="Details.AllowAgentPriorityChange" /> Agent may change priority</label>
                            <label class="checkbox-field"><input type="checkbox" asp-for="Details.AllowPendingCustomer" /> Pending Customer allowed</label>
                            <label class="checkbox-field"><input type="checkbox" asp-for="Details.AllowPendingInternal" /> Pending Internal / Third Party allowed</label>
                            <label class="checkbox-field"><input type="checkbox" asp-for="Details.AllowReopen" /> Reopen allowed (the reopen policy still applies)</label>
                        </div>
                    </fieldset>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-gold btn-sm">Save Details</button>
                    </div>
                </form>
            </section>

            <section class="panel admin-form-panel" aria-labelledby="assignment-title">
                <div class="panel__header">
                    <h2 class="panel__title" id="assignment-title">Assignment</h2>
                    <span class="text-secondary">Current: <strong>@(r.AssignmentRule is null ? $"{r.DepartmentName} Queue (no rule configured)" : r.AssignmentRule.Mode switch { AssignmentMode.SpecificEmployee => r.AssignmentRule.PrimaryEmployeeName, AssignmentMode.Team => $"{r.AssignmentRule.TeamName ?? "Team"} — primary {r.AssignmentRule.PrimaryEmployeeName}", _ => $"{r.DepartmentName} Queue" })</strong></span>
                </div>
                <form method="post" asp-page-handler="Assignment" asp-route-id="@r.RequestTypeId" class="admin-form">
                    <fieldset class="form-section">
                        <legend class="form-section__title">How new tickets are assigned</legend>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" asp-for="Assignment.Mode">Mode</label>
                                <select class="form-control" asp-for="Assignment.Mode">
                                    <option value="@AssignmentMode.DepartmentQueue">Department Queue (department head assigns)</option>
                                    <option value="@AssignmentMode.SpecificEmployee">Specific Employee</option>
                                    <option value="@AssignmentMode.Team">Team (one primary owner plus members)</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Assignment.PrimaryEmployeeId">Primary assignee</label>
                                <select class="form-control" asp-for="Assignment.PrimaryEmployeeId">
                                    <option value="">—</option>
                                    @foreach (var m in Model.DepartmentMembers)
                                    {
                                        <option value="@m.EmployeeId">@m.DisplayName</option>
                                    }
                                </select>
                                <span class="field-hint">Required for Specific Employee and Team. Only active members of @r.DepartmentName can be configured.</span>
                            </div>
                        </div>
                    </fieldset>
                    <fieldset class="form-section">
                        <legend class="form-section__title">Team settings <span class="text-secondary">(Team mode only)</span></legend>
                        <div class="form-group">
                            <label class="form-label" asp-for="Assignment.TeamName">Team name</label>
                            <input class="form-control" asp-for="Assignment.TeamName" placeholder="e.g. Collections Team A" />
                        </div>
                        <fieldset class="form-group">
                            <legend class="form-label">Team members</legend>
                            @if (Model.DepartmentMembers.Count == 0)
                            {
                                <span class="field-hint">@r.DepartmentName has no active members yet.</span>
                            }
                            else
                            {
                                <div class="checkbox-grid">
                                    @foreach (var m in Model.DepartmentMembers)
                                    {
                                        <label class="checkbox-field">
                                            <input type="checkbox" name="Assignment.MemberEmployeeIds" value="@m.EmployeeId" checked="@(Model.Assignment.MemberEmployeeIds.Contains(m.EmployeeId) ? "checked" : null)" />
                                            @m.DisplayName
                                        </label>
                                    }
                                </div>
                            }
                        </fieldset>
                    </fieldset>
                    <div class="form-actions"><button type="submit" class="btn btn-gold btn-sm">Save Assignment</button></div>
                </form>
            </section>

            <section class="panel admin-form-panel" aria-labelledby="approvals-title">
                <div class="panel__header"><h2 class="panel__title" id="approvals-title">Approval requirements <span class="panel__count">@r.ApprovalRequirements.Count</span></h2></div>
                @if (r.ApprovalRequirements.Count == 0)
                {
                    <div class="empty-state">
                        @await Html.PartialAsync("_AdminIcon", "check")
                        <p class="empty-state__title">No approval required</p>
                        <p>Tickets of this type proceed without a decision. Add a requirement below if one applies.</p>
                    </div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Approval type</th>
                                    <th>Decided by</th>
                                    <th>Work waits</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in r.ApprovalRequirements)
                                {
                                    <tr class="@(a.IsActive ? "" : "is-inactive")">
                                        <td class="cell-primary"><span class="badge badge-approval-type">@a.ApprovalTypeLabel</span></td>
                                        <td class="cell-wrap">
                                            @(a.TargetKind switch
                                            {
                                                ApprovalTargetKind.Department => $"{a.TargetDepartmentName ?? "Unknown department"}{(a.TargetRoleName is null ? "" : $" ({a.TargetRoleName})")}",
                                                ApprovalTargetKind.Role => $"Anyone holding {a.TargetRoleName}",
                                                _ => a.TargetEmployeeName ?? "Unknown user"
                                            })
                                        </td>
                                        <td>@(a.BlocksWorkUntilApproved ? "Yes — blocks work until approved" : "No")</td>
                                        <td>@await Html.PartialAsync("_StatusBadge", a.IsActive)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <form method="post" asp-page-handler="Approval" asp-route-id="@r.RequestTypeId" class="admin-form">
                    <fieldset class="form-section">
                        <legend class="form-section__title">Add or update a requirement</legend>
                        <p class="form-section__hint">Saving for an approval type that already exists replaces that requirement.</p>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" asp-for="Approval.ApprovalType">Approval type</label>
                                <select class="form-control" asp-for="Approval.ApprovalType">
                                    <option value="@ApprovalType.AccountingApproval">Accounting Approval</option>
                                    <option value="@ApprovalType.CustomerServiceApproval">Customer Service Approval</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Approval.TargetKind">Decided by</label>
                                <select class="form-control" asp-for="Approval.TargetKind">
                                    <option value="@ApprovalTargetKind.Department">A department</option>
                                    <option value="@ApprovalTargetKind.Role">Anyone holding a role</option>
                                    <option value="@ApprovalTargetKind.Employee">One employee</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row form-row--3">
                            <div class="form-group">
                                <label class="form-label" asp-for="Approval.TargetDepartmentId">Department</label>
                                <select class="form-control" asp-for="Approval.TargetDepartmentId">
                                    <option value="">—</option>
                                    @foreach (var d in Model.Departments)
                                    {
                                        <option value="@d.DepartmentId">@d.Name</option>
                                    }
                                </select>
                                <span class="field-hint">When decided by a department.</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Approval.TargetRoleName">Role</label>
                                <select class="form-control" asp-for="Approval.TargetRoleName">
                                    <option value="">—</option>
                                    @foreach (var role in RequestTypeEditModel.FixedRoles)
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </select>
                                <span class="field-hint">Required for a role; optional narrowing for a department.</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Approval.TargetEmployeeId">Employee</label>
                                <select class="form-control" asp-for="Approval.TargetEmployeeId">
                                    <option value="">—</option>
                                    @foreach (var u in Model.AllUsers)
                                    {
                                        <option value="@u.EmployeeId">@u.DisplayName</option>
                                    }
                                </select>
                                <span class="field-hint">When decided by one employee.</span>
                            </div>
                        </div>
                        <div class="checkbox-grid">
                            <label class="checkbox-field"><input type="checkbox" asp-for="Approval.BlocksWorkUntilApproved" /> Work waits for the decision</label>
                            <label class="checkbox-field"><input type="checkbox" asp-for="Approval.IsActive" /> Active</label>
                        </div>
                    </fieldset>
                    <div class="form-actions"><button type="submit" class="btn btn-gold btn-sm">Save Approval Requirement</button></div>
                </form>
            </section>

            <section class="panel admin-form-panel" aria-labelledby="sla-title">
                <div class="panel__header"><h2 class="panel__title" id="sla-title">SLA values <span class="panel__count">@r.SlaPolicies.Count</span></h2></div>
                <p class="panel__note panel__note--top">Durations are stored exactly as approved (e.g. 10–12 days). Whether a day is a business day, and whether Pending pauses the clock, remain pending business decisions — “Not decided” keeps them undecided.</p>
                @if (r.SlaPolicies.Count == 0)
                {
                    <div class="empty-state">
                        @await Html.PartialAsync("_AdminIcon", "inbox")
                        <p class="empty-state__title">No SLA values configured</p>
                        <p>Add one row per priority below.</p>
                    </div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Priority</th>
                                    <th>Clock starts</th>
                                    <th>First response</th>
                                    <th>Resolution</th>
                                    <th>Pauses on Pending Customer</th>
                                    <th>Pauses on Pending Internal</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in r.SlaPolicies)
                                {
                                    <tr class="@(s.IsActive ? "" : "is-inactive")">
                                        <td><span class="badge badge-priority-@TicketDisplay.PriorityCssKey(s.PriorityId)">@RequestTypeEditModel.PriorityLabel(s.PriorityId)</span></td>
                                        <td>@s.Trigger</td>
                                        <td>@(s.FirstResponseTargetValue is null ? "—" : $"{s.FirstResponseTargetValue}{(s.FirstResponseMaximumValue is { } frm ? $"–{frm}" : "")} {s.Unit}")</td>
                                        <td>@(s.IsImmediate ? "Immediately" : $"{s.ResolutionTargetValue}{(s.ResolutionMaximumValue is { } rm ? $"–{rm}" : "")} {s.Unit}")</td>
                                        <td>@(s.PausesOnPendingCustomer switch { true => "Yes", false => "No", _ => "Not decided" })</td>
                                        <td>@(s.PausesOnPendingInternal switch { true => "Yes", false => "No", _ => "Not decided" })</td>
                                        <td>@await Html.PartialAsync("_StatusBadge", s.IsActive)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <form method="post" asp-page-handler="Sla" asp-route-id="@r.RequestTypeId" class="admin-form">
                    <fieldset class="form-section">
                        <legend class="form-section__title">Applies to</legend>
                        <div class="form-row form-row--3">
                            <div class="form-group">
                                <label class="form-label" asp-for="Sla.PriorityId">Priority</label>
                                <select class="form-control" asp-for="Sla.PriorityId">
                                    @foreach (var p in priorities)
                                    {
                                        <option value="@p">@RequestTypeEditModel.PriorityLabel(p)</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Sla.Trigger">Clock starts</label>
                                <select class="form-control" asp-for="Sla.Trigger" asp-items="Html.GetEnumSelectList<SlaTriggerType>()"></select>
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Sla.Unit">Unit</label>
                                <select class="form-control" asp-for="Sla.Unit" asp-items="Html.GetEnumSelectList<SlaDurationUnit>()"></select>
                            </div>
                        </div>
                    </fieldset>
                    <fieldset class="form-section">
                        <legend class="form-section__title">Targets</legend>
                        <p class="form-section__hint">Leave a maximum empty for a single value; fill both for a range such as 10–12.</p>
                        <div class="form-row form-row--3">
                            <div class="form-group"><label class="form-label" asp-for="Sla.FirstResponseTargetValue">First response target</label><input class="form-control" type="number" min="1" asp-for="Sla.FirstResponseTargetValue" /></div>
                            <div class="form-group"><label class="form-label" asp-for="Sla.FirstResponseMaximumValue">First response maximum</label><input class="form-control" type="number" min="1" asp-for="Sla.FirstResponseMaximumValue" /></div>
                            <div class="form-group"><label class="form-label" asp-for="Sla.ResolutionTargetValue">Resolution target</label><input class="form-control" type="number" min="1" asp-for="Sla.ResolutionTargetValue" /></div>
                            <div class="form-group"><label class="form-label" asp-for="Sla.ResolutionMaximumValue">Resolution maximum</label><input class="form-control" type="number" min="1" asp-for="Sla.ResolutionMaximumValue" /></div>
                        </div>
                        <label class="checkbox-field"><input type="checkbox" asp-for="Sla.IsImmediate" /> Immediate (no resolution duration)</label>
                    </fieldset>
                    <fieldset class="form-section">
                        <legend class="form-section__title">Pauses and warning</legend>
                        <div class="form-row form-row--3">
                            <div class="form-group">
                                <label class="form-label" asp-for="Sla.PausesOnPendingCustomer">Pauses on Pending Customer</label>
                                <select class="form-control" asp-for="Sla.PausesOnPendingCustomer"><option value="">Not decided</option><option value="true">Yes</option><option value="false">No</option></select>
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Sla.PausesOnPendingInternal">Pauses on Pending Internal</label>
                                <select class="form-control" asp-for="Sla.PausesOnPendingInternal"><option value="">Not decided</option><option value="true">Yes</option><option value="false">No</option></select>
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Sla.WarningThresholdPercent">Warning threshold %</label>
                                <input class="form-control" type="number" min="1" max="100" step="0.01" asp-for="Sla.WarningThresholdPercent" />
                                <span class="field-hint">Share of the target after which the ticket is flagged as at risk.</span>
                            </div>
                        </div>
                        <label class="checkbox-field"><input type="checkbox" asp-for="Sla.IsActive" /> Active</label>
                    </fieldset>
                    <div class="form-actions"><button type="submit" class="btn btn-gold btn-sm">Save SLA Values</button></div>
                </form>
            </section>
        </div>

        <aside class="admin-side">
            <section class="panel admin-form-panel" aria-labelledby="workflow-title">
                <div class="panel__header"><h2 class="panel__title" id="workflow-title">Workflow</h2></div>
                <dl class="facts-panel">
                    <div class="facts-row"><dt>Workflow</dt><dd>@r.Workflow.WorkflowName</dd></div>
                    <div class="facts-row">
                        <dt>Active version</dt>
                        <dd>
                            @if (r.Workflow.ActiveVersionNumber is { } av)
                            {
                                @await Html.PartialAsync("_VersionBadge", (av, WorkflowVersionStatus.Published))
                            }
                            else
                            {
                                <span class="badge badge-warning">None published</span>
                                <div class="field-hint">Tickets of this type cannot be created until a version is published.</div>
                            }
                        </dd>
                    </div>
                    @if (r.Workflow.DraftVersionNumber is { } dv)
                    {
                        <div class="facts-row"><dt>Draft</dt><dd><a href="/Admin/Workflows/Versions/@r.Workflow.DraftVersionId" aria-label="Edit draft version @dv">@await Html.PartialAsync("_VersionBadge", (dv, WorkflowVersionStatus.Draft))</a></dd></div>
                    }
                    @if (r.Workflow.ApprovalTypesInActiveVersion.Count > 0)
                    {
                        <div class="facts-row"><dt>Approval steps</dt><dd>@string.Join(", ", r.Workflow.ApprovalTypesInActiveVersion.Select(ApprovalTypeLabels.Label))</dd></div>
                    }
                </dl>
                <div class="panel__actions">
                    @if (r.Workflow.ActiveVersionId is { } avId)
                    {
                        <a class="btn btn-sm" href="/Admin/Workflows/Versions/@avId">View Active</a>
                    }
                    <a class="btn btn-sm" href="/Admin/Workflows/@r.Workflow.WorkflowId">All Versions</a>
                    @if (r.Workflow.DraftVersionId is { } draftId)
                    {
                        <a class="btn btn-sm btn-gold" href="/Admin/Workflows/Versions/@draftId">Edit Draft</a>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="CreateVersion" asp-route-id="@r.RequestTypeId">
                            <button type="submit" class="btn btn-gold btn-sm">Create New Version</button>
                        </form>
                    }
                </div>
            </section>

            <section class="panel admin-form-panel @(r.IsActive ? "panel--danger" : "")" aria-labelledby="status-title">
                <div class="panel__header"><h2 class="panel__title" id="status-title">@(r.IsActive ? "Deactivate request type" : "Reactivate request type")</h2></div>
                <div class="panel__note panel__note--top">
                    <p>@(r.IsActive ? "An inactive request type is no longer offered on new tickets." : "Reactivating offers the request type on new tickets again.")</p>
                    @if (r.TicketCount > 0)
                    {
                        <p>@r.TicketCount @(r.TicketCount == 1 ? "ticket follows" : "tickets follow") this request type. It can be deactivated but never deleted; those tickets keep it.</p>
                    }
                </div>
                <form method="post" asp-page-handler="Activation" asp-route-id="@r.RequestTypeId" class="admin-form"
                      data-confirm="@(r.IsActive ? $"Deactivate '{r.Name}'? It will no longer be offered on new tickets." : null)">
                    <input type="hidden" asp-for="Activation.IsActive" value="@(r.IsActive ? "false" : "true")" />
                    @if (r.IsActive)
                    {
                        <div class="form-group">
                            <label class="form-label" asp-for="Activation.Reason">Reason</label>
                            <input class="form-control" asp-for="Activation.Reason" placeholder="Optional — recorded in the audit trail" />
                        </div>
                        <div class="form-actions"><button type="submit" class="btn btn-critical btn-sm">Deactivate Request Type</button></div>
                    }
                    else
                    {
                        <div class="form-actions"><button type="submit" class="btn btn-gold btn-sm">Reactivate Request Type</button></div>
                    }
                </form>
            </section>
        </aside>
    </div>
</div>
