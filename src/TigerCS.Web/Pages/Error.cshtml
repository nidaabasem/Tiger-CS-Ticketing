@page
@model ErrorModel
@{
    ViewData["Title"] = Model.Title;
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_LoginLayout";
}

<div class="@(User.Identity?.IsAuthenticated == true ? "" : "login__form")"
     style="@(User.Identity?.IsAuthenticated == true ? "" : "min-height:100vh;")">
    <div class="panel content--narrow" style="margin:0 auto;">
        <div class="state" role="alert">
            <div class="badge badge--neutral" style="font-size:0.72rem;">Error @Model.HttpStatus</div>
            <div class="state__title" style="margin-top:0.6rem;">@Model.Title</div>
            <p class="state__body">@Model.Message</p>
            <div class="actionbar" style="justify-content:center;">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn--primary" asp-page="/Tickets/Index">Back to the queue</a>
                }
                else
                {
                    <a class="btn btn--primary" asp-page="/Account/Login">Go to sign in</a>
                }
            </div>
            <p class="field__hint" style="margin-top:1.2rem;">
                Reference <code>@Model.CorrelationId</code>
            </p>
        </div>
    </div>
</div>
