@using TigerCS.Web.Pages.Collections
@using TigerCS.Web.Services.Api
@model CampaignsModel
@if (Model.LoadNotice is { } notice) { <div class="receivables-notice" role="status" data-load-notice>@notice</div> }
@if (Model.NothingDueYet)
{
    <div class="panel"><div class="empty-state"><p class="empty-state__title">Nothing is due in this period yet.</p></div></div>
}
else if (Model.Report is { } report)
{
    @* The financial snapshot status (load problems, CRM state, reconciliation) is its own region; it is part of this fragment only for the asynchronous reload, where
       collections-campaign-filters.js lifts it into the always-visible status box. *@
    if (!Model.RenderFull) { <partial name="_CampaignSnapshotStatus" model="Model" /> }
    <div hidden data-effective-filters data-from="@Model.DateFrom?.ToString("yyyy-MM-dd")" data-to="@report.DateTo?.ToString("yyyy-MM-dd")"></div>
    if (report.Snapshot is { NothingLoaded: true }) { <div class="panel"><p class="receivables-meta" data-nothing-loaded>No customers can be shown until the financial data has loaded. See the snapshot status above.</p></div> return; }
    <div class="panel" data-customer-results data-preview-current>
        <ul class="campaign-totals" data-campaign-totals>
            <li>Eligible customers: <strong data-eligible-count>@((report.TotalCount - report.NotEligibleCount).ToString("N0"))</strong> of @report.TotalCount.ToString("N0") listed</li>
            @if (report.EligibleTotalAmount is { } qualifying) { <li>Total qualifying amount: <strong data-eligible-total>@(report.Items.FirstOrDefault()?.Currency ?? "AED") @qualifying.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</strong> <span class="receivables-meta">(stage amount of the eligible customers, as sent to Genesys)</span></li> }
            @if (report.EligibleOutstandingAmount is { } outstanding) { <li>Outstanding balance of the eligible customers: <strong data-eligible-outstanding>@(report.Items.FirstOrDefault()?.Currency ?? "AED") @outstanding.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</strong></li> }
            <li>Payment status: <strong>@(report.PaymentStatus == "Both" ? "Due and Overdue" : report.PaymentStatus)</strong></li>
            @if (Model.CampaignName is { } campaignName) { <li>Genesys campaign name when sent: <strong data-campaign-name>@campaignName</strong></li> }
        </ul>
        @if (report.PaymentStatusNote is { } statusNote) { <p class="receivables-notice" role="status" data-payment-status-note>@statusNote</p> }
        @* Exports stay blocked for incomplete or stale data: the buttons only exist when every company is loaded, fresh and covers the dates (the API refuses anyway). *@
        @if (report.CanExportReview && report.Snapshot is not { IsReady: false })
        {
            <div class="campaign-actions">
                <a class="btn" href="@Model.PageUrl(export: "review")">Export review CSV</a>
                @if (report.ReadyCount > 0 && report.ReadyCount + report.NotEligibleCount == report.TotalCount)
                { <a class="btn btn-primary" href="@Model.PageUrl(export: "genesys")">Export Genesys CSV</a> }
            </div>
        }
        @{ var blocked = Model.ApproveBlockedReason; }
        <form method="post" class="campaign-approve" data-approve-form asp-page-handler="Approve">
            @foreach (var name in CampaignsModel.FilterFieldNames)
            {
                <input type="hidden" name="@name" value="@(name switch {
                    "stage" => Model.Stage, "businessDate" => Model.BusinessDate?.ToString("yyyy-MM-dd"), "dateFrom" => Model.DateFrom?.ToString("yyyy-MM-dd"), "dateTo" => Model.DateTo?.ToString("yyyy-MM-dd"),
                    "towerId" => Model.TowerId?.ToString(), "minTotal" => Model.MinTotalText, "paymentStatus" => Model.PaymentStatus, _ => Model.Search })" />
            }
            <input type="hidden" name="unitKeys" value="" data-selected-units />
            @if (report.ReadyCount > 0)
            {
                <label><input type="radio" name="selectionMode" value="SelectedUnits" checked /> Only the customers I ticked (<span data-selected-count>0</span>, kept across pages)</label>
                <label><input type="radio" name="selectionMode" value="AllMatching" data-all-matching /> All eligible customers matching the filters (<span data-all-count>@report.ReadyCount.ToString("N0")</span>, on every page)</label>
            }
            <button class="btn btn-primary" type="submit" data-approve-button disabled="@(blocked is not null)" data-blocked="@(blocked is not null ? "true" : "false")">Approve &amp; Send to Genesys</button>
            @if (report.ReadyCount > 0) { <button class="btn" type="button" data-clear-selection>Clear ticks</button> }
            <span class="receivables-meta" data-approve-reason role="status">@(blocked ?? "Only Ready customers can be sent. Nothing is sent until you confirm the exact count, amount and Genesys contact list.")</span>
        </form>
        <div class="table-scroll">
            <table class="table receivables-table campaigns-table">
                <thead><tr><th><input type="checkbox" data-select-page aria-label="Select all eligible customers on this page" /></th><th>Customer</th><th>Mobile</th><th>Email</th><th>Project / Tower</th><th>Unit</th><th class="num">Due</th><th class="num">Overdue</th><th class="num">Total</th></tr></thead>
                <tbody>
                @foreach (var row in report.Items)
                {
                    <tr data-campaign-status="@row.Status">
                        <td>@if (row.Status == "Ready") { <input type="checkbox" class="campaign-select" data-unit-key="@TigerCS.Application.Modules.Collections.Review.ReviewQueryService.UnitKey(row.CompanyId, row.TenantId, row.UnitCode)" aria-label="Select @row.CustomerName" /> }</td>
                        <td><strong>@row.CustomerName</strong>@foreach (var note in CampaignsModel.ReviewNotes(row, report.Crm?.State)) { <span class="receivables-meta receivables-meta--review" data-unit-note>@note</span> }@if (row.Status == "NotEligible") { <span class="receivables-meta" data-campaign-readiness>@CampaignsModel.Readiness(row)</span> }</td>
                        <td>@(row.Phone.Length > 0 ? row.Phone : "—")@if (row.Phone.Length == 0) { <span class="receivables-meta receivables-meta--missing" data-unit-note>@CampaignsModel.NoMobileNote(row)</span> }</td>
                        <td>@(row.Email.Length > 0 ? row.Email : "—")@if (row.Email.Length == 0) { <span class="receivables-meta receivables-meta--missing" data-unit-note>No email: email not possible</span> }</td>
                        <td>@CollectionsDisplay.TowerCell(row.TowerName, row.TowerNumber, row.ProjectCode)</td>
                        <td>@row.UnitCode</td>
                        <td class="num" data-unit-due>@CampaignsModel.MoneyOrDash(row.DueAmount)</td>
                        <td class="num" data-unit-overdue>@CampaignsModel.MoneyOrDash(row.OverdueAmount)</td>
                        <td class="num" data-unit-total>@CampaignsModel.MoneyOrDash(row.TotalAmount)</td>
                    </tr>
                }
                @if (report.TotalCount == 0)
                { <tr><td colspan="9">@(CollectionsDisplay.FailedCompanies(report.Snapshot) is null ? "No units qualify for these filters." : "No units to show yet.")</td></tr> }
                </tbody>
            </table>
        </div>
        <div class="receivables-pagination">
            <span>Page @report.Page of @Model.TotalPages · @(report.TotalCount == 1 ? "1 unit" : $"{report.TotalCount:N0} units")</span>
            <div>
                @if (report.Page > 1) { <a class="btn btn-sm" data-results-link href="@Model.PageUrl(report.Page - 1)">Previous</a> }
                @if (report.Page < Model.TotalPages) { <a class="btn btn-sm" data-results-link href="@Model.PageUrl(report.Page + 1)">Next</a> }
            </div>
        </div>
    </div>
}
else
{
    <div class="panel"><div class="error-state" role="alert" data-campaign-error>
        @if (Model.Outcome == ApiOutcome.Forbidden) { <p>Your account does not have permission for this Collections operation.</p> }
        else if (Model.Outcome == ApiOutcome.Unauthorized) { <p>Your session has expired. <a href="/Logout">Sign in again</a>.</p> }
        else if (Model.Outcome == ApiOutcome.ValidationError) { <p>@(Model.Error ?? "Choose valid filters and retry.")</p> }
        else { <p>@(Model.Error ?? "The campaign source is unavailable.")</p><button class="btn" type="button" data-results-retry>Retry</button> }
    </div></div>
}
