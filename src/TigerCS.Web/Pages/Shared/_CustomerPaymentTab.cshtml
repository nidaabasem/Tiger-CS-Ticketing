@using TigerCS.Web.Models
@model CustomerPaymentPanel
@{
    var panel = Model;
    var account = panel.SelectedAccount;
    var currency = account?.Currency ?? "";
    var baseHref = $"/Customers/{Uri.EscapeDataString(panel.CustomerKey)}?tab=payment";
    var showReminders = panel.CrmCustomerId is not null
        && panel.State is PaymentPanelState.Loaded or PaymentPanelState.Unavailable or PaymentPanelState.NoAccounts or PaymentPanelState.NotMapped;
    var warnIcon = "M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z";
}

<div class="payment-tab" data-payment-state="@panel.State" data-payment-account="@(account?.AccountId ?? panel.SelectedCompanyId?.ToString(System.Globalization.CultureInfo.InvariantCulture))">
    @if (!string.IsNullOrEmpty(panel.Notice))
    {
        <div class="alert @(panel.NoticeIsError ? "alert-error" : "alert-success")" role="@(panel.NoticeIsError ? "alert" : "status")">
            <span>@panel.Notice</span>
        </div>
    }

    @switch (panel.State)
    {
        case PaymentPanelState.Deferred:
            <div class="payment-loading" role="status" aria-live="polite">
                <span class="payment-spinner" aria-hidden="true"></span>
                <span>Loading payment details…</span>
                <a class="link-muted" href="@baseHref#payment" data-payment-fallback>Load payment details</a>
            </div>
            break;

        case PaymentPanelState.NotCrmCustomer:
            <div class="empty-state"><p>Payment information is available only for customers identified in Tiger CRM or PACT.</p></div>
            break;

        case PaymentPanelState.NotMapped:
            <div class="alert alert-info" role="status" data-payment-not-mapped>
                <span><strong>No payment figures for this customer.</strong></span>
            </div>
            break;

        case PaymentPanelState.EdsmSummary:
            <partial name="_EdsmPaymentSummary" model="panel" />
            break;

        case PaymentPanelState.NoAccounts:
            <div class="empty-state"><p>No finance account is linked to this customer.</p></div>
            break;

        case PaymentPanelState.Forbidden:
            <div class="error-state">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="@warnIcon" stroke="currentColor" stroke-width="1.6" /></svg>
                <p>You don't have permission to view this customer's payment information.</p>
            </div>
            break;

        case PaymentPanelState.Disabled:
            <div class="alert alert-info" role="status"><span>Collections is not enabled in this environment, so payment information is not shown.</span></div>
            break;

        case PaymentPanelState.Error:
            <div class="error-state">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="@warnIcon" stroke="currentColor" stroke-width="1.6" /></svg>
                <p>Payment information could not be loaded.</p>
                <a class="btn btn-sm" href="@baseHref#payment" data-payment-retry>Retry</a>
            </div>
            break;

        case PaymentPanelState.Unavailable:
            <div class="alert alert-error payment-alert-action" role="alert" data-balance-unavailable>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="@warnIcon" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                <span><strong>Balance unavailable.</strong> Payment information is temporarily unavailable, so no figures are shown. Do not quote a balance to the customer.</span>
                <a class="btn btn-sm" href="@baseHref#payment" data-payment-retry>Retry</a>
            </div>
            break;

        case PaymentPanelState.SelectAccount:
            <p class="panel-intro">This customer has @panel.Outstanding!.Accounts.Count finance accounts. Select one to see its balance, instalments and payments.</p>
            <ul class="payment-account-list">
                @foreach (var option in panel.Outstanding.Accounts)
                {
                    <li>
                        <a class="payment-account-card" href="@baseHref&account=@Uri.EscapeDataString(option.AccountId)#payment" data-payment-account-link="@option.AccountId">
                            <span class="payment-account-card__unit">@(option.TowerName ?? "—") · @(option.UnitNumber ?? "—")</span>
                            <span class="id-fallback">@option.AccountId</span>
                            <span class="payment-account-card__due">@CustomerPaymentPanel.Money(option.AmountDueNow, option.Currency) <small>due now</small></span>
                        </a>
                    </li>
                }
            </ul>
            break;

        case PaymentPanelState.Loaded:
            var outstanding = panel.Outstanding!;
            var acct = account!;

            <div class="payment-toolbar">
                @if (outstanding.Accounts.Count > 1)
                {
                    <form class="payment-toolbar__selector" method="get" action="/Customers/@Uri.EscapeDataString(panel.CustomerKey)" data-payment-selector>
                        <input type="hidden" name="tab" value="payment" />
                        <div class="field-group">
                            <label class="field-label" for="paymentAccount">Account / unit</label>
                            <select class="field-select" id="paymentAccount" name="account">
                                @foreach (var option in outstanding.Accounts)
                                {
                                    <option value="@option.AccountId" selected="@(option.AccountId == acct.AccountId)">@panel.AccountLabel(option)</option>
                                }
                            </select>
                        </div>
                        <noscript><button type="submit" class="btn btn-sm">Show</button></noscript>
                    </form>
                }
                else
                {
                    <div class="payment-toolbar__single">
                        <span class="field-label">Account / unit</span>
                        <strong>@panel.AccountLabel(acct)</strong>
                    </div>
                }
                <div class="payment-toolbar__meta">
                    <span>Currency <strong>@acct.Currency</strong></span>
                    <span>Source <strong>@outstanding.Source</strong></span>
                    <span title="@acct.AsOfUtc.ToString("O")">Last updated <strong>@acct.AsOfUtc.ToLocalTime().ToString("d MMM yyyy HH:mm")</strong></span>
                </div>
            </div>

            @if (panel.IsStale)
            {
                <div class="alert alert-warning payment-alert-action" role="status" data-balance-stale>
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="@warnIcon" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                    <span><strong>These figures may be out of date</strong> — last updated @acct.AsOfUtc.ToLocalTime().ToString("d MMM yyyy HH:mm"). Confirm before quoting. Reminders cannot be sent on stale figures.</span>
                    <a class="btn btn-sm" href="@baseHref&account=@Uri.EscapeDataString(acct.AccountId)#payment" data-payment-retry>Refresh</a>
                </div>
            }

            @if (acct.DataStatus is "Inconsistent" or "Invalid")
            {
                <div class="alert alert-error" role="alert">
                    <span><strong>@(acct.DataStatus == "Inconsistent" ? "The finance source's figures disagree." : "The finance source returned invalid figures.")</strong> @string.Join(" ", acct.Problems) Reminders are disabled for this account until the source is corrected.</span>
                </div>
            }

            @if (!panel.HasFigures)
            {
                <div class="alert alert-error" role="alert" data-balance-unavailable><span><strong>Balance unavailable</strong> for this account.</span></div>
            }
            else
            {
                @if (panel.IsSettled)
                {
                    <div class="alert alert-success" role="status" data-balance-settled><span><strong>Nothing is due.</strong> This account has no unpaid principal, penalties or fees.</span></div>
                }

                <section class="kpi-grid payment-kpis" aria-label="Balance summary">
                    <div class="kpi-card @(acct.AmountDueNow > 0 ? "kpi-card--attention" : "")">
                        <strong>@CustomerPaymentPanel.Reported(acct.AmountDueNow, currency)</strong>
                        <span>Amount due now</span>
                    </div>
                    <div class="kpi-card">
                        <strong>@CustomerPaymentPanel.Money(acct.OverduePrincipalAmount, currency)</strong>
                        <span>Overdue principal</span>
                    </div>
                    <div class="kpi-card">
                        <strong>@CustomerPaymentPanel.Reported(acct.PayablePenaltyAmount + acct.PayableFeeAmount, currency)</strong>
                        <span>Payable penalties and fees</span>
                    </div>
                    <div class="kpi-card">
                        <strong>@(acct.NextPayment is { } next ? CustomerPaymentPanel.Money(next.RemainingAmount, currency) : "—")</strong>
                        <span>Next payment@(acct.NextPayment is { } nextDue ? $" · {CustomerPaymentPanel.Date(nextDue.DueDate)}" : "")</span>
                    </div>
                </section>

                <div class="two-col">
                    <div class="facts-panel facts-panel--flat">
                        <div class="facts-section__title">Principal</div>
                        <dl>
                            <div class="facts-row"><dt>Remaining principal</dt><dd>@CustomerPaymentPanel.Money(acct.RemainingPrincipalAmount, currency)</dd></div>
                            <div class="facts-row"><dt>Overdue</dt><dd class="@(acct.OverduePrincipalAmount > 0 ? "is-critical" : "")">@CustomerPaymentPanel.Money(acct.OverduePrincipalAmount, currency)</dd></div>
                            <div class="facts-row"><dt>Due today</dt><dd>@CustomerPaymentPanel.Money(acct.DueTodayPrincipalAmount, currency)</dd></div>
                            <div class="facts-row"><dt>Future</dt><dd>@CustomerPaymentPanel.Money(acct.FuturePrincipalAmount, currency)</dd></div>
                            <div class="facts-row"><dt>Oldest unpaid due date</dt><dd>@(acct.OldestUnpaidDueDate is { } oldest ? CustomerPaymentPanel.Date(oldest) : "—")</dd></div>
                        </dl>
                    </div>
                    <div class="facts-panel facts-panel--flat">
                        <div class="facts-section__title">Due now</div>
                        <dl>
                            <div class="facts-row"><dt>Payable penalties</dt><dd>@CustomerPaymentPanel.Reported(acct.PayablePenaltyAmount, currency)</dd></div>
                            <div class="facts-row"><dt>Payable fees</dt><dd>@CustomerPaymentPanel.Reported(acct.PayableFeeAmount, currency)</dd></div>
                            <div class="facts-row"><dt>Applied credit</dt><dd>@CustomerPaymentPanel.Reported(acct.AppliedCreditAmount, currency)</dd></div>
                            <div class="facts-row"><dt>Amount due now</dt><dd>@CustomerPaymentPanel.Reported(acct.AmountDueNow, currency)</dd></div>
                            <div class="facts-row"><dt>This month's remaining payment</dt><dd>@CustomerPaymentPanel.Money(acct.CurrentMonthRemainingAmount, currency)</dd></div>
                        </dl>
                        <p class="field-hint">This month's remaining payment overlaps the overdue, due-today and future amounts; it is not added to them.</p>
                    </div>
                </div>

                @if (panel.CanSend)
                {
                    <h3 class="payment-section-title">Send reminder</h3>
                    @if (panel.SendableCandidates.Count == 0)
                    {
                        <p class="field-hint" data-no-candidate>@(panel.IsStale ? "Reminders cannot be sent on stale figures." : "No reminder is due for this account today, or it has already been sent this cycle.")</p>
                    }
                    @foreach (var candidate in panel.SendableCandidates)
                    {
                        <form class="payment-send" method="post" asp-page="/CustomerProfile" asp-page-handler="SendReminder" asp-route-customerKey="@panel.CustomerKey"
                              data-confirm="Queue a @CustomerPaymentPanel.Label(candidate.AmountBasis) reminder for @CustomerPaymentPanel.Money(candidate.ReminderAmount, candidate.Currency) on account @candidate.AccountId? The balance is checked again before it is sent.">
                            <input type="hidden" name="candidateId" value="@candidate.CandidateId" />
                            <input type="hidden" name="accountId" value="@candidate.AccountId" />
                            <input type="hidden" name="idempotencyKey" value="@panel.SendIdempotencyKey" />
                            <div class="payment-send__summary">
                                <strong>@CustomerPaymentPanel.Money(candidate.ReminderAmount, candidate.Currency)</strong>
                                <span>@CustomerPaymentPanel.Label(candidate.AmountBasis) · account @candidate.AccountId · instalments @string.Join(", ", candidate.InstalmentIds)</span>
                                <span class="text-secondary">Offer valid until @candidate.ExpiresAtUtc.ToLocalTime().ToString("HH:mm")</span>
                            </div>
                            <fieldset class="payment-send__channels">
                                <legend class="field-label">Channels</legend>
                                @foreach (var channel in CustomerPaymentPanel.WebChannels(candidate))
                                {
                                    <label class="field-check"><input type="checkbox" name="channels" value="@channel" checked /> @CustomerPaymentPanel.Label(channel)</label>
                                }
                            </fieldset>
                            <div class="field-group">
                                <label class="field-label" for="reminderLanguage-@candidate.AmountBasis">Language</label>
                                <select class="field-select" id="reminderLanguage-@candidate.AmountBasis" name="language">
                                    <option value="en">English</option>
                                    <option value="ar">Arabic</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-gold">Send Reminder</button>
                        </form>
                    }
                }

                <h3 class="payment-section-title">Instalments</h3>
                @if (panel.Instalments is null)
                {
                    <div class="alert alert-error" role="status"><span>The instalment schedule is unavailable right now.</span></div>
                }
                else if (panel.Instalments.Items.Count == 0)
                {
                    <div class="empty-state empty-state--compact"><p>No instalment schedule for this account.</p></div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr><th>Instalment</th><th>Due date</th><th class="col-num">Scheduled</th><th class="col-num">Paid</th><th class="col-num">Remaining</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var instalment in panel.Instalments.Items)
                                {
                                    <tr>
                                        <td class="text-mono">@instalment.InstalmentId</td>
                                        <td class="text-mono">@CustomerPaymentPanel.Date(instalment.DueDate)</td>
                                        <td class="col-num text-mono">@CustomerPaymentPanel.Money(instalment.ScheduledAmount, currency)</td>
                                        <td class="col-num text-mono">@CustomerPaymentPanel.Money(instalment.AllocatedPaidAmount, currency)</td>
                                        <td class="col-num text-mono cell-primary">@CustomerPaymentPanel.Money(instalment.RemainingAmount, currency)</td>
                                        <td>
                                            <span class="badge badge-pay-@CustomerPaymentPanel.StatusCss(instalment.Status)">@CustomerPaymentPanel.Label(instalment.Status)</span>
                                            @if (instalment.Status == "PartiallyPaid" && instalment.IsOverdue)
                                            {
                                                <span class="badge badge-pay-critical">Overdue</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <h3 class="payment-section-title">Payment history</h3>
                @if (panel.History is null)
                {
                    <div class="alert alert-error" role="status"><span>Payment history is unavailable right now.</span></div>
                }
                else if (panel.History.Items.Count == 0)
                {
                    <div class="empty-state empty-state--compact"><p>No posted payments for this account.</p></div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead><tr><th>Date</th><th class="col-num">Amount</th><th>Method</th><th>Status</th><th>Receipt</th><th>Allocated to</th></tr></thead>
                            <tbody>
                                @foreach (var payment in panel.History.Items)
                                {
                                    <tr>
                                        <td class="text-mono">@CustomerPaymentPanel.Date(payment.PaymentDate)</td>
                                        <td class="col-num text-mono">@CustomerPaymentPanel.Money(payment.Amount, currency)</td>
                                        <td>@(payment.Method ?? "—")</td>
                                        <td><span class="badge badge-pay-@CustomerPaymentPanel.StatusCss(payment.Status)">@payment.Status</span></td>
                                        <td class="text-mono">@(payment.ReceiptNumber ?? "—")</td>
                                        <td>
                                            @foreach (var allocation in payment.Allocations)
                                            {
                                                <div class="text-mono">@allocation.InstalmentId · @CustomerPaymentPanel.Money(allocation.Amount, currency)@(allocation.AccountId is { } other ? $" (account {other})" : "")</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <p class="field-hint" data-documents-unavailable>Receipt and statement-of-account downloads are not available: no verified document source is connected. Receipt references are shown for reference only.</p>
            }
            break;
    }

    @if (showReminders)
    {
        <h3 class="payment-section-title">Reminder history</h3>
        @if (panel.Reminders is null)
        {
            <div class="alert alert-error" role="status"><span>Reminder history is unavailable right now.</span></div>
        }
        else if (panel.Reminders.Items.Count == 0)
        {
            <div class="empty-state empty-state--compact"><p>No payment reminders have been sent@(account is null ? "" : " for this account").</p></div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead><tr><th>Queued</th><th>Reminder</th><th class="col-num">Quoted amount</th><th>Channels</th><th>Customer response</th><th>Ticket</th></tr></thead>
                    <tbody>
                        @foreach (var reminder in panel.Reminders.Items)
                        {
                            <tr>
                                <td class="text-mono">@reminder.QueuedAtUtc.ToLocalTime().ToString("d MMM yyyy HH:mm")</td>
                                <td>@CustomerPaymentPanel.Label(reminder.ReminderType)<div class="cell-sub">@reminder.ReminderId · @reminder.AccountId · @reminder.Trigger</div></td>
                                <td class="col-num text-mono">@CustomerPaymentPanel.Money(reminder.ReminderAmount, reminder.Currency)</td>
                                <td>
                                    @foreach (var channel in reminder.Channels)
                                    {
                                        <div>@CustomerPaymentPanel.Label(channel.Channel): <span class="badge badge-pay-@CustomerPaymentPanel.StatusCss(channel.Status)">@CustomerPaymentPanel.Label(channel.Status)</span></div>
                                    }
                                </td>
                                <td>
                                    @if (reminder.Responses.Count == 0)
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                    @foreach (var response in reminder.Responses)
                                    {
                                        <div>@CustomerPaymentPanel.Label(response.CustomerIntent)@(response.VerificationFollowUpRequired ? " · verification needed" : "")</div>
                                    }
                                </td>
                                <td>
                                    @foreach (var response in reminder.Responses)
                                    {
                                        @if (response.TicketId is { } ticketId)
                                        {
                                            <div><a class="ticket-id-link" href="/Tickets/@ticketId">@(response.TicketNumber ?? $"#{ticketId}")</a></div>
                                        }
                                        else if (response.TicketResult == "Pending")
                                        {
                                            <div><span class="badge badge-pay-pending">Ticket pending</span></div>
                                        }
                                    }
                                    @if (reminder.Responses.All(r => r.TicketId is null && r.TicketResult != "Pending"))
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
