@using TigerCS.Web.Pages.Collections
@using TigerCS.Web.Services.Api
@model ReceivablesModel
@* Results area of the Receivables page: returned as a fragment by ?handler=Results, or inline with ?render=full. *@
@if (Model.LoadNotice is { } notice) { <div class="receivables-notice" role="status" data-load-notice>@notice</div> }
@if (Model.NothingDueYet)
{
    <div class="panel"><div class="empty-state"><p class="empty-state__title">Nothing is due in this month yet.</p><a class="btn" href="/Collections/Receivables">Clear filters</a></div></div>
}
else if (Model.Report is { } report)
{
    var units = ReceivablesModel.Lines(report);
    <partial name="_LoadProblem" model="report.Snapshot" />
    <div class="panel">
        @if (units.Count == 0)
        {
            <div class="empty-state">
                <p class="empty-state__title">@(CollectionsDisplay.FailedCompanies(report.Snapshot) is null ? "No units match these filters." : "No units to show yet.")</p>
                <a class="btn" href="/Collections/Receivables">Clear filters</a>
            </div>
        }
        else
        {
            <div class="receivables-table-wrap">
                <table class="receivables-table receivables-table--units">
                    <thead><tr><th>Customer</th><th>Contact</th><th>Tower</th><th>Apartment</th><th class="num">Due</th><th class="num">Overdue</th><th class="num">Total</th><th><span class="visually-hidden">Details</span></th></tr></thead>
                    @foreach (var unit in units)
                    {
                        <tbody class="unit-group" data-unit>
                        <tr data-unit-row>
                            <td><strong>@unit.Customer</strong></td>
                            <td>@unit.Phone<span class="receivables-meta">@unit.Email</span></td>
                            <td>@unit.Tower</td>
                            <td>@unit.Apartment</td>
                            <td class="num"><span class="receivables-amount" data-unit-due>@ReceivablesModel.MoneyOrDash(unit.Due)</span></td>
                            <td class="num"><span class="receivables-amount@(unit.Overdue > 0 ? " receivables-amount--overdue" : "")" data-unit-overdue>@ReceivablesModel.MoneyOrDash(unit.Overdue)</span></td>
                            <td class="num"><span class="receivables-amount" data-unit-total>@ReceivablesModel.Money(unit.Total)</span></td>
                            <td><button type="button" class="btn btn-sm" data-unit-toggle aria-expanded="false" aria-controls="@unit.DetailsId" hidden>View Details</button></td>
                        </tr>
                        <tr class="unit-detail" id="@unit.DetailsId" data-unit-detail>
                            <td colspan="8">
                                <table class="receivables-table receivables-table--instalments receivables-table--nested">
                                    <thead><tr><th>Instalment</th><th>Due date</th><th class="num">Original amount</th><th class="num">Paid</th><th class="num">Remaining</th><th>Status</th><th class="num">Days late</th></tr></thead>
                                    <tbody>
                                    @foreach (var row in unit.Instalments)
                                    {
                                        <tr class="@(row.Status == ReceivablesModel.Overdue ? "instalment-row--overdue" : "")" data-instalment-status="@row.Status">
                                            <td>@row.Description</td>
                                            <td>@row.DueDate.ToString("dd MMM yyyy")</td>
                                            <td class="num">@ReceivablesModel.Money(row.Original)</td>
                                            <td class="num">@ReceivablesModel.Money(row.Paid)</td>
                                            <td class="num"><span class="receivables-amount">@ReceivablesModel.Money(row.Remaining)</span></td>
                                            <td><span class="receivables-tag @(row.Status == ReceivablesModel.Overdue ? "receivables-tag--overdue" : "")">@row.Status</span></td>
                                            <td class="num">@(row.DaysLate is { } days ? days.ToString("N0") : "—")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                        </tbody>
                    }
                </table>
            </div>
        }
        <div class="receivables-pagination">
            <span>Page @report.Page of @Model.TotalPages · @ReceivablesModel.Plural(Model.UnitCount, "unit", "units")</span>
            <div>
                @if (report.Page > 1) { <a class="btn btn-sm" data-results-link href="@Model.PageUrl(report.Page - 1)">Previous</a> }
                @if (report.Page < Model.TotalPages) { <a class="btn btn-sm" data-results-link href="@Model.PageUrl(report.Page + 1)">Next</a> }
            </div>
        </div>
    </div>
}
else
{
    <div class="panel"><div class="error-state" role="alert" data-campaign-error>
    @if (Model.Outcome == ApiOutcome.Forbidden) { <p>Your account does not have permission to view Collections financial data.</p> }
    else if (Model.Outcome == ApiOutcome.Unauthorized) { <p>Your session has expired. <a href="/Logout">Sign in again</a>.</p> }
    else if (Model.Outcome == ApiOutcome.ValidationError) { <p>@(Model.Error ?? "The selected filters are invalid. Check the tower and status and retry.")</p> }
    else { <p>@(Model.Error ?? "The receivables source is unavailable.") The list could not be loaded.</p><button class="btn" type="button" data-results-retry>Retry</button> }
    </div></div>
}
