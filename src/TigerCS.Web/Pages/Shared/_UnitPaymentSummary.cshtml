@using TigerCS.Web.Models
@using TigerCS.Application.Modules.Collections.Dto
@model CustomerPaymentPanel
@{
    var panel = Model;
    var link = panel.UnitLink!;
    var unit = panel.SelectedUnit;
    var links = panel.Links;
    var selectId = links.AccountParameter == "account" ? "paymentAccount" : $"paymentAccount-{links.AccountParameter}";
    var warnIcon = "M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z";
    // A figure the sources did not provide is "Unavailable" - never zero and never a dash.
    string Aed(decimal? amount) => CustomerPaymentPanel.Money(amount, "AED");
    string Source(string value) => value switch { "Crm" => "CRM", "Pact" => "PACT", _ => "" };
    string TowerOf(LinkedUnitCandidateDto c) => TigerCS.Domain.Modules.Collections.CollectionsTowerName.IsUsable(c.TowerName, c.TowerNumber) ? c.TowerName!.Trim() : c.ProjectName ?? (c.TowerNumber is null ? "—" : $"Tower {c.TowerNumber}");
}

<section class="unit-payment" data-unit-payment data-crm-status="@link.CrmStatus" data-pact-status="@link.PactStatus">
    @if (link.Candidates.Count > 1)
    {
        <form class="payment-toolbar__selector" method="get" action="@links.SelectorAction" data-payment-selector data-autosubmit="@(links.AutoSubmit ? "true" : null)">
            @foreach (var hidden in links.HiddenFields)
            {
                <input type="hidden" name="@hidden.Key" value="@hidden.Value" />
            }
            <div class="field-group">
                <label class="field-label" for="@selectId">Unit</label>
                <select class="field-select" id="@selectId" name="@links.AccountParameter">
                    @if (unit is null)
                    {
                        <option value="" selected>Select a unit…</option>
                    }
                    @foreach (var option in link.Candidates)
                    {
                        <option value="@option.SelectionId" selected="@(option.SelectionId == unit?.SelectionId)">@panel.UnitLabel(option)</option>
                    }
                </select>
            </div>
            <noscript><button type="submit" class="btn btn-sm">Show</button></noscript>
        </form>
    }

    @if (link.SelectionRequired)
    {
        <p class="panel-intro" data-unit-selection-required>This customer has @link.Candidates.Count units. Select one to see its balance and instalments; none is chosen automatically.</p>
        <ul class="payment-account-list">
            @foreach (var option in link.Candidates)
            {
                <li>
                    <a class="payment-account-card" href="@links.AccountHref(option.SelectionId)" data-unit-link="@option.SelectionId">
                        <span class="payment-account-card__unit">@panel.UnitLabel(option)</span>
                        <span class="badge badge-pay-@CustomerPaymentPanel.UnitStatusCss(option.FinancialStatus)">@CustomerPaymentPanel.UnitStatusText(option.FinancialStatus)</span>
                        <span class="payment-account-card__due">@Aed(option.Payments?.RemainingBalance) <small>remaining balance</small></span>
                    </a>
                </li>
            }
        </ul>
    }

    @foreach (var note in link.Notes)
    {
        <div class="alert alert-info" role="status"><span>@note</span></div>
    }

    @if (unit is not null)
    {
        var figures = unit.Payments;
        var contact = new List<(string Label, string Value, string Source)>();
        if (unit.Customer.Name.Length > 0) contact.Add(("Customer", unit.Customer.Name, Source(unit.Customer.NameSource)));
        if (unit.Customer.Mobile.Length > 0) contact.Add(("Mobile", unit.Customer.Mobile, Source(unit.Customer.MobileSource)));
        if (unit.Customer.Email.Length > 0) contact.Add(("Email", unit.Customer.Email, Source(unit.Customer.EmailSource)));
        // One source for every detail is said once; only a mixed contact (CRM first, PACT completing it) tags each detail.
        var contactSources = contact.Select(c => c.Source).Where(c => c.Length > 0).Distinct().ToList();
        var singleContactSource = contactSources.Count == 1 && contact.All(c => c.Source == contactSources[0]) ? contactSources[0] : null;

        <div class="unit-head" data-unit-header>
            <div class="unit-head__id">
                <span class="unit-head__tower" data-unit-tower>@TowerOf(unit)</span>
                <strong class="unit-head__unit" data-unit-label><span class="unit-head__unit-word">Unit</span> @(unit.UnitNumber ?? "—")</strong>
            </div>
            <dl class="unit-head__meta">
                @if (unit.UnitKey is not null) { <div><dt>Unit code</dt><dd>@unit.UnitKey</dd></div> }
                @if (unit.ContractNumber is { Length: > 0 } contractNumber) { <div><dt>Contract</dt><dd>@contractNumber</dd></div> }
                <div><dt>Source</dt><dd>@(unit.Source == "Crm" ? "CRM → PACT" : unit.Source == "Leasing" ? "PACT Leasing" : "PACT")</dd></div>
                @if (figures?.LastUpdatedUtc is { } updated)
                {
                    <div><dt>Last updated</dt><dd data-unit-updated title="@updated.ToString("O")">@CustomerPaymentPanel.DubaiTime(updated) <small>Dubai</small></dd></div>
                }
                else
                {
                    <div><dt>Last updated</dt><dd data-unit-updated>@CustomerPaymentPanel.Date(unit.AsOf)</dd></div>
                }
            </dl>
        </div>

        <p class="unit-contact" data-unit-customer>
            @if (contact.Count == 0)
            {
                <span class="text-secondary">No contact details are held for this unit.</span>
            }
            else
            {
                foreach (var item in contact)
                {
                    <span class="unit-contact__item" data-contact="@item.Label.ToLowerInvariant()">@item.Value@if (singleContactSource is null && item.Source.Length > 0) { <small> @item.Source</small> }</span>
                }
                if (singleContactSource is not null)
                {
                    <span class="badge badge-pay-neutral" data-contact-source>@singleContactSource</span>
                }
            }
        </p>

        @if (unit.ReviewReasons.Count > 0)
        {
            <div class="alert alert-warning" role="status" data-unit-review>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="@warnIcon" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                <span><strong>Needs review.</strong> @string.Join(" ", unit.ReviewReasons.Select(CustomerPaymentPanel.ReasonText))</span>
            </div>
        }

        @switch (unit.FinancialStatus)
        {
            case "NoDues" when figures is null:
                <div class="alert alert-success" role="status" data-unit-state="NoDues"><span><strong>Confirmed: nothing is due.</strong> PACT holds this unit and nothing is due on or before today.@(unit.FinancialDetail is { Length: > 0 } zeroDetail ? " " + zeroDetail : "")</span></div>
                break;
            case "NoDues":
                <span hidden data-unit-state="NoDues"></span>
                break;
            case "NoFinancialData":
                <div class="alert alert-info" role="status" data-unit-state="NoFinancialData">
                    <span><strong>No financial data available.</strong> @(unit.FinancialReason is { } noDataReason ? CustomerPaymentPanel.ReasonText(noDataReason) + " " : "")@unit.FinancialDetail This is not a zero balance.</span>
                </div>
                break;
            case "MatchFailed":
                <div class="alert alert-warning" role="status" data-unit-state="MatchFailed">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="@warnIcon" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                    <span><strong>The unit could not be matched to one PACT record.</strong> @(unit.FinancialReason is { } failReason ? CustomerPaymentPanel.ReasonText(failReason) + " " : "")@unit.FinancialDetail No amounts are shown. Do not quote a balance.</span>
                </div>
                break;
            case "SourceError":
                <div class="alert alert-error payment-alert-action" role="alert" data-unit-state="SourceError" data-balance-unavailable>
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="@warnIcon" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                    <span><strong>Balance unavailable.</strong> A source could not be read: @unit.FinancialDetail Do not quote a balance.</span>
                    <a class="btn btn-sm" href="@links.AccountHref(unit.SelectionId)" data-payment-retry>Retry</a>
                </div>
                break;
            default:
                <span hidden data-unit-state="Available"></span>
                break;
        }

        @* The payment STATEMENT (PACT EDSM account of this unit alone): Due | Outstanding | Paid | Fines | Total, then Payment Details. Never derived from the snapshot below. *@
        @if (link.Statement is { } statement)
        {
            string Fig(StatementAmountDto? a) => a?.Value is { } v ? CustomerPaymentPanel.Money(v, statement.Currency) : (a?.Status == "NotComputed" ? "Not computed" : "Unavailable");
            string Css(StatementAmountDto? a, string tone) => a?.Value is null ? "kpi-card--unavailable" : tone;
            if (statement.IsAvailable)
            {
                <section class="unit-statement" aria-label="Payment summary" data-unit-statement data-statement-status="Available" data-statement-company="@statement.CompanyId">
                    <h3 class="payment-section-title">Payment Summary</h3>
                    <p class="field-hint" data-statement-source>PACT account statement (company @statement.CompanyId@(statement.CompanyName is { Length: > 0 } cn ? " · " + cn : ""), tenant @statement.TenantId) for unit @statement.UnitKey. Read @(statement.RetrievedAtUtc is { } at ? CustomerPaymentPanel.DubaiTime(at) + " Dubai" : "just now"); figures and rows are shown exactly as the source states them.</p>
                    <div class="kpi-grid payment-kpis payment-kpis--five">
                        <div class="kpi-card @Css(statement.Due, "statement-red")" data-statement="due"><strong class="statement-red-text">@Fig(statement.Due)</strong><span>Due</span></div>
                        <div class="kpi-card @Css(statement.Outstanding, "statement-red")" data-statement="outstanding"><strong class="statement-red-text">@Fig(statement.Outstanding)</strong><span>@statement.OutstandingLabel</span></div>
                        <div class="kpi-card @Css(statement.Paid, "statement-green")" data-statement="paid"><strong class="statement-green-text">@Fig(statement.Paid)</strong><span>Paid</span></div>
                        <div class="kpi-card @Css(statement.Fines, "")" data-statement="fines"><strong>@Fig(statement.Fines)</strong><span>Fines</span></div>
                        <div class="kpi-card @Css(statement.Total, "")" data-statement="total"><strong>@Fig(statement.Total)</strong><span>Total</span></div>
                    </div>
                    @foreach (var n in statement.Notes) { <p class="field-hint" data-statement-note>@n</p> }
                    <h3 class="payment-section-title">Payment Details</h3>
                    @if (statement.Rows.Count == 0)
                    {
                        <div class="empty-state empty-state--compact"><p>@(statement.RowsComplete ? "PACT lists no payments for this account." : "Payment details are unavailable.")</p></div>
                    }
                    else
                    {
                        <div class="table-scroll">
                            <table class="data-table" data-statement-details>
                                <thead><tr><th>Date</th><th>Payment Status</th><th class="col-num">Amount</th><th>Cheque Number</th></tr></thead>
                                <tbody>
                                    @foreach (var row in statement.Rows)
                                    {
                                        <tr data-statement-row="@row.Status">
                                            <td class="text-mono">@(row.Date is { } d ? CustomerPaymentPanel.Date(d) : (row.DateRaw ?? "—"))</td>
                                            <td><span class="badge @(row.Status == "Paid" ? "badge-pay-ok" : "badge-pay-critical")">@row.Status</span></td>
                                            <td class="col-num text-mono @(row.Status == "Paid" ? "statement-green-text" : "statement-red-text")">@(row.Amount is { } amt ? CustomerPaymentPanel.Money(amt, statement.Currency) : "Unavailable")</td>
                                            <td class="text-mono">@(string.IsNullOrWhiteSpace(row.ChequeNumber) ? "—" : row.ChequeNumber)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (!statement.RowsComplete) { <p class="field-hint" data-statement-incomplete>Some payment rows could not be read from PACT; the list may be incomplete.</p> }
                </section>
            }
            else
            {
                <div class="alert alert-warning" role="status" data-unit-statement data-statement-status="@statement.Status">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="@warnIcon" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                    <span><strong>Payment summary not shown.</strong> @statement.Detail@if (statement.OtherUnits.Count > 0) { <text> Other units on the same PACT account: @string.Join(", ", statement.OtherUnits).</text> } Nothing is guessed or shown as zero.</span>
                </div>
            }
        }

        @* When the PACT payment statement is available it IS the Payment tab; the snapshot cards below (unpaid instalments only, Total / Paid unavailable) would only repeat it. They stay when the statement is withheld. *@
        @if (link.Statement?.IsAvailable != true)
        {
        @* The summary and the schedule are always shown for a unit: a value that is not available says "Unavailable", it never disappears or becomes zero. *@
        <section class="kpi-grid payment-kpis payment-kpis--five" aria-label="Payment summary" data-payment-summary>
            <div class="kpi-card @(figures?.TotalAmount is null ? "kpi-card--unavailable" : "")" data-kpi="total">
                <strong>@Aed(figures?.TotalAmount)</strong><span>Total Amount</span>
            </div>
            <div class="kpi-card @(figures?.PaidAmount is null ? "kpi-card--unavailable" : "")" data-kpi="paid">
                <strong>@Aed(figures?.PaidAmount)</strong><span>Paid Amount</span>
            </div>
            <div class="kpi-card @(figures is null ? "kpi-card--unavailable" : "")" data-kpi="remaining">
                <strong>@Aed(figures?.RemainingBalance)</strong><span>Remaining Balance</span>
                @if (figures is not null) { <small>All unpaid, incl. future payments</small> }
            </div>
            <div class="kpi-card @(figures is null ? "kpi-card--unavailable" : figures.DueThisMonth > 0 ? "kpi-card--attention" : "")" data-kpi="due">
                <strong>@Aed(figures?.DueThisMonth)</strong><span>Due This Month</span>
                @if (figures is not null) { <small>@figures.MonthStart.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</small> }
            </div>
            <div class="kpi-card @(figures is null ? "kpi-card--unavailable" : figures.Overdue > 0 ? "kpi-card--attention" : "")" data-kpi="overdue">
                <strong>@Aed(figures?.Overdue)</strong><span>Overdue</span>
                @if (figures is not null) { <small>Due before @CustomerPaymentPanel.Date(figures.MonthStart)</small> }
            </div>
        </section>

        @if (figures is { TotalAmount: null } or { PaidAmount: null })
        {
            <p class="field-hint" data-total-paid-unavailable>Total and paid amounts are currently unavailable@(link.Statement?.IsAvailable == true ? " in this snapshot view; the Payment Summary above is the statement" : "")</p>
        }

        @if (figures is { DueThisMonth: 0, Overdue: 0 })
        {
            <p class="payment-nodue" role="status" data-no-due-overdue>No due or overdue payments this month</p>
        }

        @if (!string.IsNullOrWhiteSpace(unit.FinancialDetail) && unit.FinancialStatus is "Available" or "NoDues")
        {
            <p class="field-hint">@unit.FinancialDetail</p>
        }

        @if (figures is not null)
        {
            <h3 class="payment-section-title">Payment schedule <small class="text-secondary">(unpaid instalments only)</small></h3>
            @if (figures.Schedule.Count == 0)
            {
                <div class="empty-state empty-state--compact"><p>No unpaid payments on this unit's schedule.</p></div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table" data-payment-schedule>
                        <thead><tr><th>Due date</th><th>Payment</th><th class="col-num">Amount</th><th class="col-num">Paid</th><th class="col-num">Remaining</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var line in figures.Schedule)
                            {
                                <tr data-schedule-status="@line.Status">
                                    <td class="text-mono">@CustomerPaymentPanel.Date(line.DueDate)</td>
                                    <td>@line.Description</td>
                                    <td class="col-num text-mono">@Aed(line.ScheduledAmount)</td>
                                    <td class="col-num text-mono">@Aed(line.PaidAmount)</td>
                                    <td class="col-num text-mono cell-primary">@Aed(line.RemainingAmount)</td>
                                    <td><span class="badge badge-pay-@CustomerPaymentPanel.ScheduleStatusCss(line.Status)">@CustomerPaymentPanel.ScheduleStatusText(line.Status)@(line.Status == "Overdue" && line.DaysLate is { } days ? $" · {days} d" : "")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        }
    }
</section>
