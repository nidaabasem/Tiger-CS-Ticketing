@using TigerCS.Web.Models
@model CustomerPaymentPanel
@{
    var panel = Model;
    var summary = panel.PaymentSummary;
    var company = panel.SelectedCompany;
    var currency = summary?.Currency ?? "AED";
    string Date(DateOnly? d) => d is { } v ? CustomerPaymentPanel.Date(v) : "—";
    string Amount(decimal? a) => a is { } v ? $"{currency} {v.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}" : "—";
    TigerCS.Application.Modules.Collections.Dto.CollectionsEdsmFieldDto? Field(string key) => company?.Fields.FirstOrDefault(f => f.Key == key);
    var rented = company?.BusinessModel == "Rented";
    var sourceLabel = summary?.Source == "Fixture" ? "Fixture (Development/Testing only — not real data)" : summary?.Source == "Pact" ? "EDSM" : summary?.Source;
}

@if (summary is null)
{
    <div class="empty-state"><p>Not available.</p></div>
    return;
}

<section class="edsm-summary" data-edsm-summary data-mapping-status="@summary.MappingStatus">
    @if (summary.MappingStatus != "Mapped" || company is null)
    {
        <div class="alert alert-info" role="status" data-edsm-not-mapped>
            <span><strong>No payment figures for this customer.</strong></span>
        </div>
    }
    else
    {
        <div class="payment-toolbar">
            @if (summary.Companies.Count > 1)
            {
                <form class="payment-toolbar__selector" method="get" action="/Customers/@Uri.EscapeDataString(panel.CustomerKey)" data-payment-selector>
                    <input type="hidden" name="tab" value="payment" />
                    <div class="field-group">
                        <label class="field-label" for="paymentAccount">Account / unit</label>
                        <select class="field-select" id="paymentAccount" name="account">
                            @foreach (var option in summary.Companies)
                            {
                                <option value="@option.CompanyId" selected="@(option.CompanyId == company.CompanyId)">@CustomerPaymentPanel.EdsmCompanyLabel(option, summary.PactTenantId)</option>
                            }
                        </select>
                    </div>
                    <noscript><button type="submit" class="btn btn-sm">Show</button></noscript>
                </form>
            }
            else
            {
                <div class="payment-toolbar__single">
                    <span class="field-label">Account / unit</span>
                    <strong>@CustomerPaymentPanel.EdsmCompanyLabel(company, summary.PactTenantId)</strong>
                </div>
            }
            <div class="payment-toolbar__meta">
                <span data-currency-configured>Currency <strong>@currency</strong></span>
                <span>Source <strong>@sourceLabel</strong></span>
                <span data-retrieved-at>Last updated <strong>@summary.RetrievedAtUtc.ToLocalTime().ToString("d MMM yyyy HH:mm")</strong></span>
            </div>
        </div>

        @if (summary.Completeness != "Complete")
        {
            <div class="alert alert-warning" role="alert" data-edsm-incomplete="@summary.Completeness">
                <span><strong>Incomplete balance.</strong></span>
            </div>
        }

        <div class="edsm-company" data-edsm-company="@company.CompanyId" data-edsm-model="@company.BusinessModel" data-edsm-status="@company.Status">
            @if (company.Status != "Available")
            {
                <div class="alert alert-error" role="alert" data-edsm-company-unavailable>
                    <span><strong>@CustomerPaymentPanel.EdsmStatusText(company.Status).</strong></span>
                </div>
            }
            else
            {
                var paid = Field("paidAmount");
                var due = Field("dueAmount");
                var outstanding = Field("outstandingAmount");
                var fines = Field("lateFines");
                var total = Field("totalAmount");
                var outstandingLabel = rented ? "Post-dated cheques" : "Not yet due";
                var dueAttention = due is { Status: "Provided", Value: > 0m };
                string Css(TigerCS.Application.Modules.Collections.Dto.CollectionsEdsmFieldDto? f) => f is { Status: "Provided" } ? "" : "kpi-card--unavailable";

                <section class="kpi-grid payment-kpis edsm-kpis" aria-label="Payment summary">
                    <div class="kpi-card @(dueAttention ? "kpi-card--attention" : "") @Css(due)" data-edsm-field="dueAmount" data-edsm-amount-status="@due?.Status">
                        <strong>@CustomerPaymentPanel.EdsmFieldAmount(due, currency)</strong>
                        <span>Due</span>
                    </div>
                    <div class="kpi-card @Css(paid)" data-edsm-field="paidAmount" data-edsm-amount-status="@paid?.Status">
                        <strong>@CustomerPaymentPanel.EdsmFieldAmount(paid, currency)</strong>
                        <span>Paid</span>
                    </div>
                    <div class="kpi-card @Css(outstanding)" data-edsm-field="outstandingAmount" data-edsm-amount-status="@outstanding?.Status">
                        <strong>@CustomerPaymentPanel.EdsmFieldAmount(outstanding, currency)</strong>
                        <span>@outstandingLabel</span>
                    </div>
                    <div class="kpi-card @Css(total)" data-edsm-field="totalAmount" data-edsm-amount-status="@total?.Status">
                        <strong>@CustomerPaymentPanel.EdsmFieldAmount(total, currency)</strong>
                        <span>Total</span>
                    </div>
                </section>

                <div class="two-col">
                    <div class="facts-panel facts-panel--flat">
                        <div class="facts-section__title">Balance</div>
                        <dl>
                            @if (company.Contracts.Count > 0)
                            {
                                <div class="facts-row" data-edsm-contracts><dt>@(company.Contracts.Count == 1 ? "Contract" : "Contracts")</dt><dd>@string.Join(", ", company.Contracts.Select(c => $"{c.UnitNumber ?? c.ExternalUnitId} · {c.ProjectName ?? "—"}" + (c.UnitType == "Parking" ? " (Parking)" : "") + (c.ContractNumber is null ? "" : $" ({c.ContractNumber})")))</dd></div>
                            }
                            <div class="facts-row"><dt>Paid</dt><dd>@CustomerPaymentPanel.EdsmFieldAmount(paid, currency)</dd></div>
                            <div class="facts-row"><dt>Due</dt><dd class="@(dueAttention ? "is-critical" : "")">@CustomerPaymentPanel.EdsmFieldAmount(due, currency)</dd></div>
                            <div class="facts-row"><dt>@outstandingLabel</dt><dd>@CustomerPaymentPanel.EdsmFieldAmount(outstanding, currency)</dd></div>
                            <div class="facts-row"><dt>Total</dt><dd>@CustomerPaymentPanel.EdsmFieldAmount(total, currency)</dd></div>
                        </dl>
                    </div>
                    <div class="facts-panel facts-panel--flat edsm-reminder">
                        <div class="facts-section__title">Late fines and reminders</div>
                        <dl>
                            <div class="facts-row" data-edsm-field="lateFines" data-edsm-amount-status="@fines?.Status"><dt>Late fines</dt><dd>@CustomerPaymentPanel.EdsmFieldAmount(fines, currency)</dd></div>
                            <div class="facts-row"><dt>Due</dt><dd>@CustomerPaymentPanel.EdsmFieldAmount(due, currency)</dd></div>
                            <div class="facts-row"><dt>Reminder</dt><dd data-reminder-unavailable>Not available</dd></div>
                        </dl>
                        <div class="edsm-reminder__actions">
                            <div class="field-group">
                                <label class="field-label" for="edsmReminderChannel">Channel</label>
                                <select class="field-select" id="edsmReminderChannel" disabled aria-disabled="true"><option>Email</option></select>
                            </div>
                            <button type="button" class="btn btn-gold" disabled aria-disabled="true">Send Reminder</button>
                        </div>
                    </div>
                </div>

                @if (company.Transactions.Count > 0)
                {
                    // One table across EDSM's read-only lists. Status = the list a row came from;
                    // Payment Type = EDSM's paymentTypeId, never inferred from the status or cheque.
                    var order = new[] { "Paid", "Due", "Outstanding" };
                    var rows = company.Transactions
                        .Where(l => l.Status == "Available")
                        .SelectMany(l => l.Items.Select(item => (Status: l.TransactionType, Item: item)))
                        .OrderBy(r => r.Item.Date is null)
                        .ThenBy(r => r.Item.Date)
                        .ThenBy(r => Array.IndexOf(order, r.Status))
                        .ToList();
                    var failed = company.Transactions.Where(l => l.Status != "Available").ToList();

                    <h3 class="payment-section-title" data-edsm-payment-details>Payment details</h3>
                    @foreach (var list in failed)
                    {
                        <p class="field-hint" data-edsm-list-unavailable="@list.TransactionType">@list.TransactionType: not available.</p>
                    }
                    @if (rows.Count == 0)
                    {
                        <div class="empty-state empty-state--compact"><p>@(failed.Count == company.Transactions.Count ? "Not available." : "No transactions.")</p></div>
                    }
                    else
                    {
                        <div class="table-scroll">
                            <table class="data-table edsm-payment-details">
                                <thead><tr><th class="col-num">#</th><th>Date</th><th>Status</th><th>Payment Type</th><th class="col-num">Amount</th><th>Cheque Number</th></tr></thead>
                                <tbody>
                                    @for (var n = 0; n < rows.Count; n++)
                                    {
                                        var (status, row) = rows[n];
                                        <tr data-edsm-row-status="@status" data-edsm-payment-type-id="@row.PaymentTypeId">
                                            <td class="col-num">@(n + 1)</td>
                                            <td>@(row.Date is { } d ? CustomerPaymentPanel.Date(d) : row.DateRaw ?? "—")</td>
                                            <td><span class="badge badge-pay-@(status switch { "Paid" => "ok", "Due" => "critical", _ => "pending" })">@status</span></td>
                                            <td>@(row.PaymentType ?? "Not provided")</td>
                                            <td class="col-num">@(row.FormattedStatus == "Provided" ? $"{currency} {row.FormattedRaw!.Replace(" AED", "", StringComparison.Ordinal)}" : Amount(row.Amount))</td>
                                            <td class="text-mono">@(row.ChequeNumber ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }

                @if (company.DueInstallments is { Status: "Available" } dueInstallments)
                {
                    <h3 class="payment-section-title" data-edsm-due-installments="Available">Cheques and instalments, @Date(dueInstallments.FromDate) – @Date(dueInstallments.ToDate)</h3>
                    @if (dueInstallments.Items.Count == 0)
                    {
                        <div class="empty-state empty-state--compact"><p>None in this period.</p></div>
                    }
                    else
                    {
                        <div class="table-scroll">
                            <table class="data-table">
                                <thead><tr><th>Due date</th><th class="col-num">Amount</th><th>Voucher</th><th>Cheque</th><th>EDSM status</th></tr></thead>
                                <tbody>
                                    @foreach (var row in dueInstallments.Items)
                                    {
                                        <tr><td>@Date(row.ChequeDueDate)</td><td class="col-num">@Amount(row.Amount)</td><td class="text-mono">@(row.VoucherNumber ?? "—")</td><td class="text-mono">@(row.ChequeNumber ?? "—")</td><td>@(row.SourceStatus ?? "—")</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            }
        </div>
    }
</section>
