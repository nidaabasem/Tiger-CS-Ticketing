<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Tiger Ticketing</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='5' fill='%231B2A3C'/%3E%3Cpath d='M6 18L10 6M11 18L15 6M16 18L20 6' stroke='%23B8922E' stroke-width='2.2' stroke-linecap='round'/%3E%3C/svg%3E" />
    @* asp-append-version: cache-busting fix for the Ticket Details blank-tab
       regression — the Details/Previous Tickets tab markup depends on CSS
       rules shipped in the same deploy, and without a versioned URL a browser
       can pair new HTML with a stale cached site.css whose generic
       `.tab-panel { display:none }` hides the page before the new reveal
       rules exist. The versioned query string changes whenever the file
       does, so HTML and CSS always deploy in lockstep. *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @await Html.PartialAsync("_Header")
    @await Html.PartialAsync("_Nav")

    <main>
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
