@using TigerCS.Application.Modules.Collections.Dto
@using TigerCS.Web.Pages.Collections
@model SnapshotStatusDto
@* What is wrong with a company's receivables data, in the company's own words and state (SnapshotCompanyStatusDto.State): Loading (a refresh really runs), Stuck (it outlived its
   expected duration), Failed (the newest refresh failed - the last valid data, if any, is still shown with its time), Stale (older than allowed), NeverLoaded. Each company is
   judged on its own: a healthy company shows nothing here, and every failed one gets its own Retry for that company only. Never shown for a complete, fresh load. *@
@if (CollectionsDisplay.FailedCompanies(Model) is { } failed)
{
    var gaps = Model.Gaps.Select(g => g.CompanyId).ToHashSet();
    var loading = failed.Where(c => c.State == SnapshotLoadStates.Loading).ToList();
    var stuck = failed.Where(c => c.State == SnapshotLoadStates.Stuck).ToList();
    var problem = failed.Where(c => c.State is not (SnapshotLoadStates.Loading or SnapshotLoadStates.Stuck)).ToList();
    var from = Model.RequestedFrom ?? CollectionsDisplay.DubaiToday();
    var through = Model.RequestedThrough ?? from;
    var returnUrl = ViewContext.HttpContext.Request.Path + ViewContext.HttpContext.Request.QueryString;
    if (loading.Count > 0)
    {
        <div class="receivables-notice" role="status" data-load-running data-poll-active>
            Loading data for @CollectionsDisplay.CompanyList(loading)…
            @foreach (var c in loading)
            {
                <span class="receivables-meta" data-company-state="@c.CompanyId" data-state="Loading">@c.CompanyName: refreshing since @CollectionsDisplay.DubaiTime(c.RefreshStartedUtc)@(c.HasData ? $"; showing data from {CollectionsDisplay.DubaiTime(c.LastSuccessUtc)} meanwhile" : "").</span>
            }
        </div>
    }
    if (stuck.Count > 0)
    {
        <div class="receivables-notice receivables-notice--warning" role="alert" data-load-stuck>
            <span>The refresh for <strong>@CollectionsDisplay.CompanyList(stuck)</strong> has been running longer than expected and is not being waited for any more.</span>
            @foreach (var c in stuck)
            {
                <span class="receivables-meta" data-company-state="@c.CompanyId" data-state="Stuck">@c.CompanyName: started @CollectionsDisplay.DubaiTime(c.RefreshStartedUtc)@(c.HasData ? $"; the last valid data is from {CollectionsDisplay.DubaiTime(c.LastSuccessUtc)} (stale)" : "; no data has been loaded yet"). An administrator should check the PACT connection.</span>
            }
        </div>
    }
    if (problem.Count > 0)
    {
        var failedOrMissing = problem.Where(c => c.State is SnapshotLoadStates.Failed or SnapshotLoadStates.NeverLoaded || gaps.Contains(c.CompanyId)).ToList();
        var staleOnly = problem.Where(c => c.State == SnapshotLoadStates.Stale && !gaps.Contains(c.CompanyId)).ToList();
        <div class="receivables-notice receivables-notice--warning load-problem" role="alert" data-load-problem>
            @if (failedOrMissing.Count > 0) { <span>Could not load data for <strong>@CollectionsDisplay.CompanyList(failedOrMissing)</strong>.</span> }
            @if (staleOnly.Count > 0) { <span>Data for <strong>@CollectionsDisplay.CompanyList(staleOnly)</strong> is out of date.</span> }
            @foreach (var c in problem)
            {
                <div class="load-problem__company" data-company-state="@c.CompanyId" data-state="@c.State">
                    <span class="receivables-meta">
                        @c.CompanyName:
                        @switch (c.State)
                        {
                            case SnapshotLoadStates.Failed:
                                @(c.FailureText ?? "The last refresh failed.")
                                @(c.HasData ? $" Showing the last valid data from {CollectionsDisplay.DubaiTime(c.LastSuccessUtc)} (stale, {c.AgeMinutes} min old)." : " No data has been loaded yet.")
                                break;
                            case SnapshotLoadStates.NeverLoaded:
                                <text>Not loaded yet. This is not an empty result.</text>
                                break;
                            default:
                                <text>Last refreshed @CollectionsDisplay.DubaiTime(c.LastSuccessUtc) (@c.AgeMinutes min old, limit @Model.MaxAgeMinutes). The list below is the last valid data; no refresh is running.</text>
                                break;
                        }
                        @if (gaps.Contains(c.CompanyId) && c.State is SnapshotLoadStates.Ready or SnapshotLoadStates.Stale) { <text> Part of the requested dates is not loaded.</text> }
                    </span>
                    <form method="post" asp-page-handler="LoadCoverage" class="snapshot-status__load" data-load-form>
                        <input type="hidden" name="dateFrom" value="@from.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="dateTo" value="@through.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <input type="hidden" name="companyId" value="@c.CompanyId" />
                        <button class="btn" type="submit" data-load-button aria-label="Retry loading @c.CompanyName">Retry</button>
                        <span class="receivables-loading" role="status" hidden>Retrying…</span>
                    </form>
                </div>
            }
        </div>
    }
}
