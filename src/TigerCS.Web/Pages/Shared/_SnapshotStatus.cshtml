@using TigerCS.Application.Modules.Collections.Dto
@using TigerCS.Web.Pages.Collections
@model SnapshotStatusDto
@* Last successful refresh, refresh failures and snapshot coverage. Stale or missing data is never shown as a fresh empty result. *@
<section class="snapshot-status" aria-label="Receivables data freshness" data-snapshot-status>
    <p>
        <strong>Receivables data:</strong>
        @if (Model.OldestSuccessUtc is { } oldest)
        {
            <span>last successful refresh @CollectionsDisplay.DubaiTime(oldest)</span>
        }
        else
        {
            <span>not fully loaded yet</span>
        }
        · the page reads a local copy of PACT that is refreshed in the background (data older than @Model.MaxAgeMinutes minutes is stale).
    </p>
    @if (!Model.IsFresh)
    {
        <div class="receivables-notice receivables-notice--warning" role="alert" data-snapshot-warning>
            @if (!Model.IsComplete)
            {
                <span>Some companies have never been loaded, so this list may be missing receivables. @Model.FreshnessProblem</span>
            }
            else
            {
                <span>This data is stale. @Model.FreshnessProblem Campaign export is disabled until a refresh succeeds.</span>
            }
        </div>
    }
    <table class="snapshot-status__table">
        <thead><tr><th>Company</th><th>Data</th><th>Last success</th><th>Last refresh attempt</th><th>Rows</th><th>Covers instalments due</th></tr></thead>
        <tbody>
        @foreach (var company in Model.Companies)
        {
            <tr>
                <td>@company.CompanyName</td>
                <td><span class="receivables-tag @(company.Freshness == "Fresh" ? "" : "receivables-tag--overdue")">@CollectionsDisplay.FreshnessLabel(company)</span></td>
                <td>@CollectionsDisplay.DubaiTime(company.LastSuccessUtc)</td>
                <td>
                    @if (company.LastRefreshFailed)
                    {
                        <span class="receivables-tag receivables-tag--overdue">Failed @company.ConsecutiveFailures time@(company.ConsecutiveFailures == 1 ? "" : "s")</span>
                        <span class="receivables-meta">@CollectionsDisplay.DubaiTime(company.LastAttemptUtc)@(company.LastErrorNumber is { } code ? $" · error {code}" : "") · @(company.HasSnapshot ? "showing the previous successful data" : "no data available")</span>
                    }
                    else { <span>@(company.LastAttemptStatus == "Never" ? "never run" : "succeeded")</span> }
                </td>
                <td>@(company.HasSnapshot ? company.SnapshotRowCount.ToString("N0") : "—")</td>
                <td>@(company.CoverageFrom is { } f && company.CoverageThrough is { } t ? $"{f:dd MMM yyyy} – {t:dd MMM yyyy}" : "—")</td>
            </tr>
        }
        </tbody>
    </table>
    @foreach (var company in Model.Companies.Where(c => c.ExcludedInvalidUnitRows > 0 || c.ExcludedInvalidIdentityRows > 0))
    {
        <p class="receivables-meta" role="status">
            @company.CompanyName: @(company.ExcludedInvalidUnitRows + company.ExcludedInvalidIdentityRows) unpaid instalment(s)
            (AED @CollectionsDisplay.Money(company.ExcludedInvalidUnitAmount + company.ExcludedInvalidIdentityAmount)) are not listed because PACT gives them no valid unit (UnitID 0) or customer. They need to be fixed in PACT.
        </p>
    }
    @if (Model.UnmatchedTowers.Count > 0)
    {
        <div class="receivables-notice" role="status" data-unmatched-towers>
            Receivables on towers that are not in the tower list stay in <strong>All towers</strong> but cannot be selected:
            <ul>
                @foreach (var tower in Model.UnmatchedTowers)
                {
                    <li>@(tower.TowerNumber is null ? "(no tower number)" : $"Tower {tower.TowerNumber}") · @(tower.CompanyId == 4 ? "Dubai" : "Sharjah") · @tower.RowCount instalment(s), AED @CollectionsDisplay.Money(tower.Amount) — @CollectionsDisplay.UnmatchedReason(tower.Reason)</li>
                }
            </ul>
            Add the tower to <code>dbo.CollectionsTowers</code> to make it selectable.
        </div>
    }
</section>
