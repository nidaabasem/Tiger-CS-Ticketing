@model TigerCS.Web.Pages.TicketsModel
@{
    // The Queue, My Tickets and Closed views: one filter bar, one table, one
    // pager over the same ticket-queue endpoint. My Tickets fixes the owner
    // to the viewer and Closed fixes the status, so those two controls are
    // not offered there.
    var viewKey = Model.View.Key();
    var isClosedView = Model.View == TicketsView.Closed;
    var isMyView = Model.View == TicketsView.My;
    var showAssigneeFilter = !isMyView && Model.AssigneeDepartmentId is not null;

    string PageUrl(int p) => Url.Page("/Tickets", new
    {
        view = viewKey,
        departmentId = Model.DepartmentId,
        priorityId = Model.PriorityId,
        ticketStatus = isClosedView ? null : Model.TicketStatus,
        verificationStatus = Model.VerificationStatus,
        ownerEmployeeId = isMyView ? null : Model.OwnerEmployeeId,
        search = Model.Search,
        sortBy = Model.SortBy,
        sortDir = Model.SortDir,
        page = p,
        pageSize = Model.PageSize,
        channelId = Model.ChannelId,
        requestTypeId = Model.RequestTypeId,
        activeOnly = Model.ActiveOnly ? "true" : null,
        inDepartmentQueue = Model.InDepartmentQueue ? "true" : null,
        slaBreached = Model.SlaBreached ? "true" : null,
        dueToday = Model.DueToday ? "true" : null,
        backlogAge = Model.BacklogAge,
        pendingApproval = Model.PendingApproval ? "true" : null,
        createdFrom = Model.CreatedFrom?.ToString("yyyy-MM-dd"),
        createdTo = Model.CreatedTo?.ToString("yyyy-MM-dd")
    }) ?? Model.View.Href();
}

<form class="filter-bar" id="ticketFilters" method="get">
    <input type="hidden" name="view" value="@viewKey" />
    <div class="search-field filter-bar__search">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <input type="search" name="search" value="@Model.Search" placeholder="Search ticket number, customer, phone, unit or summary…" aria-label="Search tickets" />
    </div>

    @if (Model.NameResolver.OwnDepartments.Count > 0)
    {
        <div class="field-group">
            <label class="field-label" for="departmentId">Department</label>
            <select class="field-select" id="departmentId" name="departmentId" data-autosubmit>
                <option value="">All my departments</option>
                @foreach (var d in Model.NameResolver.OwnDepartments)
                {
                    <option value="@d.DepartmentId" selected="@(Model.DepartmentId == d.DepartmentId)">@d.Name</option>
                }
            </select>
        </div>
    }

    @if (!isClosedView)
    {
        <div class="field-group">
            <label class="field-label" for="ticketStatus">Status</label>
            <select class="field-select" id="ticketStatus" name="ticketStatus" data-autosubmit>
                <option value="">All statuses</option>
                @foreach (var s in new[] { "Open", "InProgress", "PendingCustomer", "PendingThirdParty", "Resolved", "Closed" })
                {
                    <option value="@s" selected="@(Model.TicketStatus == s)">@TicketDisplay.TicketStatusLabel(s)</option>
                }
            </select>
        </div>
    }

    <div class="field-group">
        <label class="field-label" for="priorityId">Priority</label>
        <select class="field-select" id="priorityId" name="priorityId" data-autosubmit>
            <option value="">All priorities</option>
            @for (byte p = 1; p <= 4; p++)
            {
                <option value="@p" selected="@(Model.PriorityId == p)">@TicketDisplay.PriorityLabel(p)</option>
            }
        </select>
    </div>

    @if (!isClosedView)
    {
        @* SLA status rides the queue endpoint's own slaBreached/dueToday
           predicates (the ones the dashboard counts with); both apply to
           active tickets only, so the control is not offered on Closed. *@
        <div class="field-group">
            <label class="field-label" for="sla">SLA status</label>
            <select class="field-select" id="sla" name="sla" data-autosubmit>
                <option value="">Any SLA</option>
                <option value="breached" selected="@(Model.SlaFilterValue == "breached")">Breached</option>
                <option value="dueToday" selected="@(Model.SlaFilterValue == "dueToday")">Due today</option>
            </select>
        </div>
    }

    @if (showAssigneeFilter)
    {
        <div class="field-group">
            <label class="field-label" for="assignee">Assignee</label>
            <select class="field-select" id="assignee" name="assignee" data-autosubmit>
                <option value="">Anyone</option>
                @if (!isClosedView)
                {
                    <option value="queue" selected="@(Model.AssigneeFilterValue == "queue")">Department queue (unassigned)</option>
                }
                @foreach (var member in Model.AssigneeOptions)
                {
                    <option value="@member.EmployeeId" selected="@(Model.OwnerEmployeeId == member.EmployeeId)">@member.DisplayName</option>
                }
            </select>
        </div>
    }

    <div class="field-group">
        <label class="field-label" for="verificationStatus">Verification</label>
        <select class="field-select" id="verificationStatus" name="verificationStatus" data-autosubmit>
            <option value="">All</option>
            @foreach (var v in new[] { "Unverified", "PendingCrmVerification", "Verified" })
            {
                <option value="@v" selected="@(Model.VerificationStatus == v)">@TicketDisplay.VerificationStatusLabel(v)</option>
            }
        </select>
    </div>

    <div class="field-group">
        <label class="field-label" for="createdFrom">Created from</label>
        <input class="field-input" type="date" id="createdFrom" name="createdFrom" value="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="field-group">
        <label class="field-label" for="createdTo">Created to</label>
        <input class="field-input" type="date" id="createdTo" name="createdTo" value="@Model.CreatedTo?.ToString("yyyy-MM-dd")" />
    </div>

    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    @* Dashboard drill-down criteria survive a re-filter on this page; the
       "Clear" action drops everything, drill-down included. The SLA and
       Assignee controls above already carry slaBreached/dueToday and
       ownerEmployeeId/inDepartmentQueue whenever they are shown. *@
    @if (!isMyView && !showAssigneeFilter && Model.OwnerEmployeeId is { } ownerEmployeeId) { <input type="hidden" name="ownerEmployeeId" value="@ownerEmployeeId" /> }
    @if (!showAssigneeFilter && Model.InDepartmentQueue) { <input type="hidden" name="inDepartmentQueue" value="true" /> }
    @if (isClosedView && Model.SlaBreached) { <input type="hidden" name="slaBreached" value="true" /> }
    @if (isClosedView && Model.DueToday) { <input type="hidden" name="dueToday" value="true" /> }
    @if (Model.DepartmentId is { } drilldownDepartmentId && Model.NameResolver.OwnDepartments.Count == 0) { <input type="hidden" name="departmentId" value="@drilldownDepartmentId" /> }
    @if (Model.ChannelId is { } channelId) { <input type="hidden" name="channelId" value="@channelId" /> }
    @if (Model.RequestTypeId is { } requestTypeId) { <input type="hidden" name="requestTypeId" value="@requestTypeId" /> }
    @if (Model.ActiveOnly) { <input type="hidden" name="activeOnly" value="true" /> }
    @if (Model.BacklogAge is { } backlogAge) { <input type="hidden" name="backlogAge" value="@backlogAge" /> }
    @if (Model.PendingApproval) { <input type="hidden" name="pendingApproval" value="true" /> }
    <div class="filter-bar__submit">
        <button type="submit" class="btn btn-sm">Apply</button>
        <a class="btn btn-ghost btn-sm" href="@Model.View.Href()">Clear</a>
    </div>
</form>

@if (Model.HasDrilldown)
{
    <div class="drilldown-bar" role="status">
        <span class="drilldown-bar__label">Filtered from Dashboard:</span>
        @foreach (var label in Model.DrilldownLabels)
        {
            <span class="badge badge-drilldown">@label</span>
        }
        <a class="link-muted" href="/Dashboard">Back to Dashboard</a>
    </div>
}

<div class="panel">
    <div class="panel__header">
        <span class="panel__title">@Model.View.Label()</span>
        <span class="text-secondary">@Model.TotalCount total</span>
    </div>

    @if (Model.Outcome == ApiOutcome.Unauthorized)
    {
        <div class="error-state">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
            <p>Your session is no longer valid. <a class="link-muted" href="/Logout">Sign in again</a>.</p>
        </div>
    }
    else if (Model.Outcome == ApiOutcome.Forbidden)
    {
        <div class="error-state">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
            <p>You don't have permission to view these tickets.</p>
        </div>
    }
    else if (Model.Outcome == ApiOutcome.Unreachable || Model.Outcome == ApiOutcome.BadGateway)
    {
        <div class="error-state">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
            <p>Tiger Ticketing System could not reach the ticketing service. Try again in a moment.</p>
        </div>
    }
    else if (Model.Outcome != ApiOutcome.Success)
    {
        <div class="error-state">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
            <p>Something went wrong loading the tickets.</p>
        </div>
    }
    else if (Model.Rows.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none"><rect x="5" y="4" width="14" height="16" rx="1.5" stroke="currentColor" stroke-width="1.4" /><path d="M9 9h6M9 13h6M9 17h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
            <p>No tickets match the current filters.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Ticket</th>
                        <th class="col-subject">Summary</th>
                        <th>Priority</th>
                        <th>Assigned Department</th>
                        <th>Assigned To</th>
                        <th>Verification</th>
                        <th>SLA</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        @await Html.PartialAsync("_TicketRow", row)
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="panel__footer">
        <span>Page @Model.PageNumber of @Model.TotalPages</span>
        <nav class="pagination" aria-label="Pagination">
            @if (Model.PageNumber > 1)
            {
                <a href="@PageUrl(Model.PageNumber - 1)">Prev</a>
            }
            else
            {
                <span class="is-disabled">Prev</span>
            }
            @if (Model.PageNumber < Model.TotalPages)
            {
                <a href="@PageUrl(Model.PageNumber + 1)">Next</a>
            }
            else
            {
                <span class="is-disabled">Next</span>
            }
        </nav>
    </div>
</div>
