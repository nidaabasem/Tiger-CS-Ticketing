@model TigerCS.Web.Pages.TicketDetailsModel
@{
    // The Customer summary card on Ticket Details (Overview and Customer
    // tabs) — the customer is a linked record, never static text: the name
    // and the action both open the Customer Profile the Customers directory
    // keys this ticket's customer by.
    var t = Model.Ticket!;
    var hasCrmBuyer = t.CrmBuyerUnitId is not null;
    var hasExternalVerification = !hasCrmBuyer && !string.IsNullOrWhiteSpace(t.CustomerVerificationSource);
    var hasManualUnit = !hasCrmBuyer && !hasExternalVerification
        && (!string.IsNullOrWhiteSpace(t.ManualProjectName) || !string.IsNullOrWhiteSpace(t.ManualUnitNumber));
    var customerName = Model.CustomerNameLabel;
    var customerVerification = Model.CustomerVerificationLabel;
    var customerVerificationCss = hasCrmBuyer ? "verified" : hasExternalVerification ? "external" : "unverified";
    var customerUnit = t.CrmBuyerUnitNumber ?? t.ManualUnitNumber;
    var customerProject = t.CrmBuyerProjectName ?? t.ManualProjectName;
}
@if (ViewData["Compact"] is true)
{
    @* Overview: the header already names the customer, their phone and how they were verified, so this
       repeats none of it — only what the header lacks, and the way into the profile. *@
    <section class="customer-card customer-card--compact" aria-label="Customer">
        <div class="facts-section__title">Customer</div>
        <dl class="customer-card__facts">
            <div class="facts-row"><dt>Project / Unit</dt><dd>@(customerUnit is null && customerProject is null ? "Not yet provided" : $"{customerUnit ?? "Unit not provided"}{(customerProject is null ? "" : $" · {customerProject}")}")</dd></div>
            @if (Model.CustomerHistory is { } compactHistory)
            {
                <div class="facts-row"><dt>Tickets</dt><dd>@compactHistory.OpenTickets open · @compactHistory.TotalTickets total</dd></div>
            }
        </dl>
        <div class="customer-card__actions">
            @if (Model.CustomerProfileHref is { } compactProfile)
            {
                <a class="btn btn-sm" href="@compactProfile">View Customer Profile</a>
                <label class="btn btn-sm tab-jump" for="tab-customer">Previous Tickets@(Model.CustomerHistory is not null ? $" ({Model.CustomerHistory.TotalTickets})" : "")</label>
            }
            else
            {
                <span class="field-hint">No CRM, PACT/Tasleeh or phone identity is recorded on this ticket, so there is no customer profile to open.</span>
            }
        </div>
    </section>
}
else
{
<section class="customer-card" aria-label="Customer">
    <div class="customer-card__head">
        <span class="customer-card__avatar" aria-hidden="true">@TicketDisplay.Initials(Model.CustomerDisplayName ?? customerName)</span>
        <div class="customer-card__who">
            @if (Model.CustomerProfileHref is { } profileHref)
            {
                <a class="customer-card__name" href="@profileHref">@customerName</a>
            }
            else
            {
                <span class="customer-card__name">@customerName</span>
            }
            <span class="badge badge-source-@customerVerificationCss">@customerVerification</span>
        </div>
    </div>
    <dl class="customer-card__facts">
        <div class="facts-row"><dt>Customer Name</dt><dd>@(Model.CustomerDisplayName ?? "Not available")</dd></div>
        <div class="facts-row"><dt>Phone</dt><dd class="text-mono">@(Model.CustomerPhone ?? "Not available")</dd></div>
        <div class="facts-row"><dt>Verification Source</dt><dd>@customerVerification</dd></div>
        <div class="facts-row"><dt>Project / Unit</dt><dd>@(customerUnit is null && customerProject is null ? "Not yet provided" : $"{customerUnit ?? "Unit not provided"}{(customerProject is null ? "" : $" · {customerProject}")}")</dd></div>
        @if (Model.CustomerHistory is { } cardHistory)
        {
            <div class="facts-row"><dt>Tickets</dt><dd>@cardHistory.OpenTickets open · @cardHistory.TotalTickets total</dd></div>
        }
    </dl>
    <div class="customer-card__actions">
        @if (Model.CustomerProfileHref is { } profileAction)
        {
            <a class="btn btn-sm btn-gold" href="@profileAction">View Customer Profile</a>
            <label class="btn btn-sm tab-jump" for="tab-customer">Previous Tickets@(Model.CustomerHistory is not null ? $" ({Model.CustomerHistory.TotalTickets})" : "")</label>
        }
        else
        {
            <span class="field-hint">No CRM, PACT/Tasleeh or phone identity is recorded on this ticket, so there is no customer profile to open.</span>
        }
    </div>
</section>
}
