@using TigerCS.Web.Pages.Collections
@model CampaignsModel
@* Select Customers -> Approve & Send -> Genesys + Admin Email: the approval and send status of the Campaigns page. *@
@if (Model.ApprovalError is not null) { <div class="panel"><div class="error-state" role="alert" data-approval-error><p>@Model.ApprovalError</p></div></div> }
@if (Model.ApprovalNotice is not null) { <div class="panel"><p role="status" data-approval-notice>@Model.ApprovalNotice</p></div> }

@if (Model.Run is { } run && (Model.RunActive || run.Status == "Failed"))
{
    <div class="panel review-run" data-run-active="@(Model.RunActive ? "true" : "false")" data-run-status="@run.Status">
        <h2>Approved financial snapshot</h2>
        @if (Model.RunActive)
        {
            <p role="status" data-run-phase>@run.Phase…</p>
            <progress max="100" value="@run.ProgressPercent" data-run-progress></progress>
        }
        else
        {
            <p role="alert" data-run-error>The approval data could not be prepared: @run.Error</p>
            <form method="post" asp-page-handler="RefreshApproval">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl()" />
                <button class="btn btn-primary" type="submit" data-run-retry>Retry</button>
            </form>
        }
    </div>
}

@if (Model.DispatchResult is { } d)
{
    var verdict = CampaignsModel.Verdict(d);
    <div class="panel review-dispatch" data-dispatch-status="@d.Status" data-dispatch-active="@(verdict.Css == "running" ? "true" : "false")" data-dispatch-id="@d.DispatchId">
        <h2>Send: @CampaignsModel.Label(d.Status)</h2>
        <p class="send-verdict send-verdict--@verdict.Css" role="status" data-send-verdict>@verdict.Text</p>
        <p>@d.ApprovedCount approved ·
            @foreach (var total in d.ApprovedTotalsByCurrency) { <span>@total.Key @CampaignsModel.Money(total.Value) </span> }
            · approved by @(d.ApprovedByName ?? d.InitiatedByEmployeeId.ToString("D")) · @d.InitiatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</p>
        @if (!string.IsNullOrEmpty(d.StatusReason)) { <p role="status">@d.StatusReason</p> }
        <ul class="review-tally">
            <li><strong>@d.UploadedCount</strong> uploaded to Genesys<partial name="_InfoTip" model="@(new InfoTipModel("tip-tally-uploaded", "Uploaded to Genesys", "Accepted by Genesys."))" /></li>
            <li><strong>@d.ExcludedCount</strong> excluded at sending<partial name="_InfoTip" model="@(new InfoTipModel("tip-tally-excluded", "Excluded at sending", "Paid or settled."))" /></li>
            <li><strong>@d.FailedCount</strong> rejected by Genesys<partial name="_InfoTip" model="@(new InfoTipModel("tip-tally-rejected", "Rejected by Genesys", "Nothing created."))" /></li>
            <li><strong>@d.UnknownCount</strong> unconfirmed</li>
        </ul>
        @if (!string.IsNullOrEmpty(d.Phase) && verdict.Css == "running") { <p role="status">Progress: @d.Phase</p> }
        <p data-admin-email-status="@d.AdminEmailStatus"><strong>@CampaignsModel.EmailStatusText(d)</strong>@if (!string.IsNullOrEmpty(d.AdminEmailError)) { <text><br /><span class="review-note" data-admin-email-error>@d.AdminEmailError</span></text> }</p>
        @if (d.Status is "Completed" or "CompletedWithErrors" && d.AdminEmailStatus is "Failed" or "NotConfigured" or "None")
        {
            <form method="post" asp-page-handler="RetryEmail" asp-route-dispatch="@d.DispatchId">
                <span class="campaign-action">
                    <button class="btn" type="submit" aria-describedby="tip-retry-email" data-retry-email>Retry administrator email</button>
                    <partial name="_InfoTip" model="@(new InfoTipModel("tip-retry-email", "Retry administrator email", "Sends the report only. The Genesys upload is never repeated."))" />
                </span>
            </form>
        }
        <p>Paid-after-upload protection: <strong>@d.SuppressedCount</strong> contact(s) already made not callable@(d.SuppressionFailedCount > 0 ? $", {d.SuppressionFailedCount} could not be (needs attention)" : "").
           @if (d.UploadedWithoutContactId > 0) { <text><br /><strong>@d.UploadedWithoutContactId uploaded contact(s) have no Genesys contact id and cannot be suppressed automatically.</strong> Check them in Genesys by hand.<br /></text> }
           <a href="/Collections/Campaigns?handler=Contacts&amp;dispatch=@d.DispatchId">Download the contacts as uploaded (CSV)</a></p>
        <p class="review-note">@d.Disclaimer</p>
        <div class="table-scroll"><table class="table">
            <thead><tr><th>#</th><th>Stage</th><th>Genesys campaign</th><th>Contact list</th><th>Contacts</th><th>Status</th><th>Attempts</th><th>Detail</th><th></th></tr></thead>
            <tbody>
            @foreach (var b in d.Batches)
            {
                <tr>
                    <td>@b.Sequence</td><td>@CampaignsModel.Label(b.ReminderType)</td>
                    <td data-batch-campaign>@(b.GenesysCampaignName ?? b.StageName)@if (!string.IsNullOrEmpty(b.GenesysCampaignId)) { <text><br /><code data-campaign-id>@b.GenesysCampaignId</code> · <span data-campaign-action>@CampaignsModel.CampaignActionLabel(b.CampaignAction)</span></text> }</td>
                    <td><code>@b.ContactListId</code></td>
                    <td>@b.ContactCount@(b.ReturnedContactCount is { } r ? $" ({r} ids returned)" : "")</td>
                    <td><strong>@CampaignsModel.Label(b.Status)</strong></td><td>@b.AttemptCount</td>
                    <td>@b.Error @b.ReconciliationNote</td>
                    <td>
                        @if (b.Status == "UnknownOutcome")
                        {
                            <form method="post" asp-page-handler="Reconcile" class="review-reconcile">
                                <input type="hidden" name="dispatch" value="@d.DispatchId" /><input type="hidden" name="batchId" value="@b.BatchId" />
                                <p class="review-note">Genesys did not confirm this upload. Do not send it again. Check the contact list in Genesys, then record what you found.</p>
                                <select class="field-select" name="resolution" aria-label="Resolution">
                                    <option value="ConfirmedUploaded">The contacts are in the list</option>
                                    <option value="ConfirmedNotUploaded">No contacts were created</option>
                                </select>
                                <input class="field-input" name="note" maxlength="500" required placeholder="What you checked" aria-label="Reconciliation note" />
                                <button class="btn btn-sm" type="submit">Record</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (d.Batches.Count == 0) { <tr><td colspan="9">No batches yet. @(d.Status is "Queued" or "Revalidating" ? "Current balances are being checked before anything is uploaded." : "")</td></tr> }
            </tbody>
        </table></div>
        @if (d.Status is "CompletedWithErrors" or "Failed" or "ReviewRequired")
        {
            <p class="review-note" data-send-retry-help>To retry, preview the list again and press Approve &amp; Send. Customers Genesys already accepted show as already sent and are left out; rejected or released customers can be approved again. A batch marked "Unconfirmed" must be reconciled first and is never resent automatically.</p>
        }
        <p><a class="btn" href="/Collections/Campaigns">Back to Campaigns</a></p>
    </div>
}

@if (Model.Summary is { } s)
{
    <form method="post" class="panel review-confirm" data-confirm-form asp-page-handler="Confirm">
        <h2>Confirm Approve &amp; Send<partial name="_InfoTip" model="@(new InfoTipModel("tip-confirm-checks", "What is checked before uploading", "Before uploading, the current balance of every customer is checked again against the financial snapshot. Paid customers are dropped; any other change, or a duplicate of an earlier send, stops the send for review. A copy of the approved list and the Genesys result is emailed to the Collections administrator."))" /></h2>
        <dl class="review-snapshot" data-selection-snapshot>
            <dt>Customers</dt><dd data-snapshot-count>@s.Count</dd>
            <dt>Total amount</dt><dd data-snapshot-total>@string.Join(" · ", s.TotalsByCurrency.Select(t => $"{t.Key} {CampaignsModel.Money(t.Value)}"))</dd>
            <dt>Campaign stage</dt><dd data-snapshot-stage>@string.Join(", ", s.CountByReminderType.Keys.Select(CampaignsModel.StageName))</dd>
            <dt>Destination Genesys contact list</dt>
            <dd data-snapshot-list>@if (s.ContactListByReminderType is { Count: > 0 } lists) { @foreach (var l in lists) { <div>@CampaignsModel.StageName(l.Key): <code>@l.Value</code></div> } } else { <text>—</text> }</dd>
            <dt>Financial source</dt><dd>@(s.SourceReconciled ? "Reconciled" : "Not reconciled")</dd>
        </dl>
        @foreach (var n in s.Notices) { <p role="status">@n</p> }
        @if (Model.Overlaps is { TotalPhones: > 0 } overlaps) { <p role="status" data-overlap-note>@overlaps.TotalPhones phone number(s) are held back to avoid repeated calls (several units on one phone, or several reminder types for one unit). They are not in this list.</p> }
        <div class="table-scroll"><table class="table">
            <thead><tr><th>Customer</th><th>Phone</th><th>Email</th><th>Unit</th><th>Stage</th><th>Amount due</th><th>Due date</th></tr></thead>
            <tbody>
            @foreach (var c in s.Contacts)
            {
                <tr><td>@c.CustomerName</td><td>@c.Phone</td><td>@c.Email</td><td>@c.UnitCode</td><td>@CampaignsModel.StageName(c.ReminderType)</td><td>@c.Currency @CampaignsModel.Money(c.Amount)</td><td>@c.DueDate.ToString("dd MMM yyyy")</td></tr>
            }
            </tbody>
        </table></div>
        @if (s.Count > s.Contacts.Count + (s.Page - 1) * s.PageSize || s.Page > 1)
        {
            <p>Showing contacts @((s.Page - 1) * s.PageSize + 1)–@((s.Page - 1) * s.PageSize + s.Contacts.Count) of @s.Count.
                @if (s.Page > 1) { <button class="btn btn-sm" type="submit" asp-page-handler="Approve" name="contactPage" value="@(s.Page - 1)" formnovalidate>Previous contacts</button> }
                @if (s.Page * s.PageSize < s.Count) { <button class="btn btn-sm" type="submit" asp-page-handler="Approve" name="contactPage" value="@(s.Page + 1)" formnovalidate>More contacts</button> }
            </p>
        }
        @foreach (var name in CampaignsModel.FilterFieldNames)
        {
            <input type="hidden" name="@name" value="@(name switch {
                "stage" => Model.Stage, "businessDate" => Model.BusinessDate?.ToString("yyyy-MM-dd"), "dateFrom" => Model.DateFrom?.ToString("yyyy-MM-dd"), "dateTo" => Model.DateTo?.ToString("yyyy-MM-dd"),
                "towerId" => Model.TowerId?.ToString(), "minTotal" => Model.MinTotalText, "paymentStatus" => Model.PaymentStatus, _ => Model.Search })" />
        }
        <input type="hidden" name="selectionMode" value="@Model.SelectionMode" /><input type="hidden" name="unitKeys" value="@Model.UnitKeys" />
        <input type="hidden" name="expectedCount" value="@s.Count" /><input type="hidden" name="expectedFingerprint" value="@s.Fingerprint" />
        <input type="hidden" name="idempotencyKey" value="@Model.ConfirmKey" />
        <label><input type="checkbox" name="ackCampaign" value="true" required /> I understand that an active Genesys campaign using these lists may start calling the uploaded contacts immediately, and that "uploaded" does not mean "contacted".</label><br />
        <button class="btn btn-primary" type="submit" data-confirm-button>Confirm: send @s.Count customer(s) to Genesys</button>
        <a class="btn" href="@Model.ReturnUrl()">Cancel</a>
    </form>
}

@if (Model.History.Count > 0 && Model.DispatchResult is null)
{
    <div class="panel review-history" data-send-history>
        <h2>Recent sends</h2>
        <div class="table-scroll"><table class="table">
            <thead><tr><th>Approved</th><th>Approved by</th><th>Customers</th><th>Status</th><th>Admin email</th><th></th></tr></thead>
            <tbody>
            @foreach (var send in Model.History)
            {
                <tr data-history-row>
                    <td>@send.InitiatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td>@(send.ApprovedByName ?? send.InitiatedByEmployeeId.ToString("D"))</td>
                    <td>@send.ApprovedCount · @send.UploadedCount uploaded</td>
                    <td>@CampaignsModel.Label(send.Status)</td>
                    <td>@CampaignsModel.Label(send.AdminEmailStatus ?? "None")</td>
                    <td><a href="/Collections/Campaigns?dispatch=@send.DispatchId.ToString("D")">Open</a></td>
                </tr>
            }
            </tbody>
        </table></div>
    </div>
}
