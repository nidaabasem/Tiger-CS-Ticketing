@page "/Account/ChangePassword"
@model TigerCS.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change My Password";
    Layout = "_Layout";
}

<div class="page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/Dashboard">Dashboard</a>
        <span class="sep">/</span>
        <span class="current">Change my password</span>
    </nav>
    <div class="page-header">
        <div>
            <h1 class="page-title">Change my password</h1>
            <p class="page-subtitle">Choose a new password for your own account. Once it is changed you are signed out everywhere and asked to sign in again.</p>
        </div>
    </div>

    <section class="panel admin-form-panel" aria-labelledby="change-password-title">
        <div class="panel__header">
            <h2 class="panel__title" id="change-password-title">New password</h2>
            @if (Model.Viewer is { } viewer)
            {
                <span class="panel__hint">Signed in as @viewer.DisplayName</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="panel__note panel__note--top">
                <div class="alert alert-error" role="alert">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                    <span>@Model.ErrorMessage</span>
                </div>
            </div>
        }

        <form method="post" class="admin-form" novalidate autocomplete="off">
            <div class="form-group">
                <label class="form-label" asp-for="Input.CurrentPassword">Current password *</label>
                <input class="form-control" asp-for="Input.CurrentPassword" type="password" required aria-required="true" autocomplete="current-password" autofocus />
                <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" asp-for="Input.NewPassword">New password *</label>
                    <input class="form-control" asp-for="Input.NewPassword" type="password" required aria-required="true" autocomplete="new-password" minlength="8" />
                    <span class="field-hint">@ChangePasswordModel.PasswordPolicyText</span>
                    <span asp-validation-for="Input.NewPassword" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Input.ConfirmPassword">Confirm new password *</label>
                    <input class="form-control" asp-for="Input.ConfirmPassword" type="password" required aria-required="true" autocomplete="new-password" />
                    <span class="field-hint">Both entries must match.</span>
                    <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                </div>
            </div>
            <div class="form-actions">
                <a class="btn" href="/Dashboard">Cancel</a>
                <button type="submit" class="btn btn-gold">Change Password</button>
            </div>
        </form>
    </section>
</div>
