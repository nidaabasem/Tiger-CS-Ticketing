{
  "name": "TigerCS - Send Document Copy",
  "integrationType": "custom-rest-actions",
  "actionType": "custom",
  "category": "TigerCS",
  "config": {
    "request": {
      "requestUrlTemplate": "https://tigergroup.ae/api/genesys/documents/send-copy",
      "requestType": "POST",
      "headers": {
        "Authorization": "${authResponse.token_type} ${authResponse.access_token}",
        "Idempotency-Key": "${input.idempotencyKey}",
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "requestTemplate": "{\"verificationSessionId\": \"$esc.jsonString(${input.verificationSessionId})\", \"documentType\": \"$esc.jsonString(${input.documentType})\", \"crmUnitId\": \"$!esc.jsonString($input.crmUnitId)\", \"recordId\": \"$!esc.jsonString($input.recordId)\", \"crmLeadId\": \"$!esc.jsonString($input.crmLeadId)\", \"deliveryChannel\": \"$!esc.jsonString($input.deliveryChannel)\"}"
    },
    "response": {
      "translationMap": {
        "status": "$.status",
        "code": "$.code",
        "message": "$.message",
        "recordId": "$.recordId",
        "maskedDestination": "$.maskedDestination",
        "duplicate": "$.duplicate",
        "choices": "$.choices",
        "choiceKind": "$.choiceKind"
      },
      "translationMapDefaults": {
        "code": "\"\"",
        "message": "\"\"",
        "recordId": "\"\"",
        "maskedDestination": "\"\"",
        "duplicate": "false",
        "choices": "[]",
        "choiceKind": "\"\\\"\\\"\""
      },
      "successTemplate": "{\"status\": ${status}, \"code\": ${code}, \"message\": ${message}, \"recordId\": ${recordId}, \"maskedDestination\": ${maskedDestination}, \"duplicate\": ${duplicate}, \"choices\": ${choices}, \"choiceKind\": ${choiceKind}}"
    }
  },
  "contract": {
    "input": {
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "TigerCS - Send Document Copy",
        "type": "object",
        "required": [
          "verificationSessionId",
          "documentType",
          "idempotencyKey"
        ],
        "properties": {
          "verificationSessionId": {
            "type": "string",
            "description": "The verification session returned by POST /api/genesys/verification/otp/verify for this customer. Only sessions created from a verified OTP challenge are accepted."
          },
          "documentType": {
            "type": "string",
            "description": "Contract, ReservationForm, UnitLayout or RegistrationReceipt."
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Unique per request, REUSED on a retry of the same request (e.g. conversationId + documentType + attempt counter). Use a new key for the follow-up call that carries the customer's choice."
          },
          "crmUnitId": {
            "type": "string",
            "description": "Optional. Must be the verified unit."
          },
          "recordId": {
            "type": "string",
            "description": "Optional. The recordId (CRM attachmentId) the customer chose from a choiceKind=Document selection."
          },
          "deliveryChannel": {
            "type": "string",
            "description": "Optional. Email (default). WhatsApp and Sms have no integration yet."
          },
          "crmLeadId": {
            "type": "string",
            "description": "Optional. The CRM lead the customer chose from a choiceKind=Unit selection. Must be one of their own units."
          }
        }
      }
    },
    "output": {
      "successSchema": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "TigerCS - Send Document Copy result",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Sent, Queued or SelectionRequired. (Failures come back as error responses with a code.)"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recordId": {
            "type": "string"
          },
          "maskedDestination": {
            "type": "string",
            "description": "Masked email the document went to - safe to read back to the customer."
          },
          "duplicate": {
            "type": "boolean",
            "description": "true when this was a replay and nothing was sent again."
          },
          "choices": {
            "type": "array",
            "description": "On SelectionRequired: the records to offer the customer.",
            "items": {
              "type": "object",
              "properties": {
                "recordId": {
                  "type": "string",
                  "description": "Document: CRM attachmentId. Unit: the CRM lead id."
                },
                "label": {
                  "type": "string"
                },
                "unitNumber": {
                  "type": "string"
                },
                "issuedOn": {
                  "type": "string"
                }
              }
            }
          },
          "choiceKind": {
            "type": "string",
            "description": "On SelectionRequired: Document (pass recordId back) or Unit (pass crmLeadId back)."
          }
        }
      }
    }
  },
  "secure": false
}