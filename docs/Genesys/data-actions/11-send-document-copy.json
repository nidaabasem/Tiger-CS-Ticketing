{
  "name": "TigerCS - Send Document Copy",
  "integrationType": "custom-rest-actions",
  "actionType": "custom",
  "category": "TigerCS",
  "config": {
    "request": {
      "requestUrlTemplate": "https://tigergroup.ae/api/genesys/documents/send-copy",
      "requestType": "POST",
      "headers": {
        "Authorization": "${authResponse.token_type} ${authResponse.access_token}",
        "Idempotency-Key": "${input.idempotencyKey}",
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "requestTemplate": "{\"verificationSessionId\": \"$esc.jsonString(${input.verificationSessionId})\", \"documentType\": \"$esc.jsonString(${input.documentType})\", \"crmUnitId\": \"$!esc.jsonString($input.crmUnitId)\", \"recordId\": \"$!esc.jsonString($input.recordId)\", \"deliveryChannel\": \"$!esc.jsonString($input.deliveryChannel)\"}"
    },
    "response": {
      "translationMap": {
        "status": "$.status",
        "code": "$.code",
        "message": "$.message",
        "recordId": "$.recordId",
        "maskedDestination": "$.maskedDestination",
        "duplicate": "$.duplicate",
        "choices": "$.choices"
      },
      "translationMapDefaults": {
        "code": "\"\"",
        "message": "\"\"",
        "recordId": "\"\"",
        "maskedDestination": "\"\"",
        "duplicate": "false",
        "choices": "[]"
      },
      "successTemplate": "{\"status\": ${status}, \"code\": ${code}, \"message\": ${message}, \"recordId\": ${recordId}, \"maskedDestination\": ${maskedDestination}, \"duplicate\": ${duplicate}, \"choices\": ${choices}}"
    }
  },
  "contract": {
    "input": {
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "TigerCS - Send Document Copy",
        "type": "object",
        "required": ["verificationSessionId", "documentType", "idempotencyKey"],
        "properties": {
          "verificationSessionId": { "type": "string", "description": "The confirmed verification session (Otp or AuthenticatedDigitalUser) for this customer." },
          "documentType": { "type": "string", "description": "Contract, ReservationForm, UnitLayout or RegistrationReceipt." },
          "idempotencyKey": { "type": "string", "description": "Unique per request, REUSED on a retry of the same request (e.g. conversationId + documentType + attempt counter). Use a new key for the follow-up call that carries the customer's choice." },
          "crmUnitId": { "type": "string", "description": "Optional. Must be the verified unit." },
          "recordId": { "type": "string", "description": "Optional. The recordId the customer chose from a SelectionRequired answer." },
          "deliveryChannel": { "type": "string", "description": "Optional. Email (default). WhatsApp and Sms have no integration yet." }
        }
      }
    },
    "output": {
      "successSchema": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "TigerCS - Send Document Copy result",
        "type": "object",
        "properties": {
          "status": { "type": "string", "description": "Sent, Queued or SelectionRequired. (Failures come back as error responses with a code.)" },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "recordId": { "type": "string" },
          "maskedDestination": { "type": "string", "description": "Masked email the document went to - safe to read back to the customer." },
          "duplicate": { "type": "boolean", "description": "true when this was a replay and nothing was sent again." },
          "choices": {
            "type": "array",
            "description": "On SelectionRequired: the records to offer the customer.",
            "items": {
              "type": "object",
              "properties": {
                "recordId": { "type": "string" },
                "label": { "type": "string" },
                "unitNumber": { "type": "string" },
                "issuedOn": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "secure": false
}
