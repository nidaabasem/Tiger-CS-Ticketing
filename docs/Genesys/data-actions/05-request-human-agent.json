{
  "name": "TigerCS - Request Human Agent",
  "integrationType": "custom-rest-actions",
  "actionType": "custom",
  "category": "TigerCS",
  "config": {
    "request": {
      "requestUrlTemplate": "https://tigergroup.ae/api/genesys/tickets/${input.ticketId}",
      "requestType": "PATCH",
      "headers": {
        "Authorization": "${authResponse.token_type} ${authResponse.access_token}",
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "requestTemplate": "{\"conversationId\": \"$esc.jsonString(${input.conversationId})\", \"handoff\": {\"required\": true, \"agentAvailable\": false, \"trigger\": \"$!esc.jsonString($input.trigger)\", \"reason\": \"$!esc.jsonString($input.reason)\", \"mode\": \"$!esc.jsonString($input.mode)\"}}"
    },
    "response": {
      "translationMap": {
        "outcome": "$.outcome",
        "ticketId": "$.ticketId",
        "ticketNumber": "$.ticketNumber",
        "ticketStatus": "$.ticketStatus",
        "conversationEnded": "$.conversationEnded",
        "handoffStatus": "$.handoffStatus"
      },
      "translationMapDefaults": {
        "handoffStatus": "\"\""
      },
      "successTemplate": "{\"outcome\": ${outcome}, \"ticketId\": \"${ticketId}\", \"ticketNumber\": ${ticketNumber}, \"ticketStatus\": ${ticketStatus}, \"conversationEnded\": ${conversationEnded}, \"handoffStatus\": ${handoffStatus}}"
    }
  },
  "contract": {
    "input": {
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "TigerCS - Request Human Agent",
        "type": "object",
        "required": [
          "ticketId",
          "conversationId"
        ],
        "properties": {
          "ticketId": {
            "type": "string",
            "description": "Participant data TigerCsTicketId."
          },
          "conversationId": {
            "type": "string",
            "description": "The conversation id."
          },
          "trigger": {
            "type": "string",
            "description": "CustomerRequestedHuman, AiConnectionLost, AiEscalated, RoutingDecision or AgentTransfer."
          },
          "reason": {
            "type": "string",
            "description": "Free text, e.g. the bot escalation reason."
          },
          "mode": {
            "type": "string",
            "description": "Optional: Callback, ContinueChat, ReplyInChannel, HumanTakeover. Leave empty unless known."
          }
        }
      }
    },
    "output": {
      "successSchema": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "TigerCS - Request Human Agent result",
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "description": "\"Applied\"."
          },
          "ticketId": {
            "type": "string",
            "description": "The same TigerCS ticket id."
          },
          "ticketNumber": {
            "type": "string",
            "description": "Its ticket number."
          },
          "ticketStatus": {
            "type": "string",
            "description": "The ticket status - never changed by this call."
          },
          "conversationEnded": {
            "type": "boolean",
            "description": "Whether the interaction is recorded as ended."
          },
          "handoffStatus": {
            "type": "string",
            "description": "WaitingForAgent after this call."
          }
        }
      }
    }
  },
  "secure": false
}
