{
  "name": "TigerCS - Send Verification Code",
  "integrationType": "custom-rest-actions",
  "actionType": "custom",
  "category": "TigerCS",
  "config": {
    "request": {
      "requestUrlTemplate": "https://tigergroup.ae/api/genesys/verification/otp/send",
      "requestType": "POST",
      "headers": {
        "Authorization": "${authResponse.token_type} ${authResponse.access_token}",
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "requestTemplate": "{\"phoneNumber\": \"$esc.jsonString(${input.phoneNumber})\", \"crmUnitId\": \"$!esc.jsonString($input.crmUnitId)\"}"
    },
    "response": {
      "translationMap": {
        "status": "$.status",
        "code": "$.code",
        "message": "$.message",
        "challengeId": "$.challengeId",
        "maskedDestination": "$.maskedDestination",
        "units": "$.units"
      },
      "translationMapDefaults": {
        "code": "\"\"",
        "message": "\"\"",
        "challengeId": "\"\"",
        "maskedDestination": "\"\"",
        "units": "[]"
      },
      "successTemplate": "{\"status\": ${status}, \"code\": ${code}, \"message\": ${message}, \"challengeId\": ${challengeId}, \"maskedDestination\": ${maskedDestination}, \"units\": ${units}}"
    }
  },
  "contract": {
    "input": {
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "TigerCS - Send Verification Code",
        "type": "object",
        "required": [
          "phoneNumber"
        ],
        "properties": {
          "phoneNumber": {
            "type": "string"
          },
          "crmUnitId": {
            "type": "string",
            "description": "The unit the customer chose (crmUnitId from the lookup). Leave empty only when the customer has one unit."
          }
        }
      }
    },
    "output": {
      "successSchema": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "TigerCS - Send Verification Code result",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Found, CodeSent, AlreadySent, UnitSelectionRequired. Failures are error responses with a code."
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "challengeId": {
            "type": "string"
          },
          "maskedDestination": {
            "type": "string",
            "description": "Masked email the code went to - safe to read back."
          },
          "units": {
            "type": "array",
            "description": "Units the customer can verify for.",
            "items": {
              "type": "object",
              "properties": {
                "crmUnitId": {
                  "type": "string"
                },
                "leadId": {
                  "type": "integer"
                },
                "unitNumber": {
                  "type": "string"
                },
                "projectName": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "secure": false
}