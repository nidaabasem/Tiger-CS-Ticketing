{
  "name": "TigerCS - Send Verification Code",
  "integrationType": "custom-rest-actions",
  "actionType": "custom",
  "category": "TigerCS",
  "config": {
    "request": {
      "requestUrlTemplate": "https://tigergroup.ae/api/genesys/verification/otp/send",
      "requestType": "POST",
      "headers": {
        "Authorization": "${authResponse.token_type} ${authResponse.access_token}",
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "requestTemplate": "{\"phoneNumber\": \"$esc.jsonString(${input.phoneNumber})\", \"crmUnitId\": \"$!esc.jsonString($input.crmUnitId)\", \"channel\": \"$!esc.jsonString($input.channel)\", \"language\": \"$!esc.jsonString($input.language)\"}"
    },
    "response": {
      "translationMap": {
        "status": "$.status",
        "code": "$.code",
        "message": "$.message",
        "challengeId": "$.challengeId",
        "maskedDestination": "$.maskedDestination",
        "units": "$.units",
        "channel": "$.channel"
      },
      "translationMapDefaults": {
        "code": "\"\"",
        "message": "\"\"",
        "challengeId": "\"\"",
        "maskedDestination": "\"\"",
        "units": "[]",
        "channel": "\"\""
      },
      "successTemplate": "{\"status\": ${status}, \"code\": ${code}, \"message\": ${message}, \"challengeId\": ${challengeId}, \"maskedDestination\": ${maskedDestination}, \"units\": ${units}, \"channel\": ${channel}}"
    }
  },
  "contract": {
    "input": {
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "TigerCS - Send Verification Code",
        "type": "object",
        "required": [
          "phoneNumber"
        ],
        "properties": {
          "phoneNumber": {
            "type": "string"
          },
          "crmUnitId": {
            "type": "string",
            "description": "The unit the customer chose (crmUnitId from the lookup). Leave empty only when the customer has one unit."
          },
          "channel": {
            "type": "string",
            "enum": [
              "Email",
              "Sms"
            ],
            "description": "Optional. How the code is delivered: Email (default when empty) or Sms. The destination is never an input: the code goes to the email / mobile CRM holds for the customer. Only offer Sms when buyer-lookup returned it in availableChannels."
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "ar"
            ],
            "description": "Optional. Language of the SMS (en or ar). Ignored for Email."
          }
        }
      }
    },
    "output": {
      "successSchema": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "TigerCS - Send Verification Code result",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Found, CodeSent, AlreadySent, UnitSelectionRequired. Failures are error responses with a code. Added with SMS: DeliveryUnconfirmed (HTTP 504 - the provider gave no verifiable answer; the SMS may have arrived: ask the customer, keep the challengeId, do NOT call send again - use Resend only if nothing arrived), NoMobileOnRecord, SmsNotConfigured."
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "challengeId": {
            "type": "string"
          },
          "maskedDestination": {
            "type": "string",
            "description": "Masked email the code went to - safe to read back."
          },
          "units": {
            "type": "array",
            "description": "Units the customer can verify for.",
            "items": {
              "type": "object",
              "properties": {
                "crmUnitId": {
                  "type": "string"
                },
                "leadId": {
                  "type": "integer"
                },
                "unitNumber": {
                  "type": "string"
                },
                "projectName": {
                  "type": "string"
                }
              }
            }
          },
          "channel": {
            "type": "string",
            "description": "Email or Sms - the channel the code was sent on."
          }
        }
      }
    }
  },
  "secure": false
}
