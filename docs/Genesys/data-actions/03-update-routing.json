{
  "name": "TigerCS - Update Routing",
  "integrationType": "custom-rest-actions",
  "actionType": "custom",
  "category": "TigerCS",
  "config": {
    "request": {
      "requestUrlTemplate": "https://tigergroup.ae/api/genesys/tickets/$esc.url(${input.ticketId})",
      "requestType": "PATCH",
      "headers": {
        "Authorization": "${authResponse.token_type} ${authResponse.access_token}",
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "requestTemplate": "{\"conversationId\": \"$esc.jsonString(${input.conversationId})\", \"routing\": {\"queueId\": \"$!esc.jsonString($input.queueId)\", \"queueName\": \"$!esc.jsonString($input.queueName)\", \"agentId\": \"$!esc.jsonString($input.agentId)\", \"agentName\": \"$!esc.jsonString($input.agentName)\"}, \"requestType\": {\"requestTypeId\": \"$!esc.jsonString($input.requestTypeId)\", \"name\": \"$!esc.jsonString($input.requestTypeName)\"}}"
    },
    "response": {
      "translationMap": {
        "outcome": "$.outcome",
        "ticketId": "$.ticketId",
        "ticketNumber": "$.ticketNumber",
        "ticketStatus": "$.ticketStatus",
        "conversationEnded": "$.conversationEnded"
      },
      "translationMapDefaults": {},
      "successTemplate": "{\"outcome\": ${outcome}, \"ticketId\": \"${ticketId}\", \"ticketNumber\": ${ticketNumber}, \"ticketStatus\": ${ticketStatus}, \"conversationEnded\": ${conversationEnded}}"
    }
  },
  "contract": {
    "input": {
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "TigerCS - Update Routing",
        "type": "object",
        "required": [
          "ticketId",
          "conversationId"
        ],
        "properties": {
          "ticketId": {
            "type": "string",
            "description": "Participant data TigerCsTicketId."
          },
          "conversationId": {
            "type": "string",
            "description": "The conversation id."
          },
          "queueId": {
            "type": "string",
            "description": "Current queue id (empty = unchanged)."
          },
          "queueName": {
            "type": "string",
            "description": "Optional."
          },
          "agentId": {
            "type": "string",
            "description": "Connected agent Genesys User ID (empty = unchanged)."
          },
          "agentName": {
            "type": "string",
            "description": "Optional."
          },
          "requestTypeId": {
            "type": "string",
            "description": "Optional. The id of the configured request type the customer selected, from this environment's Request Type export (a data-table lookup in the flow; ids differ per environment). Preferred over requestTypeName. Blank = not supplied. If requestTypeName is also sent it must be the same request type or the call is refused (422)."
          },
          "requestTypeName": {
            "type": "string",
            "description": "Optional. Fallback only when no id is available: the exact name of one active request type (refused if the name exists in more than one department). Blank = not supplied. Applies the request type's department routing, Category, auto-assignment and SLA policy once; repeating the same one changes nothing, a different one than the ticket already has is refused (409) once a person has worked the ticket."
          }
        }
      }
    },
    "output": {
      "successSchema": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "TigerCS - Update Routing result",
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "description": "\"Applied\"."
          },
          "ticketId": {
            "type": "string",
            "description": "The same TigerCS ticket id."
          },
          "ticketNumber": {
            "type": "string",
            "description": "Its ticket number."
          },
          "ticketStatus": {
            "type": "string",
            "description": "The ticket status - never changed by this call."
          },
          "conversationEnded": {
            "type": "boolean",
            "description": "Whether the interaction is recorded as ended."
          }
        }
      }
    }
  },
  "secure": false
}
