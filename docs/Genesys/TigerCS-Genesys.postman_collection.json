        {
          "name": "4.3 AI - customer asks for a human",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"WaitingForAgent\", () => pm.expect(pm.response.json().handoffStatus).to.eql(\"WaitingForAgent\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
