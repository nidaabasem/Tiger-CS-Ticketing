                  "const r = pm.response.json();",
                  "pm.test(\"Searched as +971...\", () => pm.expect(r.phoneNumber).to.eql(pm.collectionVariables.get(\"knownPhone\")));",
                  "pm.test(\"Screen pop present\", () => pm.expect(r.screenPop).to.be.an(\"object\"));"
                ]
