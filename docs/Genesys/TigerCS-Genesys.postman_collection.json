{
  "info": {
    "name": "TigerCS <-> Genesys Cloud - End to End",
    "description": "Exactly the calls the Genesys Cloud data actions make, through TigerGroupWeb (OAuth 2.0 client credentials) to TigerCS. Set clientId / clientSecret in the environment (never commit them). Run top to bottom: the collection stores the token, ticket ids and conversation ids as it goes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://tigergroup.ae"
    },
    {
      "key": "clientId",
      "value": "genesys-uat"
    },
    {
      "key": "clientSecret",
      "value": ""
    },
    {
      "key": "legacyApiKey",
      "value": ""
    },
    {
      "key": "knownPhone",
      "value": "+971500000002"
    },
    {
      "key": "unknownPhone",
      "value": "+971509999999"
    },
    {
      "key": "queueId",
      "value": "REPLACE-with-a-mapped-Genesys-queue-id"
    },
    {
      "key": "genesysAgentId",
      "value": "REPLACE-with-a-mapped-Genesys-User-ID"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('voiceConversationId')) pm.collectionVariables.set('voiceConversationId', pm.variables.replaceIn('{{$guid}}'));",
          "if (!pm.collectionVariables.get('chatConversationId')) pm.collectionVariables.set('chatConversationId', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "0.1 Get access token (client_credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test(\"Bearer token with ticketing.genesys scope\", () => { pm.expect(t.token_type).to.eql(\"Bearer\"); pm.expect(t.scope).to.include(\"ticketing.genesys\"); });",
                  "pm.collectionVariables.set(\"accessToken\", t.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/genesys/oauth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "genesys",
                "oauth",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "scope",
                  "value": "ticketing.genesys"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}"
                }
              ]
            }
          }
        },
        {
          "name": "0.2 Legacy X-API-Key alone is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{legacyApiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/genesys/customers/lookup?phoneNumber=%2B971500000002",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "genesys",
                "customers",
                "lookup"
              ],
              "query": [
                {
                  "key": "phoneNumber",
                  "value": "%2B971500000002"
                }
              ]
            }
          }
        },
        {
          "name": "0.3 No token is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/genesys/customers/lookup?phoneNumber=%2B971500000002",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "genesys",
                "customers",
                "lookup"
              ],
              "query": [
                {
                  "key": "phoneNumber",
                  "value": "%2B971500000002"
                }
              ]
            }
          }
        }
      ]
    },
