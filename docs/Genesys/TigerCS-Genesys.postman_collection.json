    {
      "name": "2. Voice - create / reuse ticket",
      "item": [
        {
          "name": "2.1 Create ticket (Call.ConversationId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"TicketCreated\", () => pm.expect(r.outcome).to.eql(\"TicketCreated\"));",
                  "pm.collectionVariables.set(\"voiceTicketId\", r.ticketId);",
                  "pm.collectionVariables.set(\"voiceTicketNumber\", r.ticketNumber);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/genesys/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "genesys",
                "tickets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{voiceConversationId}}\",\n  \"channel\": \"Phone\",\n  \"customerPhone\": \"tel:{{unknownPhone}}\",\n  \"queueId\": \"{{queueId}}\",\n  \"queueName\": \"Customer Service\",\n  \"calledNumber\": \"tel:+97180084437\",\n  \"direction\": \"Inbound\",\n  \"startedAtUtc\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2.2 Retry same conversation - same TicketId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"AlreadyIngested, same ticket\", () => { pm.expect(r.outcome).to.eql(\"AlreadyIngested\"); pm.expect(String(r.ticketId)).to.eql(String(pm.collectionVariables.get(\"voiceTicketId\"))); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/genesys/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "genesys",
                "tickets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{voiceConversationId}}\",\n  \"channel\": \"Phone\",\n  \"customerPhone\": \"tel:{{unknownPhone}}\",\n  \"queueId\": \"{{queueId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. During the call - routing",
      "item": [
        {
          "name": "3.1 Agent connected (agent script on load)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"same ticket\", () => pm.expect(String(pm.response.json().ticketId)).to.eql(String(pm.collectionVariables.get(\"voiceTicketId\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/genesys/tickets/{{voiceTicketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "genesys",
                "tickets",
                "{{voiceTicketId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{voiceConversationId}}\",\n  \"routing\": {\n    \"queueId\": \"{{queueId}}\",\n    \"queueName\": \"Customer Service\",\n    \"agentId\": \"{{genesysAgentId}}\",\n    \"agentName\": \"Agent\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "3.2 Transferred to another queue",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/genesys/tickets/{{voiceTicketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "genesys",
                "tickets",
                "{{voiceTicketId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{voiceConversationId}}\",\n  \"routing\": {\n    \"queueId\": \"transfer-queue-id\",\n    \"queueName\": \"Leasing\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "3.3 Conversation ended",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"ended, ticket still open\", () => { pm.expect(r.conversationEnded).to.eql(true); pm.expect(r.ticketStatus).to.not.eql(\"Closed\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/genesys/tickets/{{voiceTicketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "genesys",
                "tickets",
                "{{voiceTicketId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{voiceConversationId}}\",\n  \"ended\": {\n    \"endedAtUtc\": \"{{$isoTimestamp}}\",\n    \"endReason\": \"client\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
